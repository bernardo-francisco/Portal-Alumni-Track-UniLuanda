/* ================================================================
   APP.CSS â€” UniLuanda Alumni
   Ficheiro Ãºnico de estilos (admin, egresso, empresa, site pÃºblico,
   autenticaÃ§Ã£o, chat, chamadas, inquÃ©ritos, mapas, etc.)

   PALETA OFICIAL (extraÃ­da de uniluanda.ao)
     Preto ........ #0A0A0A   (cabeÃ§alhos, rodapÃ©s, texto forte)
     Dourado ...... #C9A227   (destaques, botÃµes, links activos)
     Dourado esc .. #A67C00   (hover / texto dourado sobre claro)
     Branco ....... #FFFFFF   (superfÃ­cies e conteÃºdo)

   COMO USAR NO LAYOUT BLADE:
     <link rel="stylesheet" href="{{ asset('css/app.css') }}">
     <script src="{{ asset('js/app.js') }}" defer></script>

   CLASSES DE PÃGINA NO <body> (substituem os overflow conflituosos):
     body.layout-app     â†’ painÃ©is (admin / egresso / empresa) com scroll interno
     body.layout-public  â†’ site pÃºblico (scroll normal da pÃ¡gina)
     body.layout-auth    â†’ login / registo / reset (centrado, scroll normal)

   NOTA â€” RELATÃ“RIOS PDF / CERTIFICADOS (DomPDF):
     O DomPDF nÃ£o suporta variÃ¡veis CSS, flex nem grid. Os <style> dos
     PDFs (@page, .doc-header, .certificado, etc.) devem continuar
     dentro dos prÃ³prios templates de PDF. Se quiser a nova paleta
     neles, troque #0d6efd / #1a56db por #C9A227 e #A67C00.
   ================================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=DM+Sans:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap');


/* ================================================================
   1. DESIGN TOKENS
   ================================================================ */
:root {
    /* --- Marca --- */
    --black: #0a0a0a;
    --ink-900: #111111;
    --ink-800: #1a1a1a;
    --ink-700: #262626;
    --ink-600: #404040;
    --ink-500: #525252;
    --ink-400: #737373;
    --ink-300: #a3a3a3;
    --ink-200: #d4d4d4;
    --ink-100: #e8e6df;
    --ink-50:  #f5f4ef;

    --primary: #c9a227;
    --primary-dark: #a67c00;
    --primary-light: #e0b93d;
    --primary-soft: rgba(201, 162, 39, .12);
    --primary-softer: rgba(201, 162, 39, .06);
    --gold-50:  #fbf6e3;
    --gold-100: #f5e9bd;
    --gold-200: #ead58a;
    --on-primary: #0a0a0a;          /* texto sobre fundo dourado */

    --secondary: #262626;
    --secondary-dark: #0a0a0a;
    --navy: #0a0a0a;                /* tÃ­tulos / logÃ³tipo (antes azul-marinho) */

    --gradient-gold: linear-gradient(135deg, #a67c00 0%, #c9a227 55%, #e0b93d 100%);
    --gradient-dark: linear-gradient(135deg, #0a0a0a 0%, #262626 100%);

    /* --- Fundos e superfÃ­cies --- */
    --bg: #f6f4ee;
    --surface: #ffffff;
    --surface-alt: #faf9f5;
    --border-color: #e6e2d3;

    /* --- Texto --- */
    --text: #1a1a1a;
    --text-muted: #525252;
    --text-soft: #8a8a8a;

    /* --- Estados semÃ¢nticos (apenas badges/alertas) --- */
    --success: #22c55e;
    --success-dark: #16a34a;
    --danger: #ef4444;
    --danger-dark: #dc2626;
    --warning: #d97706;
    --info: #57534e;

    /* --- Sombras / raios --- */
    --shadow-sm: 0 4px 12px rgba(10, 10, 10, .05);
    --shadow-md: 0 12px 28px rgba(10, 10, 10, .08);
    --shadow-lg: 0 20px 40px rgba(10, 10, 10, .12);
    --radius: 12px;
    --radius-sm: 8px;
    --radius-lg: 20px;

    /* --- Layout --- */
    --topbar-h: 72px;
    --sidebar-w: 270px;
    --sidebar-w-mobile: 280px;
    --admin-topbar-height: 72px;
    --admin-sidebar-width: 270px;
    --admin-sidebar-mobile-width: 280px;
    --sidebar-width: 270px;

    /* --- Aliases da Ã¡rea empresa --- */
    --emp-primary: var(--primary);
    --emp-primary-dark: var(--primary-dark);
    --emp-primary-light: var(--gold-100);
    --emp-secondary: var(--ink-500);
    --emp-success: #16a34a;
    --emp-warning: #d97706;
    --emp-danger: #dc2626;
    --emp-info: var(--info);
    --emp-purple: var(--ink-700);
    --emp-dark: var(--black);
    --emp-light: var(--surface-alt);
    --emp-border: var(--border-color);
    --emp-text: var(--text);
    --emp-muted: var(--text-muted);
    --emp-radius-sm: 10px;
    --emp-radius-md: 14px;
    --emp-radius-lg: 18px;
    --emp-shadow-sm: 0 2px 12px rgba(10, 10, 10, .05);
    --emp-shadow-md: 0 8px 24px rgba(10, 10, 10, .08);
    --emp-shadow-lg: 0 16px 40px rgba(10, 10, 10, .12);

    /* --- Aliases das pÃ¡ginas de autenticaÃ§Ã£o --- */
    --blue: var(--primary);
    --blue-dark: var(--primary-dark);
    --blue-light: var(--gold-50);
    --muted: var(--text-muted);
    --border: var(--border-color);
}


/* ================================================================
   2. RESET & BASE
   ================================================================ */
*, *::before, *::after { box-sizing: border-box; }
* { margin: 0; padding: 0; }

html { height: 100%; scroll-behavior: smooth; scroll-padding-top: 100px; }

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.6;
}

a { text-decoration: none; }
hr { border: 0; border-top: 1px solid var(--border-color); }

body.layout-app { height: 100%; overflow: hidden; }
body.layout-app #app,
#app { width: 100%; height: 100vh; overflow: hidden; }

body.layout-public,
body.layout-auth {
    height: auto;
    min-height: 100vh;
    overflow-x: hidden;
    overflow-y: auto;
}
body.layout-public #app,
body.layout-public .main-content { height: auto; overflow: visible; }

:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
}


/* ================================================================
   3. KEYFRAMES (Ãºnicos)
   ================================================================ */
@keyframes fadeIn      { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes fadeInUp    { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
@keyframes fadeOnly    { to { opacity: 1; } }
@keyframes pageFade    { 0% { opacity: 0; transform: translateY(10px); } 100% { opacity: 1; transform: translateY(0); } }
@keyframes slideInRight  { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
@keyframes slideOutRight { from { transform: translateX(0); opacity: 1; } to { transform: translateX(100%); opacity: 0; } }
@keyframes slideIn     { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
@keyframes modalIn     { from { opacity: 0; transform: translateY(-12px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes modalFadeIn { from { opacity: 0; transform: scale(.95); } to { opacity: 1; transform: scale(1); } }
@keyframes modalSlideUp{ from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
@keyframes cardAppear  { 0% { opacity: 0; transform: scale(.95); box-shadow: 0 4px 20px rgba(10,10,10,.06); } 100% { opacity: 1; transform: scale(1); box-shadow: 0 12px 40px rgba(201,162,39,.18); } }
@keyframes logoSlide   { to { opacity: 1; transform: translateY(0); } }
@keyframes fieldSlide  { to { opacity: 1; transform: translateX(0); } }
@keyframes fieldSlideUp{ to { opacity: 1; transform: translateY(0); } }
@keyframes messageSlide{ to { opacity: 1; transform: translateX(0); } }
@keyframes hrGrow      { to { opacity: 1; transform: scaleX(1); } }
@keyframes logoGlow    { 0% { text-shadow: 0 0 0 rgba(201,162,39,0); } 100% { text-shadow: 0 0 20px rgba(201,162,39,.35); } }
@keyframes infoGlow    { 0% { box-shadow: 0 0 0 rgba(201,162,39,0); border-left-color: var(--primary); } 100% { box-shadow: 0 0 20px rgba(201,162,39,.15); border-left-color: var(--primary-dark); } }
@keyframes btnPulse    { 0%, 100% { transform: scale(1); box-shadow: 0 4px 15px rgba(201,162,39,.3); } 50% { transform: scale(1.02); box-shadow: 0 6px 25px rgba(201,162,39,.45); } }
@keyframes pulse-btn   { 0%, 100% { transform: scale(1); box-shadow: 0 4px 15px rgba(201,162,39,.3); } 50% { transform: scale(1.03); box-shadow: 0 6px 22px rgba(201,162,39,.45); } }
@keyframes pulse-badge { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
@keyframes pulse-soft  { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }
@keyframes pulse-icon  { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
@keyframes pulseDot    { 0%, 100% { opacity: 1; } 50% { opacity: .6; } }
@keyframes pulseSuccess{ 0% { box-shadow: 0 0 0 0 rgba(22,163,74,.7); } 70% { box-shadow: 0 0 0 15px rgba(22,163,74,0); } 100% { box-shadow: 0 0 0 0 rgba(22,163,74,0); } }
@keyframes pulse-recording { 0% { box-shadow: 0 0 0 0 rgba(220,38,38,.6); } 70% { box-shadow: 0 0 0 10px rgba(220,38,38,0); } 100% { box-shadow: 0 0 0 0 rgba(220,38,38,0); } }
@keyframes blink       { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
@keyframes wave        { 0%, 100% { transform: scaleY(.4); } 50% { transform: scaleY(1); } }
@keyframes callRipple  { 0% { transform: scale(1); opacity: .7; } 100% { transform: scale(3.5); opacity: 0; } }
@keyframes iconBounce  { 0% { transform: scale(0); } 50% { transform: scale(1.3); } 100% { transform: scale(1); } }
@keyframes spin        { to { transform: rotate(360deg); } }
@keyframes bgFloat     { 0% { transform: translate(0,0) rotate(0); } 100% { transform: translate(2%,2%) rotate(3deg); } }
@keyframes rotateBg    { 100% { transform: rotate(360deg); } }
@keyframes float       { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }
@keyframes float-soft  { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
@keyframes float-side  { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(-15px); } }
@keyframes float-rotate{ 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-15px) rotate(2deg); } }
@keyframes float-empty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
@keyframes floatIcon   { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
@keyframes floatCard   { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }


/* ================================================================
   4. LAYOUT DO PAINEL â€” SIDEBARS / TOPBAR / CONTEÃšDO
   ================================================================ */

/* ---------- 4.1 Sidebars (admin, egresso, empresa) ---------- */
.admin-sidebar,
.egresso-sidebar,
.empresa-sidebar {
    position: fixed;
    top: var(--topbar-h);
    left: 0;
    bottom: 0;
    width: var(--sidebar-w);
    height: calc(100vh - var(--topbar-h));
    min-height: 0;
    background: var(--surface);
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    z-index: 1040;
    overflow: hidden;
    box-shadow: 0 0 30px rgba(10, 10, 10, .05);
    transition: transform .3s ease, opacity .3s ease;
}

/* Marca / logÃ³tipo */
.sidebar-brand {
    flex-shrink: 0;
    width: 100%;
    min-height: 140px;
    padding: 20px 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--ink-100);
    background: linear-gradient(135deg, var(--surface-alt), var(--surface));
    position: relative;
}
.sidebar-brand img { display: block; height: 120px; width: auto; max-width: 100%; max-height: 120px; object-fit: contain; transition: transform .3s ease; }
.sidebar-brand img:hover { transform: scale(1.03); }

/* Variante empresa (logÃ³tipo + nome do sector) */
.empresa-sidebar .sidebar-brand { display: block; min-height: 0; padding: 22px 18px 18px; text-align: center; }
.empresa-sidebar .sidebar-brand::after {
    content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
    width: 40px; height: 3px; background: var(--gradient-gold); border-radius: 3px 3px 0 0;
}
.sidebar-brand-link { display: block; }
.sidebar-logo { display: block; height: 64px; max-width: 180px; margin: 0 auto; object-fit: contain; transition: transform .25s ease; }
.sidebar-brand-link:hover .sidebar-logo { transform: scale(1.03); }
.sidebar-logo-placeholder {
    width: 76px; height: 76px; margin: 0 auto; border-radius: 50%;
    background: var(--black); color: var(--primary);
    display: flex; align-items: center; justify-content: center; font-size: 1.8rem;
    border: 2px solid var(--primary); box-shadow: 0 6px 16px -4px rgba(201,162,39,.35);
}
.sidebar-empresa-nome { margin-top: 10px; font-size: .92rem; font-weight: 700; color: var(--black); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sidebar-empresa-sector { display: block; margin-top: 2px; font-size: .72rem; font-weight: 600; color: var(--text-soft); text-transform: uppercase; letter-spacing: .6px; }

/* NavegaÃ§Ã£o */
.sidebar-nav {
    flex: 1;
    min-height: 0;
    padding: 16px 14px 30px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--ink-200) transparent;
}
.sidebar-nav::-webkit-scrollbar { width: 5px; }
.sidebar-nav::-webkit-scrollbar-track { background: transparent; }
.sidebar-nav::-webkit-scrollbar-thumb { background: var(--ink-200); border-radius: 10px; }
.sidebar-nav::-webkit-scrollbar-thumb:hover { background: var(--primary); }

.nav-section { padding: 18px 12px 6px; margin-top: 4px; }
.nav-section:first-child { margin-top: 0; padding-top: 8px; }
.nav-section,
.nav-section span {
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--text-soft);
}
.nav-section span { display: block; }

.nav-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 10px;
    color: var(--text-muted);
    font-size: .88rem;
    font-weight: 500;
    cursor: pointer;
    overflow: hidden;
    transition: all .2s cubic-bezier(.4, 0, .2, 1);
}
.nav-item::before {
    content: ''; position: absolute; left: 0; top: 50%;
    transform: translateY(-50%) scaleY(0);
    width: 3px; height: 60%;
    background: var(--gradient-gold);
    border-radius: 0 3px 3px 0;
    transition: transform .25s ease;
}
.nav-item:hover { background: var(--ink-50); color: var(--black); transform: translateX(3px); text-decoration: none; }
.nav-item:hover::before { transform: translateY(-50%) scaleY(1); }
.nav-item.active { background: linear-gradient(135deg, var(--gold-50), var(--gold-100)); color: var(--primary-dark); font-weight: 700; box-shadow: 0 2px 8px -2px rgba(201,162,39,.3); }
.nav-item.active::before { transform: translateY(-50%) scaleY(1); }
.nav-item-danger:hover { background: #fef2f2; color: var(--danger-dark); }
.nav-item-danger:hover::before { background: var(--danger-dark); }
.nav-item-danger:hover .nav-icon { background: #fee2e2; color: var(--danger-dark); }

.nav-icon {
    width: 42px; height: 42px; min-width: 42px; flex-shrink: 0;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem;
    background: var(--ink-50);
    color: var(--ink-500);
    transition: all .2s ease;
}
.nav-icon i { color: inherit; font-size: inherit; transition: color .2s ease; }
.nav-item:hover .nav-icon { transform: scale(1.06); background: var(--ink-100); color: var(--ink-800); }
.nav-item.active .nav-icon { transform: scale(1.08); background: var(--black); color: var(--primary); box-shadow: 0 4px 10px -2px rgba(10,10,10,.3); }

/* compatibilidade com itens antigos (Ã­cone <i> directo) */
.sidebar-nav > .nav-item > i { width: 20px; text-align: center; font-size: 1rem; flex-shrink: 0; }
.sidebar-nav .nav-item .badge { margin-left: auto; padding: 2px 8px; font-size: .6rem; border-radius: 99px; }
.sidebar-nav .nav-item .badge.bg-primary { background: var(--primary) !important; color: var(--on-primary); }
.sidebar-nav .nav-item .badge.bg-success { background: var(--success) !important; color: #fff; }
.sidebar-nav .nav-item .badge.bg-danger  { background: var(--danger) !important; color: #fff; }
.sidebar-nav .nav-item .badge.bg-info    { background: var(--info) !important; color: #fff; }
.sidebar-nav .nav-item .badge.bg-warning { background: var(--warning) !important; color: #fff; }
.nav-arrow { margin-left: auto; font-size: .7rem; color: var(--text-soft); transition: transform .3s ease; }
.nav-arrow.open { transform: rotate(90deg); }
.nav-sub { padding-left: 32px; margin: 0 12px; }
.nav-sub .nav-item { padding: 8px 16px; margin: 1px 0; font-size: .82rem; }
.nav-sub .nav-item i { width: 16px; font-size: .75rem; }

.nav-label { flex-grow: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Badge informativa da sidebar */
.nav-badge {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 20px; height: 20px; padding: 0 6px;
    border-radius: 10px; flex-shrink: 0;
    font-size: .65rem; font-weight: 800; letter-spacing: .3px;
    animation: pulse-badge 2s infinite;
}
.nav-badge.badge-danger  { background: var(--danger-dark); color: #fff; }
.nav-badge.badge-warning { background: var(--warning); color: #fff; }
.nav-badge.badge-success { background: var(--success-dark); color: #fff; }
.nav-badge.badge-info    { background: var(--info); color: #fff; }
.nav-badge.badge-primary { background: var(--primary); color: var(--on-primary); }

/* RodapÃ© da sidebar (utilizador / logout / texto) */
.sidebar-footer { flex-shrink: 0; padding: 14px 18px; border-top: 1px solid var(--ink-100); background: var(--surface); }
.sidebar-footer .user-info { display: flex; align-items: center; gap: 12px; }
.sidebar-footer .user-avatar {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    background: var(--black); color: var(--primary); font-weight: 700; font-size: 1.1rem;
}
.sidebar-footer .user-avatar img { width: 100%; height: 100%; object-fit: cover; }
.sidebar-footer .user-name { font-size: .85rem; font-weight: 600; color: var(--text); }
.sidebar-footer .user-role { font-size: .7rem; color: var(--text-muted); }
.sidebar-footer .logout-btn {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    margin-top: 12px; padding: 10px 16px;
    border-radius: var(--radius-sm); border: 1px solid rgba(239,68,68,.15);
    background: rgba(239,68,68,.08); color: var(--danger);
    font-size: .85rem; font-weight: 500; transition: all .2s ease;
}
.sidebar-footer .logout-btn:hover { background: rgba(239,68,68,.15); border-color: rgba(239,68,68,.3); transform: translateY(-1px); text-decoration: none; }
.sidebar-footer-text { font-size: .7rem; font-weight: 600; color: var(--text-soft); text-align: center; letter-spacing: .3px; }
.sidebar-footer-text i { color: var(--primary); opacity: .8; }

/* ---------- 4.2 Topbar administrativa / egresso ---------- */
.admin-topbar {
    position: fixed; top: 0; left: 0; right: 0; width: 100%;
    height: var(--topbar-h); min-height: var(--topbar-h);
    display: flex; align-items: center; flex-shrink: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border-color);
    box-shadow: 0 2px 12px rgba(10, 10, 10, .06);
    z-index: 1050;
}
.admin-topbar .page-title { font-size: 1.1rem; font-weight: 600; color: var(--text); }
.admin-topbar .page-title small { display: block; margin-top: 2px; font-size: .78rem; font-weight: 400; color: var(--text-muted); }
.admin-topbar .topbar-actions { position: relative; z-index: 1051; display: flex; align-items: center; gap: 10px; }
.admin-topbar .topbar-actions .btn { position: relative; transition: transform .2s ease, box-shadow .2s ease; }
.admin-topbar .topbar-actions .btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(201,162,39,.2); }
.admin-topbar .dropdown { position: relative; }
.admin-topbar .dropdown-menu { z-index: 1060; margin-top: 8px !important; border: 1px solid var(--border-color); border-radius: var(--radius); box-shadow: 0 10px 30px rgba(10,10,10,.12); }
.admin-topbar .dropdown-menu.show { display: block; }
.admin-topbar .dropdown-toggle { border-radius: var(--radius-sm); color: var(--text); background: transparent; }
.admin-topbar .dropdown-toggle:hover,
.admin-topbar .dropdown-toggle:focus { background: var(--surface-alt); color: var(--text); }

/* ---------- 4.3 Topbar da Ã¡rea empresa ---------- */
.empresa-topbar { position: sticky; top: 0; z-index: 1030; height: var(--topbar-h); flex-shrink: 0; }
.topbar-icon-btn { width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; transition: background .2s ease; }
.topbar-icon-btn:hover { background: var(--ink-50); }

.notif-badge {
    position: absolute; top: 2px; right: 2px;
    min-width: 18px; height: 18px; padding: 0 5px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 9px; border: 2px solid #fff;
    background: var(--danger-dark); color: #fff;
    font-size: .65rem; font-weight: 800; line-height: 1;
    animation: pulse-badge 2s infinite;
}
.notif-menu { min-width: 380px; max-width: 420px; border-radius: 16px; overflow: hidden; }
.notif-header { padding: 16px 20px 12px; background: linear-gradient(135deg, var(--surface-alt), #fff); border-bottom: 1px solid var(--ink-100); }
.notif-header-title { font-size: .95rem; font-weight: 700; color: var(--black); }
.notif-header-count { display: inline-block; margin-left: 8px; padding: 2px 8px; border-radius: 10px; background: #fee2e2; color: var(--danger-dark); font-size: .68rem; font-weight: 700; }
.notif-mark-all { font-size: .75rem; font-weight: 600; color: var(--primary-dark); }
.notif-mark-all:hover { color: var(--black); text-decoration: underline !important; }
.notif-summary { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 12px 14px; }
.notif-summary-item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 12px; border: 1px solid var(--ink-100); background: var(--surface-alt); transition: all .2s ease; }
.notif-summary-item:hover { background: var(--ink-50); transform: translateY(-1px); box-shadow: 0 4px 10px -2px rgba(10,10,10,.08); }
.notif-summary-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: .95rem; flex-shrink: 0; }
.notif-summary-primary { background: var(--gold-100); color: var(--primary-dark); }
.notif-summary-success { background: #d1fae5; color: #059669; }
.notif-summary-text { display: flex; flex-direction: column; line-height: 1.1; }
.notif-summary-text strong { font-size: 1.1rem; font-weight: 800; color: var(--black); }
.notif-summary-text small { font-size: .68rem; font-weight: 600; color: var(--text-muted); }
.notif-scroll { max-height: 380px; overflow-y: auto; }
.notif-scroll::-webkit-scrollbar { width: 5px; }
.notif-scroll::-webkit-scrollbar-thumb { background: var(--ink-200); border-radius: 3px; }
.notif-item { position: relative; display: flex; align-items: flex-start; gap: 12px; padding: 14px 18px; color: inherit; border-bottom: 1px solid var(--ink-50); transition: background .15s ease; }
.notif-item:hover { background: var(--surface-alt); }
.notif-item.notif-unread { background: var(--gold-50); }
.notif-item.notif-unread:hover { background: var(--gold-100); }
.notif-item-icon { width: 38px; height: 38px; min-width: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: .95rem; flex-shrink: 0; }
.notif-item-primary   { background: var(--gold-100); color: var(--primary-dark); }
.notif-item-success   { background: #d1fae5; color: #059669; }
.notif-item-warning   { background: #fef3c7; color: #d97706; }
.notif-item-danger    { background: #fee2e2; color: var(--danger-dark); }
.notif-item-info      { background: var(--ink-100); color: var(--ink-600); }
.notif-item-secondary { background: var(--ink-50); color: var(--ink-500); }
.notif-item-body { flex: 1; min-width: 0; }
.notif-item-title { display: block; margin-bottom: 2px; font-size: .82rem; font-weight: 700; color: var(--black); line-height: 1.3; }
.notif-item-msg { margin: 0 0 4px; font-size: .75rem; color: var(--text-muted); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.notif-item-time { font-size: .68rem; font-weight: 500; color: var(--text-soft); }
.notif-dot { position: absolute; top: 18px; right: 18px; width: 8px; height: 8px; border-radius: 50%; background: var(--primary); box-shadow: 0 0 0 3px rgba(201,162,39,.2); }
.user-menu-btn { border-radius: 50px; transition: background .2s ease; }
.user-menu-btn:hover { background: var(--ink-50); }
.user-avatar-placeholder { width: 36px; height: 36px; }
.user-menu { min-width: 240px; border-radius: 12px; }

/* ---------- 4.4 Ãrea de conteÃºdo ---------- */
.main-content {
    position: fixed;
    top: var(--topbar-h);
    left: var(--sidebar-w);
    right: 0;
    bottom: 0;
    width: auto; height: auto; min-height: 0;
    display: flex; flex-direction: column;
    overflow: hidden;
    background: var(--bg);
    transition: left .3s ease, margin-left .3s ease;
}
.main-content .content-wrapper {
    flex: 1; min-height: 0; width: 100%;
    padding: 24px 32px;
    overflow-y: auto; overflow-x: hidden;
}
.main-content .content-wrapper::-webkit-scrollbar { width: 8px; }
.main-content .content-wrapper::-webkit-scrollbar-track { background: var(--bg); border-radius: 10px; }
.main-content .content-wrapper::-webkit-scrollbar-thumb { background: var(--ink-200); border-radius: 10px; }
.main-content .content-wrapper::-webkit-scrollbar-thumb:hover { background: var(--primary); }

/* Ãrea empresa (layout flex com margem) */
#empPanelShell { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.emp-main { margin-left: var(--sidebar-w); height: 100vh; display: flex; flex-direction: column; overflow: hidden; transition: left .3s ease, margin-left .3s ease; }
.emp-content { flex: 1 1 auto; padding: 24px; overflow-y: auto; overflow-x: hidden; -webkit-overflow-scrolling: touch; }
.emp-content::-webkit-scrollbar { width: 8px; }
.emp-content::-webkit-scrollbar-track { background: transparent; }
.emp-content::-webkit-scrollbar-thumb { background: var(--ink-200); border-radius: 4px; }
.emp-content::-webkit-scrollbar-thumb:hover { background: var(--primary); }

.empresa-footer { flex-shrink: 0; padding: 14px 0; background: #fff; border-top: 1px solid var(--border-color); transition: margin-left .3s ease; }
.global-footer { margin-top: 3rem; padding: 1.5rem 0; background: var(--surface-alt); border-top: 1px solid var(--border-color); font-size: .85rem; color: var(--text-muted); }
.global-footer .footer-content { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
.global-footer .footer-left strong { color: var(--primary-dark); font-weight: 700; }
.global-footer .footer-sep { margin: 0 .5rem; color: var(--ink-200); }
.footer-link { color: var(--text-muted); font-weight: 600; transition: color .2s ease; }
.global-footer .footer-link { display: inline-flex; align-items: center; gap: .4rem; color: var(--primary-dark); }
.footer-link:hover { color: var(--primary-dark); }
.global-footer .footer-link:hover { color: var(--black); transform: translateY(-1px); }
.global-footer .footer-link i { font-size: .9rem; }

/* ---------- 4.5 Overlay ---------- */
.sidebar-overlay,
.emp-sidebar-overlay {
    position: fixed; inset: 0; display: none;
    background: rgba(10, 10, 10, .5);
    backdrop-filter: blur(2px);
    z-index: 1055;
}
.sidebar-overlay.open,
.emp-sidebar-overlay.open { display: block; }

/* ---------- 4.6 Colapso da sidebar (desktop) ---------- */
@media (min-width: 992px) {
    body:not(.sidebar-collapsed) .admin-sidebar,
    body:not(.egresso-sidebar-collapsed) .egresso-sidebar,
    body:not(.emp-sidebar-collapsed) .empresa-sidebar { transform: translateX(0); opacity: 1; visibility: visible; }

    body.sidebar-collapsed .admin-sidebar,
    body.egresso-sidebar-collapsed .egresso-sidebar,
    body.emp-sidebar-collapsed .empresa-sidebar { transform: translateX(-100%); opacity: 0; visibility: hidden; }

    body.sidebar-collapsed .main-content,
    body.egresso-sidebar-collapsed .main-content { left: 0; margin-left: 0; width: 100%; }
    body.emp-sidebar-collapsed .emp-main { margin-left: 0; }

    body:not(.emp-sidebar-collapsed) .empresa-footer { margin-left: var(--sidebar-w); }
    body.emp-sidebar-collapsed .empresa-footer { margin-left: 0; }

    .sidebar-overlay, .sidebar-overlay.open,
    .emp-sidebar-overlay, .emp-sidebar-overlay.open { display: none !important; }
}

/* ---------- 4.7 Mobile / tablet ---------- */
@media (max-width: 991.98px) {
    .admin-sidebar, .egresso-sidebar, .empresa-sidebar {
        top: 0; bottom: 0; height: 100vh;
        width: var(--sidebar-w-mobile);
        transform: translateX(-100%);
        z-index: 1070;
        box-shadow: 0 0 40px rgba(10,10,10,.2);
    }
    .admin-sidebar.open, .egresso-sidebar.open, .empresa-sidebar.open { transform: translateX(0); }
    .sidebar-overlay { z-index: 1060; }
    .emp-sidebar-overlay { z-index: 1049; }
    .admin-topbar { left: 0; width: 100%; }
    .main-content { top: var(--topbar-h); left: 0; right: 0; bottom: 0; width: 100%; z-index: 1; }
    .emp-main { margin-left: 0; }
    .sidebar-brand { min-height: 100px; padding: 15px; }
    .sidebar-brand img { height: 90px; }
    .empresa-sidebar .sidebar-brand { min-height: 0; }
}
@media (max-width: 767.98px) {
    .main-content .content-wrapper { padding: 16px; }
    .admin-topbar .container-fluid { padding-left: 12px !important; padding-right: 12px !important; }
    .admin-topbar .topbar-actions { gap: 6px; }
}
@media (max-width: 576px) {
    .main-content .content-wrapper { padding: 12px; }
    .admin-topbar .topbar-actions .btn { padding: .35rem .5rem; }
    .admin-topbar .topbar-actions .btn i { font-size: .85rem; }
    .sidebar-brand img { height: 70px; }
    .notif-menu { min-width: 92vw; max-width: 92vw; }
}
@media (max-width: 480px) {
    .admin-sidebar, .egresso-sidebar, .empresa-sidebar { width: 260px; }
}


/* ============================================================
   MODAIS — z-index e empilhamento corretos
============================================================ */
.modal {
    z-index: 1080 !important;
}

.modal-backdrop {
    z-index: 1075 !important;
}

.modal-dialog,
.modal-content {
    pointer-events: auto;
    position: relative;
    z-index: 1081 !important;
}

/* Elementos interativos dentro dos modais */
.modal form,
.modal textarea,
.modal input,
.modal button,
.modal select {
    pointer-events: auto !important;
}


/* ================================================================
   5. CARDS
   ================================================================ */
.card {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    box-shadow: 0 4px 6px -1px rgba(10,10,10,.06), 0 2px 4px -1px rgba(10,10,10,.04);
    overflow: hidden;
    transition: transform .3s, box-shadow .3s;
}
.card:hover { transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(10,10,10,.08), 0 4px 6px -2px rgba(10,10,10,.05); }
.card-header { padding: 1rem 1.5rem; background: transparent; border-bottom: 1px solid var(--ink-100) !important; color: var(--text); font-weight: 600; }
.card-header .card-title { margin: 0; font-size: 1rem; font-weight: 600; }
.card-body { padding: 1.5rem; color: var(--text); }
.card-footer { padding: 1rem 1.5rem; background: transparent; border-top: 1px solid var(--border-color); }
.card-shadow { box-shadow: 0 2px 20px rgba(10,10,10,.06); }

/* CartÃµes de acÃ§Ã£o rÃ¡pida */
.hover-card {
    cursor: pointer;
    border-radius: var(--radius) !important;
    background: var(--surface) !important;
    transition: all .3s ease;
    animation: fadeInUp .5s ease backwards;
}
.hover-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(201,162,39,.18) !important; border-color: var(--primary) !important; border-width: 2px !important; }
.hover-card:active { transform: scale(.95); }
.hover-card .card-body { padding: 1.25rem !important; }
.hover-card .rounded-circle { width: 60px; height: 60px; display: inline-flex !important; align-items: center !important; justify-content: center !important; transition: all .3s ease; }
.hover-card:hover .rounded-circle { transform: scale(1.1) rotate(-5deg); }
.hover-card .fa-2x { font-size: 1.8rem !important; }
.hover-card h6 { margin-top: 5px; font-size: .95rem; font-weight: 600; color: var(--text); }
.hover-card small { font-size: .75rem; }
.hover-card:nth-child(1) { animation-delay: .05s; } .hover-card:nth-child(2) { animation-delay: .10s; }
.hover-card:nth-child(3) { animation-delay: .15s; } .hover-card:nth-child(4) { animation-delay: .20s; }
.hover-card:nth-child(5) { animation-delay: .25s; } .hover-card:nth-child(6) { animation-delay: .30s; }
.hover-card:nth-child(7) { animation-delay: .35s; } .hover-card:nth-child(8) { animation-delay: .40s; }

/* Cores utilitÃ¡rias (o roxo antigo passou a grafite) */
.bg-purple { background-color: var(--ink-700) !important; }
.text-purple { color: var(--ink-700) !important; }
.bg-purple.bg-opacity-10 { background-color: rgba(38,38,38,.1) !important; }
.bg-cyan { background-color: var(--info); }
.text-cyan { color: var(--info) !important; }
.bg-cyan.bg-opacity-10 { background-color: rgba(87,83,78,.1) !important; }
.bg-gold { background-color: var(--primary) !important; color: var(--on-primary); }
.text-gold { color: var(--primary-dark) !important; }
.bg-black { background-color: var(--black) !important; }


/* ================================================================
   6. BOTÃ•ES
   ================================================================ */
.btn {
    padding: .5rem 1.25rem;
    border-radius: var(--radius-sm);
    font-size: .875rem;
    font-weight: 600;
    transition: all .2s ease;
}
.btn:hover { transform: translateY(-2px); }
.btn-sm { padding: .25rem .75rem; font-size: .75rem; }

.btn-primary { background: var(--primary); border-color: var(--primary); color: var(--on-primary); }
.btn-primary:hover, .btn-primary:focus { background: var(--primary-dark); border-color: var(--primary-dark); color: #fff; }
.btn-dark { background: var(--black); border-color: var(--black); color: var(--primary); }
.btn-dark:hover { background: var(--ink-700); border-color: var(--ink-700); color: var(--primary-light); }
.btn-outline-primary { border-color: var(--primary); color: var(--primary-dark); }
.btn-outline-primary:hover { background: var(--primary); border-color: var(--primary); color: var(--on-primary); }
.btn-outline-secondary { border-color: var(--border-color); color: var(--text-muted); }
.btn-outline-secondary:hover { background: var(--border-color); color: var(--text); }
.btn-outline-success { border-color: var(--success); color: var(--success-dark); }
.btn-outline-success:hover { background: var(--success); color: #fff; }
.btn-outline-info { border-color: var(--info); color: var(--info); }
.btn-outline-info:hover { background: var(--info); color: #fff; }
.btn-outline-warning { border-color: var(--warning); color: var(--warning); }
.btn-outline-warning:hover { background: var(--warning); color: #fff; }
.btn-success { background: var(--success); border-color: var(--success); color: #fff; }
.btn-success:hover { background: var(--success-dark); border-color: var(--success-dark); color: #fff; }
.btn-danger { background: var(--danger); border-color: var(--danger); color: #fff; }
.btn-danger:hover { background: var(--danger-dark); border-color: var(--danger-dark); color: #fff; }
.btn-warning { background: var(--warning); border-color: var(--warning); color: #fff; }
.btn-warning:hover { background: #b45309; border-color: #b45309; color: #fff; }
.btn-info { background: var(--info); border-color: var(--info); color: #fff; }
.btn-info:hover { background: var(--ink-700); border-color: var(--ink-700); color: #fff; }

.btn-save { padding: 14px 40px; border: none; border-radius: 10px; background: var(--gradient-gold); color: var(--on-primary); font-size: 1rem; font-weight: 600; box-shadow: 0 4px 15px rgba(201,162,39,.35); transition: all .3s ease; }
.btn-save:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(201,162,39,.5); }
.btn-cancel { padding: 14px 35px; border: 2px solid var(--border-color); border-radius: 10px; font-size: 1rem; font-weight: 600; transition: all .3s ease; }
.btn-cancel:hover { background: var(--surface-alt); border-color: var(--ink-200); }
.filter-btn { box-shadow: 0 4px 12px rgba(201,162,39,.25); transition: all .3s ease; }
.filter-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(201,162,39,.4); }
.btn-pulse { animation: pulse-btn 2.5s ease-in-out infinite; }
.btn-location { transition: all .3s ease; }
.btn-location:hover { transform: translateY(-2px); }
.btn-location:active { transform: scale(.95); }
.btn-action { padding: .65rem 1.4rem; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border-radius: 12px; font-weight: 600; transition: all .2s ease; }
.btn-action:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(10,10,10,.12); }
.btn-candidatar, .btn-inscrever { padding: .65rem 1rem; border-radius: 10px; font-weight: 600; transition: all .2s ease; }
.btn-candidatar:hover, .btn-inscrever:hover { transform: translateY(-2px); box-shadow: 0 8px 20px -4px rgba(201,162,39,.45); }
.btn-filtrar { padding: .5rem 1.5rem; border: none; border-radius: 8px; background: var(--gradient-gold); color: var(--on-primary); font-weight: 500; transition: all .3s; }
.btn-filtrar:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(201,162,39,.45); color: var(--on-primary); }
.btn-limpar-filtros { padding: .5rem 1.5rem; border: none; border-radius: 8px; background: var(--ink-100); color: var(--ink-600); font-weight: 500; transition: all .3s; }
.btn-limpar-filtros:hover { background: var(--ink-200); color: var(--black); }
.btn-verificar { width: 100%; margin-top: 1.5rem; padding: 1rem; border: none; border-radius: 14px; background: var(--gradient-gold); color: var(--on-primary); font-size: 1rem; font-weight: 700; box-shadow: 0 8px 20px -6px rgba(201,162,39,.5); transition: all .2s ease; }
.btn-verificar:hover { transform: translateY(-2px); box-shadow: 0 12px 28px -8px rgba(201,162,39,.6); color: var(--on-primary); }
.action-btn { padding: .45rem .85rem; border-radius: 10px; font-size: .8rem; font-weight: 600; transition: all .2s ease; }
.action-btn:hover { transform: translateY(-1px) translateX(4px); }
.action-icon-btn { width: 36px; height: 36px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 50% !important; transition: all .2s ease; }
.action-icon-btn:hover { transform: scale(1.1); }
.action-icon-btn i { font-size: .85rem; }
.send-btn { box-shadow: 0 4px 15px rgba(201,162,39,.3); transition: all .3s ease; }
.send-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(201,162,39,.45); }
.btn-egresso-action { width: 32px; height: 32px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--ink-50); color: var(--text-muted); transition: all .2s ease; }
.btn-egresso-action:hover { background: var(--primary); color: var(--on-primary); transform: scale(1.05); }
.btn-reload { margin-top: 1rem; padding: .5rem 1.5rem; border: none; border-radius: 8px; background: var(--primary); color: var(--on-primary); font-weight: 500; cursor: pointer; transition: background .2s; }
.btn-reload:hover { background: var(--primary-dark); color: #fff; }

.btn-nav-outline { display: inline-flex; align-items: center; gap: .4rem; padding: .6rem 1.25rem; border: 1.5px solid var(--primary); border-radius: 10px; background: transparent; color: var(--primary-dark); font-size: .9rem; font-weight: 600; white-space: nowrap; transition: all .2s ease; }
.btn-nav-outline:hover { background: var(--primary); color: var(--on-primary); text-decoration: none; }
.btn-nav-solid { display: inline-flex; align-items: center; gap: .4rem; padding: .6rem 1.25rem; border: none; border-radius: 10px; background: var(--gradient-gold); color: var(--on-primary); font-size: .9rem; font-weight: 600; white-space: nowrap; box-shadow: 0 4px 12px -2px rgba(201,162,39,.5); transition: all .2s ease; }
.btn-nav-solid:hover { transform: translateY(-2px); box-shadow: 0 8px 20px -4px rgba(201,162,39,.6); color: var(--on-primary); text-decoration: none; }
.btn-cta-white { display: inline-flex; align-items: center; gap: 10px; padding: 14px 36px; border-radius: 40px; background: #fff; color: var(--black); font-weight: 800; box-shadow: 0 8px 20px rgba(10,10,10,.2); transition: all .3s ease; }
.btn-cta-white:hover { transform: translateY(-3px); background: var(--gold-50); box-shadow: 0 12px 28px rgba(10,10,10,.28); text-decoration: none; }
.btn-event-ticket { display: inline-block; font-size: .85rem; font-weight: 600; color: var(--primary-dark); }
.btn-event-ticket:hover { text-decoration: underline; }

/* BotÃµes de chamada */
.call-btn { width: 40px; height: 40px; padding: 0; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(10,10,10,.1); transition: all .25s cubic-bezier(.16, 1, .3, 1); }
.call-btn:hover { transform: translateY(-2px) scale(1.05); box-shadow: 0 6px 16px rgba(10,10,10,.15); }
.call-btn i { font-size: .9rem; }
.btn-success.call-btn:hover { box-shadow: 0 6px 16px rgba(22,163,74,.4); }
.btn-primary.call-btn:hover { box-shadow: 0 6px 16px rgba(201,162,39,.5); }
.call-action-btn { width: 64px; height: 64px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border: 0; font-size: 1.4rem; transition: transform .25s ease; }
.call-action-btn:hover { transform: scale(1.1); }
#btnAceitarChamada { animation: pulseSuccess 1.5s infinite; }


/* ================================================================
   7. BADGES
   ================================================================ */
.badge { padding: .35rem .75rem; border-radius: 99px; font-size: .75rem; font-weight: 600; letter-spacing: .3px; }

.badge-primary   { background: var(--primary-soft); color: var(--primary-dark); }
.badge-success   { background: rgba(34,197,94,.15); color: var(--success-dark); }
.badge-danger    { background: rgba(239,68,68,.15); color: var(--danger); }
.badge-warning   { background: rgba(217,119,6,.15); color: var(--warning); }
.badge-info      { background: rgba(87,83,78,.15); color: var(--info); }
.badge-secondary { background: rgba(82,82,82,.12); color: var(--text-muted); }

.badge-active { background: #dcfce7; color: #166534; }
.badge-inactive { background: #fee2e2; color: #991b1b; }
.badge-blocked { background: var(--black); color: var(--primary); }
.badge-lost, .badge-lost_contact, .badge-unknown { background: var(--surface-alt); color: var(--text-muted); }

.badge-full_time { background: var(--gold-100); color: var(--primary-dark); }
.badge-part_time { background: var(--ink-100); color: var(--ink-700); }
.badge-freelance { background: #fef3c7; color: #92400e; }
.badge-self_employed { background: #fce7f3; color: #9d174d; }
.badge-unemployed { background: #fee2e2; color: #991b1b; }
.badge-student { background: #dcfce7; color: #166534; }

.badge-presencial { background: var(--black); color: var(--primary); }
.badge-online { background: var(--success); color: #fff; }
.badge-hibrido { background: var(--ink-600); color: #fff; }
.badge-workshop { background: var(--primary-dark); color: #fff; }
.badge-palestra { background: var(--warning); color: #fff; }
.badge-networking { background: #ec4899; color: #fff; }
.badge-outro { background: #6b7280; color: #fff; }

.badge-emprego { background: var(--black); color: var(--primary); }
.badge-estagio { background: var(--primary-dark); color: #fff; }
.badge-bolsa { background: var(--success); color: #fff; }
.badge-curso { background: var(--warning); color: #fff; }
.badge-evento { background: #ec4899; color: #fff; }
.badge-candidatado { background: var(--success); color: #fff; }

.badge-pendente { background: var(--warning); color: #fff; }
.badge-aceito { background: var(--success); color: #fff; }
.badge-recusado { background: var(--danger); color: #fff; }
.badge-conexao { background: var(--success); color: #fff; }
.badge-nao-conexao { background: #6c757d; color: #fff; }
.badge-current { background: var(--success); color: #fff; }
.badge-past { background: #6b7280; color: #fff; }
.badge-nao-lida { padding: 2px 8px; border-radius: 50%; background: var(--danger); color: #fff; font-size: .7rem; }
.badge-status { padding: 5px 15px; border-radius: 20px; font-size: .8rem; }
.badge-required { color: var(--danger); }

.badge-soft-primary   { background: var(--gold-50); color: var(--primary-dark); }
.badge-soft-success   { background: #ecfdf5; color: #16a34a; }
.badge-soft-warning   { background: #fffbeb; color: #d97706; }
.badge-soft-danger    { background: #fef2f2; color: #dc2626; }
.badge-soft-info      { background: var(--ink-50); color: var(--ink-600); }
.badge-soft-secondary { background: #f3f4f6; color: #6b7280; }
.badge-soft-purple    { background: var(--ink-50); color: var(--ink-700); }

.badge-tag {
    display: inline-flex; align-items: center; gap: .5rem;
    margin-bottom: 24px; padding: 6px 16px;
    border: 1px solid rgba(201,162,39,.35); border-radius: 30px;
    background: var(--gold-50); color: var(--primary-dark);
    font-size: .85rem; font-weight: 700;
}
.badge-admin { background: #fff0f0; color: #dc3545; }
.badge-egresso { background: var(--gold-50); color: var(--primary-dark); }
.badge-dot { width: 8px; height: 8px; display: inline-block; flex-shrink: 0; border-radius: 50%; background: var(--primary); box-shadow: 0 0 0 4px rgba(201,162,39,.2); animation: pulseDot 2s infinite; }

.status-badge { font-size: .75rem; font-weight: 600; transition: all .2s ease; }
.status-badge:hover { transform: scale(1.05); }
.status-pill { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1.1rem; border-radius: 50px; background: #fff; font-size: .85rem; font-weight: 600; box-shadow: 0 4px 12px rgba(10,10,10,.12); flex-shrink: 0; }
.status-pill-success { color: #16a34a; }
.status-pill-danger { color: #dc2626; }
.status-pill-warning { color: #d97706; }

.empresa-status-badge { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border: 1px solid; border-radius: 999px; font-size: .78rem; font-weight: 700; letter-spacing: .3px; }
.empresa-status-badge i { font-size: .5rem; }
.status-warning { background: #fef3c7; color: #92400e; border-color: #fcd34d; }
.status-success { background: #d1fae5; color: #065f46; border-color: #6ee7b7; }
.status-danger { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
.status-secondary { background: var(--ink-50); color: var(--ink-600); border-color: var(--ink-200); }


/* ================================================================
   8. TABELAS
   ================================================================ */
.table { width: 100%; margin-bottom: 0; color: var(--text); }
.table-responsive { overflow-x: auto; }
.table thead th { padding: .75rem 1rem; background: var(--surface-alt); border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: .75rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; }
.table tbody td { padding: .75rem 1rem; border-bottom: 1px solid var(--border-color); vertical-align: middle; }
.table tbody tr:hover { background: var(--primary-softer); }

.report-table thead th, .candidaturas-table thead th { padding-top: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: .7rem; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; }
.report-table tbody tr, .candidaturas-table tbody tr { transition: background .15s ease; }
.report-table tbody tr:hover, .candidaturas-table tbody tr:hover { background: var(--surface-alt); }

.custom-table thead { background: linear-gradient(135deg, var(--surface-alt), var(--ink-50)); }
.custom-table thead th { border-bottom: 2px solid var(--border-color); color: var(--text-muted); font-size: .8rem; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }
.custom-table tbody tr { border-bottom: 1px solid var(--ink-50); transition: all .2s ease; }
.custom-table tbody tr:hover { background: var(--surface-alt) !important; transform: translateX(4px); }
.custom-table tbody tr.row-new { background: linear-gradient(90deg, var(--primary-soft), transparent); border-left: 4px solid var(--primary); }
.custom-table tbody tr.row-new .fw-semibold { color: var(--primary-dark); }
.email-link { transition: all .2s ease; }
.email-link:hover { color: var(--primary-dark) !important; text-decoration: underline !important; }
.message-list-card { overflow: hidden; }
.pagination-wrapper nav { display: flex; justify-content: center; }

.order-number, .question-number-sm { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 10px; background: var(--ink-50); color: var(--ink-600); font-size: .85rem; font-weight: 700; }


/* ================================================================
   9. FORMULÃRIOS
   ================================================================ */
.form-control, .form-select, input, select {
    width: 100%;
    padding: .6rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font-size: .875rem;
    transition: all .2s ease;
}
.form-control:focus, .form-select:focus, input:focus, select:focus {
    outline: none;
    border-color: var(--primary);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 0 0 3px rgba(201,162,39,.2);
}
.form-control::placeholder, input::placeholder { color: var(--text-soft); }
.form-control-lg, .form-select-lg { padding: 12px 16px; border: 2px solid var(--border-color); font-size: 1rem; transition: all .3s ease; }
.form-control-lg:focus, .form-select-lg:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(201,162,39,.15); }
textarea.form-control { padding: .75rem .9rem; line-height: 1.6; resize: vertical; }
.form-label, label { display: block; margin-bottom: .35rem; color: var(--text-muted); font-size: .85rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
.form-text { font-size: .75rem; color: var(--text-muted); }
.is-invalid { border-color: var(--danger) !important; }
.invalid-feedback { color: var(--danger); font-size: .8rem; }
.input-group-text { border: 1.5px solid var(--border-color); }
.form-check-input { cursor: pointer; }
.form-check-input:checked { background-color: var(--primary); border-color: var(--primary); }
.form-check-input:focus { box-shadow: 0 0 0 4px rgba(201,162,39,.25); }
.form-switch .form-check-input { width: 2.5em; height: 1.35em; }
.form-switch .form-check-input:checked { background-color: #16a34a; border-color: #16a34a; }
.form-group { margin-bottom: 20px; }
.form-group label { margin-bottom: 5px; color: var(--text); font-size: .85rem; font-weight: 600; text-transform: none; letter-spacing: 0; }
.form-group.position-relative .form-control { padding-right: 45px; }
.form-section-title { margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid var(--ink-100); color: var(--text-muted); font-size: .8rem; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }
.info-badge { padding: 2px 10px; border-radius: 20px; background: var(--primary-soft); color: var(--primary-dark); font-size: .7rem; font-weight: 600; }
.divider { margin: 25px 0; border-top: 2px dashed var(--ink-100); }

input[type="file"] { padding: 10px; background: var(--surface-alt); color: var(--text-muted); }
input[type="file"]::file-selector-button { margin-right: 10px; padding: 8px 16px; border: none; border-radius: var(--radius-sm); background: var(--primary); color: var(--on-primary); cursor: pointer; transition: background .3s; }
input[type="file"]::file-selector-button:hover { background: var(--primary-dark); color: #fff; }
.custom-file-input { position: relative; display: inline-block; overflow: hidden; }
.custom-file-input input[type="file"] { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }

.filter-card .form-control:focus, .filter-card .form-select:focus,
.filtros-card .form-control:focus, .filtros-card .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(201,162,39,.2); }
.filtros-card .form-control, .filtros-card .form-select { border: 1px solid var(--border-color); border-radius: 8px; font-size: .875rem; }

.row-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.row-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
.field-group { transition: all .3s ease; }
.field-group-hidden { display: none !important; }

.password-wrapper, .password-toggle { position: relative; }
.password-wrapper input { padding-right: 45px; }
.password-toggle, .password-toggle .toggle-btn { padding: 0; border: none; background: none; color: var(--text-soft); font-size: 1.1rem; cursor: pointer; transition: all .3s ease; }
button.password-toggle { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); }
.password-toggle:hover, .password-toggle .toggle-btn:hover { color: var(--primary-dark); transform: scale(1.1); }
.password-toggle i { transition: all .3s ease; }
.field-icon { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); z-index: 10; padding: 0 5px; background: #fff; color: var(--ink-300); cursor: pointer; transition: color .3s ease; }
.field-icon:hover { color: var(--primary-dark); }
.spinner-border-sm { width: 1rem; height: 1rem; border-width: .15em; }
.spinner-border { animation: spin .8s linear infinite !important; }

/* PrÃ©-visualizaÃ§Ã£o de foto */
.photo-preview { width: 150px; height: 150px; margin-top: 10px; display: none; border: 4px solid #fff; border-radius: 50%; object-fit: cover; box-shadow: 0 4px 20px rgba(201,162,39,.25); opacity: 0; transform: scale(.8); transition: all .4s cubic-bezier(.16, 1, .3, 1); }
.photo-preview.show { display: block; opacity: 1; transform: scale(1); }
.photo-preview:hover { transform: scale(1.05); box-shadow: 0 8px 30px rgba(201,162,39,.4); }
.photo-preview-container { position: relative; text-align: center; }
.photo-upload-overlay { position: absolute; bottom: 5px; left: 50%; transform: translateX(-50%); padding: 6px 20px; border-radius: 20px; background: rgba(10,10,10,.92); color: var(--primary); font-size: .75rem; font-weight: 600; white-space: nowrap; opacity: 0; cursor: pointer; transition: all .3s ease; }
.photo-preview-container:hover .photo-upload-overlay { opacity: 1; }


/* ================================================================
   10. ALERTAS, MENSAGENS E VALIDAÃ‡ÃƒO
   ================================================================ */
.alert { width: 100%; padding: 1rem 1.5rem; border: none; border-radius: 10px; }
.alert-success { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.3); color: var(--success-dark); }
.alert-danger  { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.3); color: var(--danger); }
.alert-warning { background: rgba(217,119,6,.1); border: 1px solid rgba(217,119,6,.3); color: var(--warning); }
.alert-info    { background: var(--primary-soft); border: 1px solid rgba(201,162,39,.35); color: var(--primary-dark); }
.alert-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 10px; font-size: 1.05rem; }

.error-message { margin-bottom: 20px; padding: 12px; border: 1px solid #ffd4d4; border-radius: 10px; background: #fff0f0; color: #c0392b; font-size: .85rem; opacity: 0; transform: translateX(-20px); animation: messageSlide .5s cubic-bezier(.16,1,.3,1) forwards; }
.error-message ul { padding-left: 20px; margin: 0; }
.success-message { margin-bottom: 20px; padding: 12px; border: 1px solid #c8e6c9; border-radius: 10px; background: #e8f5e9; color: #2e7d32; font-size: .85rem; opacity: 0; transform: translateX(-20px); animation: messageSlide .5s cubic-bezier(.16,1,.3,1) forwards; }
.pending-message { margin-bottom: 10px; padding: 8px 12px; border: 1px solid #ffc107; border-radius: 8px; background: #fff3cd; color: #856404; font-size: 11px; line-height: 1.4; }
.pending-message strong { display: block; margin-bottom: 2px; font-size: 12px; }
.info-box { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; padding: 14px; border: 1px solid rgba(201,162,39,.35); border-radius: 10px; background: var(--gold-50); color: var(--primary-dark); font-size: .8rem; animation: infoGlow 3s ease-in-out infinite alternate; transition: all .3s ease; }
.info-box:hover { background: var(--gold-100); }
.info-box i { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 10px; background: #fff; font-size: 1.3rem; }
.info-box-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 10px; font-size: 1rem; }
.info-box-content { flex-grow: 1; min-width: 0; }

.validation-status { display: none; margin-top: 8px; padding: 8px 12px; border-radius: var(--radius-sm); font-size: .8rem; opacity: 0; transition: all .4s cubic-bezier(.16,1,.3,1); }
.validation-status.valid { display: block; opacity: 1; background: #e8f5e9; border: 1px solid #c8e6c9; color: #2e7d32; }
.validation-status.invalid { display: block; opacity: 1; background: #fff0f0; border: 1px solid #ffd4d4; color: #c0392b; }
.validation-status.loading { display: block; opacity: 1; background: var(--gold-50); border: 1px solid rgba(201,162,39,.35); color: var(--primary-dark); }
.validation-status.pending-info { display: block; opacity: 1; background: #fff3cd; border: 1px solid #ffc107; color: #856404; }
.validation-status i { animation: iconBounce .6s cubic-bezier(.16,1,.3,1); }


/* ================================================================
   11. PROGRESSO, GRADIENTES E UTILITÃRIOS
   ================================================================ */
.progress { background: var(--ink-100); border-radius: 10px; height: 8px; overflow: hidden; }
.progress-bar { border-radius: 10px; background: var(--primary); transition: width .8s cubic-bezier(.16,1,.3,1); }
.evento-progress .progress, .oportunidade-progress .progress { background: var(--ink-50); }

.bg-gradient-primary { background: var(--gradient-gold) !important; color: var(--on-primary); }
.bg-gradient-dark { background: var(--gradient-dark) !important; color: var(--primary); }
.bg-gradient-success { background: linear-gradient(135deg, #16a34a, #22c55e) !important; }
.bg-gradient-warning { background: linear-gradient(135deg, #b45309, #d97706) !important; }
.bg-gradient-info { background: linear-gradient(135deg, #262626, #57534e) !important; }
.bg-white-20 { background: rgba(255,255,255,.4) !important; }
.text-white-50 { color: rgba(255,255,255,.75) !important; }
.text-muted { color: var(--text-muted) !important; }
.text-primary { color: var(--primary-dark) !important; }
.text-center { text-align: center; }
.bg-primary-subtle { background: var(--primary-soft) !important; }
.rounded-circle { border-radius: 50% !important; }
.object-fit-cover { object-fit: cover !important; }
.min-width-0 { min-width: 0; }
.font-monospace { font-family: 'SF Mono', 'Monaco', 'Cascadia Code', 'Roboto Mono', 'Courier New', monospace; }
.d-none { display: none !important; }
.text-linkedin { color: #0077b5 !important; }
.text-linkedin:hover { color: #005e8c !important; text-decoration: underline !important; }

.page-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
.page-header h5 { font-weight: 800; color: var(--black); }
.page-header p { margin-bottom: 0; }
.back-link { font-size: .9rem; font-weight: 500; transition: all .2s ease; }
.back-link:hover { color: var(--primary-dark) !important; transform: translateX(-3px); }

.section-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12px; font-size: 1rem; }
.service-icon, .course-icon, .type-icon { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 10px; font-size: .9rem; }
.empty-state-icon { font-size: 3.5rem; color: var(--ink-200); }
.empty-state { padding: 1.5rem 0; text-align: center; }
.empty-icon-wrapper { transition: all .3s ease; animation: float-empty 3s ease-in-out infinite; }
.empty-icon-wrapper:hover { transform: scale(1.05); background: var(--gold-50) !important; }
.empty-icon-pro { width: 80px; height: 80px; display: inline-flex; align-items: center; justify-content: center; transition: all .3s ease; }
.empty-state-card { border: 2px dashed var(--border-color) !important; background: linear-gradient(135deg, var(--surface-alt), #fff); }
.empty-icon { font-size: 4rem; color: var(--ink-200); transition: all .3s ease; }
.empty-card { border-radius: 18px; }
.empty-chat-icon { font-size: 3rem; color: var(--ink-200); }
.area-dot { width: 8px; height: 8px; flex-shrink: 0; border-radius: 50%; background: var(--primary); }
.network-empty { padding: 3rem 1.5rem; text-align: center; }
.network-empty i { display: block; margin-bottom: 1rem; font-size: 3rem; color: var(--ink-200); }
.network-empty h6 { color: var(--ink-600); }
.avatar-sm { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; background: var(--primary-soft); color: var(--primary-dark); font-size: .75rem; font-weight: 700; }
.avatar-circle { width: 40px; height: 40px; min-width: 40px; display: flex; align-items: center; justify-content: center; border-radius: 50%; box-shadow: 0 2px 8px rgba(10,10,10,.05); transition: all .3s ease; }
.table-row:hover .avatar-circle { transform: scale(1.08); box-shadow: 0 4px 12px rgba(201,162,39,.25); }
.avatar-fallback, .avatar-fallback-lg { display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--black); color: var(--primary); font-weight: 700; }
.avatar-fallback { width: 42px; height: 42px; font-size: .9rem; }


/* ================================================================
   12. LOGIN / REGISTO / RECUPERAÃ‡ÃƒO
   ================================================================ */

/* ---------- 12.1 CartÃµes simples (login-card / register-card) ---------- */
.login-container, .register-container { width: 100%; max-width: 640px; margin: 0 auto; opacity: 0; transform: translateY(30px); animation: fadeInUp .6s cubic-bezier(.16,1,.3,1) forwards; }
.login-container { max-width: 450px; }
.login-card, .register-card { position: relative; padding: 40px; border: 1px solid var(--border-color); border-radius: 16px; background: var(--surface); opacity: 0; transform: scale(.95); box-shadow: 0 4px 20px rgba(10,10,10,.06); animation: cardAppear .8s cubic-bezier(.16,1,.3,1) .1s forwards; }
.login-card::before, .register-card::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle at 30% 20%, rgba(201,162,39,.06), transparent 50%); opacity: 0; transition: opacity .6s ease; pointer-events: none; z-index: 0; }
.login-card:hover::before, .register-card:hover::before { opacity: 1; }
.login-card > *, .register-card > * { position: relative; z-index: 1; }
body:has(.login-card), body:has(.register-card) { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }

.logo { margin-bottom: 8px; font-family: 'Syne', Georgia, serif; font-size: 1.8rem; font-weight: 800; text-align: center; color: var(--text); opacity: 0; transform: translateY(-20px); animation: logoSlide .8s cubic-bezier(.16,1,.3,1) .2s forwards; }
.logo span { display: inline-block; color: var(--primary-dark); animation: logoGlow 2s ease-in-out infinite alternate; }
.subtitle { margin-bottom: 32px; color: var(--text-muted); font-size: .85rem; text-align: center; opacity: 0; animation: fadeOnly .6s ease .3s forwards; }
.form-group { opacity: 0; transform: translateX(-15px); animation: fieldSlide .5s cubic-bezier(.16,1,.3,1) forwards; }
.login-container .form-group:nth-child(1) { animation-delay: .15s; }
.login-container .form-group:nth-child(2) { animation-delay: .25s; }
.register-container .row-grid .form-group:nth-child(1) { animation-delay: .15s; }
.register-container .row-grid .form-group:nth-child(2) { animation-delay: .25s; }
.register-container .row-grid .form-group:nth-child(3) { animation-delay: .35s; }
.register-container .row-grid .form-group:nth-child(4) { animation-delay: .45s; }
.form-group-fullwidth { opacity: 0; transform: translateY(15px); animation: fieldSlideUp .6s cubic-bezier(.16,1,.3,1) .5s forwards !important; }
.form-group input, .form-group select { position: relative; transition: all .3s cubic-bezier(.16,1,.3,1) !important; }
.form-group input:focus, .form-group select:focus { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(201,162,39,.2); }

.btn-login, .btn-register { position: relative; width: 100%; margin-top: 8px; padding: 14px; overflow: hidden; border: none; border-radius: var(--radius-sm); background: var(--primary); color: var(--on-primary); font-size: 1rem; font-weight: 600; cursor: pointer; animation: btnPulse 2s ease-in-out infinite .8s; transition: background .3s; }
.btn-login:hover, .btn-register:hover { background: var(--primary-dark); color: #fff; }
.btn-register:disabled { opacity: .6; cursor: not-allowed; }
.btn-login::after, .btn-register::after { content: ''; position: absolute; top: 50%; left: 50%; width: 0; height: 0; border-radius: 50%; background: rgba(255,255,255,.3); transform: translate(-50%, -50%); transition: width .6s, height .6s; }
.btn-login:active::after, .btn-register:active::after { width: 300px; height: 300px; }

.register-link, .login-link { margin-top: 24px; color: var(--text-muted); font-size: .85rem; text-align: center; }
.register-link a, .login-link a { position: relative; color: var(--primary-dark); text-decoration: none !important; transition: all .3s ease; }
.register-link a::after, .login-link a::after { content: ''; position: absolute; bottom: -2px; left: 0; width: 0; height: 2px; background: var(--primary); transition: width .3s cubic-bezier(.16,1,.3,1); }
.register-link a:hover::after, .login-link a:hover::after { width: 100%; }
.register-link a:hover, .login-link a:hover { transform: translateX(4px); }

.back-home { position: relative; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px; color: var(--text-muted); font-size: .85rem; transition: all .3s cubic-bezier(.16,1,.3,1) !important; }
.back-home:hover { color: var(--primary-dark); transform: translateX(-8px) scale(1.02); background: rgba(201,162,39,.15) !important; }
.back-home i { transition: transform .3s ease; }
.back-home:hover i { transform: translateX(-4px); }

.register-container::before, .login-container::before { content: ''; position: fixed; top: -50%; left: -50%; width: 200%; height: 200%; z-index: -1; background: radial-gradient(circle at 30% 40%, rgba(201,162,39,.06) 0%, transparent 50%), radial-gradient(circle at 70% 60%, rgba(10,10,10,.04) 0%, transparent 50%); animation: bgFloat 20s ease-in-out infinite alternate; }
.page-transition { animation: pageFade .4s cubic-bezier(.16,1,.3,1) forwards; }

/* ---------- 12.2 Login "shell" (duas colunas) ---------- */
.login-shell, .register-shell, .reset-shell { position: relative; width: 100%; min-height: 100vh; min-height: 100dvh; display: flex; justify-content: center; align-items: center; padding: 24px; overflow: hidden; background: var(--bg); }
.login-shell::before, .register-shell::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,.85), transparent 45%), radial-gradient(circle at 14% 18%, rgba(201,162,39,.18), transparent 28rem); pointer-events: none; }
.login-shell::after, .register-shell::after { content: ''; position: absolute; width: 360px; height: 360px; right: -170px; bottom: -170px; border: 52px solid rgba(201,162,39,.12); border-radius: 50%; pointer-events: none; }

.login-panel { position: relative; z-index: 1; display: grid; grid-template-columns: .83fr 1.17fr; width: min(790px, 100%); min-height: 505px; margin: auto; overflow: hidden; border: 1px solid rgba(255,255,255,.9); border-radius: 22px; background: rgba(255,255,255,.92); box-shadow: 0 24px 60px rgba(10,10,10,.18); }
.register-panel { position: relative; z-index: 1; display: grid; grid-template-columns: 280px 1fr; width: 100%; max-width: 1400px; height: auto; min-height: 0; margin: auto; overflow: hidden; border: 1px solid rgba(255,255,255,.9); border-radius: 20px; background: rgba(255,255,255,.92); box-shadow: 0 20px 50px rgba(10,10,10,.18); }

.welcome-side { position: relative; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; padding: 32px; color: #fff; background: var(--black); }
.register-panel .welcome-side { padding: 24px 22px; border-radius: 20px 0 0 20px; height: auto; min-height: 0; }
.welcome-side::before { content: ''; position: absolute; width: 270px; height: 270px; right: -155px; bottom: -95px; border: 1px solid rgba(201,162,39,.5); border-radius: 50%; box-shadow: 0 0 0 25px rgba(201,162,39,.08), 0 0 0 52px rgba(201,162,39,.05); pointer-events: none; }
.welcome-side::after { content: ''; position: absolute; width: 120px; height: 120px; left: -65px; top: 48%; border-radius: 50%; background: rgba(201,162,39,.15); pointer-events: none; }
.brand { position: relative; z-index: 1; display: flex; align-items: center; gap: 12px; }
.brand .university-logo { max-height: 85px; border-radius: 50%; object-fit: cover; }
.university-logo { width: auto; max-height: 90px; padding: 6px 10px; border-radius: 10px; background: rgba(255,255,255,.95); object-fit: contain; box-shadow: 0 4px 12px rgba(0,0,0,.2); }
.register-panel .university-logo { display: block; position: relative; z-index: 1; width: 130px; height: 130px; margin: 0 auto; padding: 6px; border-radius: 50%; background: #fff; object-fit: cover; box-shadow: 0 4px 16px rgba(0,0,0,.3); }
.brand-text { display: flex; flex-direction: column; }
.university-name { font-size: 14px; font-weight: 700; line-height: 1.2; letter-spacing: -.01em; }
.university-sub { font-size: 10px; font-weight: 400; letter-spacing: .05em; text-transform: uppercase; opacity: .8; }
.welcome-content { position: relative; z-index: 1; max-width: 245px; }
.register-panel .welcome-content { max-width: 220px; }
.welcome-content .eyebrow { display: block; text-align: center; }
.eyebrow { display: block; margin-bottom: 15px; color: var(--primary-light); font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
.register-panel .eyebrow { margin-bottom: 10px; font-size: 9px; }
.welcome-content h2 { margin: 0; color: #fff; font-size: clamp(32px, 4vw, 43px); font-weight: 500; line-height: .98; letter-spacing: -.055em; }
.register-panel .welcome-content h2 { font-size: 26px; line-height: 1.05; letter-spacing: -.04em; }
.welcome-content p { max-width: 225px; margin: 17px 0 0; color: #e5dcc0; font-size: 13px; line-height: 1.6; }
.register-panel .welcome-content p { max-width: 210px; margin-top: 10px; font-size: 11.5px; line-height: 1.5; }
.quote { position: relative; z-index: 1; max-width: 220px; margin: 0; padding-top: 13px; border-top: 1px solid rgba(201,162,39,.4); color: #e5dcc0; font-size: 11px; line-height: 1.5; }
.register-panel .quote { max-width: 210px; padding-top: 10px; font-size: 9.5px; line-height: 1.4; }
.quote strong { display: block; margin-top: 7px; color: var(--primary); font-size: 10px; }

.form-side { display: flex; flex-direction: column; justify-content: center; padding: 45px 52px; background: #fff; }
.register-panel .form-side { padding: 20px 32px; overflow: visible; height: auto; min-height: 0; border-radius: 0 20px 20px 0; }
.form-intro { margin-bottom: 23px; text-align: center; }
.form-intro h1 { margin: 0 0 8px; color: var(--black); font-size: 31px; line-height: 1; letter-spacing: -.055em; }
.form-intro p { margin: 0; color: var(--muted); font-size: 13px; }
.register-panel .form-intro { margin-bottom: 12px; }
.register-panel .form-intro h1 { margin-bottom: 4px; font-size: 22px; letter-spacing: -.04em; }
.register-panel .form-intro p { font-size: 11.5px; }

.login-form { display: grid; gap: 15px; }
.login-shell .field-group, .reset-card .field-group { display: grid; gap: 7px; }
.login-shell .field-group label { color: #53647a; font-size: 11px; font-weight: 700; text-transform: none; letter-spacing: 0; }
.field { display: flex; align-items: center; gap: 10px; height: 48px; padding: 0 13px; border: 1px solid var(--border); border-radius: 11px; background: var(--surface-alt); transition: .2s ease; min-width: 0; }
.field:focus-within { border-color: var(--primary); background: #fff; box-shadow: 0 0 0 4px rgba(201,162,39,.2); }
.field-icon { color: var(--ink-300); font-size: 17px; }
.field input, .field select { flex: 1; min-width: 0; width: 100%; padding: 0; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: 13px; text-overflow: ellipsis; box-shadow: none; }
.field select { cursor: pointer; }
.field input::placeholder { color: var(--ink-300); }
.toggle-password { padding: 3px; border: 0; background: transparent; color: var(--ink-300); cursor: pointer; flex-shrink: 0; }
.toggle-password:hover { color: var(--primary-dark); }
.form-options { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; font-size: 11px; }
.remember { display: flex; align-items: center; gap: 7px; color: var(--ink-500); text-transform: none; letter-spacing: 0; font-weight: 400; cursor: pointer; transition: color .3s ease; }
.remember:hover { color: var(--primary-dark); }
.remember input { width: 16px; height: 16px; accent-color: var(--primary); cursor: pointer; }
.forgot-link { position: relative; color: var(--muted); font-weight: 600; cursor: pointer; transition: all .3s ease; }
.forgot-link:hover { color: var(--primary-dark); }
.forgot-link::after { content: ''; position: absolute; bottom: -2px; left: 0; width: 0; height: 2px; background: var(--primary); transition: width .3s ease; }
.forgot-link:hover::after { width: 100%; }
.signup { margin: 25px 0 0; color: var(--ink-400); font-size: 12px; text-align: center; }
.signup a { color: var(--primary-dark); font-weight: 700; }
.signup a:hover { text-decoration: underline; }
.login-shell .btn-login { width: auto; height: 48px; margin-top: 3px; padding: 0; border-radius: 11px; background: var(--black); color: var(--primary); box-shadow: 0 9px 18px rgba(10,10,10,.22); font: inherit; font-size: 13px; font-weight: 700; animation: none; }
.login-shell .btn-login:hover:not(:disabled) { transform: translateY(-2px); background: var(--ink-700); color: var(--primary-light); box-shadow: 0 13px 23px rgba(10,10,10,.3); }
.login-shell .btn-login:disabled { cursor: default; opacity: .85; }
.secure-note { margin-top: 17px; color: var(--text-soft); text-align: center; font-size: 10px; }
.loader { display: inline-block; width: 14px; height: 14px; margin-right: 7px; vertical-align: -2px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite; }
.register-panel .loader { width: 12px; height: 12px; margin-right: 6px; }

/* Modal "esqueci a senha" */
.modal-overlay { position: fixed; inset: 0; z-index: 9999; display: none; justify-content: center; align-items: center; background: rgba(10,10,10,.55); backdrop-filter: blur(4px); animation: modalFadeIn .3s ease; }
.modal-overlay.active { display: flex; }
.modal-content { position: relative; width: 100%; max-width: 420px; padding: 40px; border-radius: 20px; background: #fff; box-shadow: 0 24px 60px rgba(0,0,0,.25); animation: modalSlideUp .4s ease; }
.modal-close { position: absolute; top: 16px; right: 20px; border: none; background: none; color: var(--ink-300); font-size: 24px; line-height: 1; cursor: pointer; transition: color .3s ease; }
.modal-close:hover { color: var(--text); }
.modal-title { margin: 0 0 8px; color: var(--text); font-size: 24px; font-weight: 700; }
.modal-subtitle { margin-bottom: 24px; color: var(--muted); font-size: 13px; line-height: 1.5; }
.modal-field { margin-bottom: 16px; }
.modal-field label { display: block; margin-bottom: 6px; color: #53647a; font-size: 12px; font-weight: 600; text-transform: none; letter-spacing: 0; }
.modal-field input { width: 100%; height: 46px; padding: 0 14px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface-alt); font-size: 14px; transition: .2s ease; }
.modal-field input:focus { outline: none; border-color: var(--primary); background: #fff; box-shadow: 0 0 0 4px rgba(201,162,39,.2); }
.modal-btn { width: 100%; height: 46px; border: none; border-radius: 10px; background: var(--primary); color: var(--on-primary); font-size: 14px; font-weight: 600; cursor: pointer; box-shadow: 0 4px 15px rgba(201,162,39,.3); transition: all .3s ease; }
.modal-btn:hover { transform: translateY(-2px); background: var(--primary-dark); color: #fff; box-shadow: 0 8px 25px rgba(201,162,39,.45); }
.modal-btn:disabled { opacity: .7; cursor: not-allowed; transform: none; }
.modal-success { display: none; padding: 20px 0; text-align: center; }
.modal-success.active { display: block; }
.modal-success h3 { margin: 0 0 8px; color: var(--text); }
.modal-success p { margin: 0; color: var(--muted); font-size: 13px; }
.modal-error { display: none; margin-bottom: 12px; padding: 10px 14px; border: 1px solid #fecdcd; border-radius: 8px; background: #fff1f1; color: #a33d3d; font-size: 12px; }
.modal-error.active { display: block; }
.toast { position: fixed; top: 20px; right: 20px; z-index: 10000; display: none; padding: 14px 24px; border-radius: 12px; color: #fff; font-size: 14px; font-weight: 500; box-shadow: 0 8px 24px rgba(0,0,0,.15); animation: slideInRight .4s ease; }
.toast.show { display: block; }
.toast-success { background: linear-gradient(135deg, #16a34a, #20c997); }
.toast-error { background: linear-gradient(135deg, #dc2626, #e74c3c); }

/* RecuperaÃ§Ã£o de senha */
.reset-shell { background: var(--bg); }
.reset-card { width: 100%; max-width: 440px; padding: 40px; border-radius: 20px; background: #fff; box-shadow: 0 24px 60px rgba(10,10,10,.16); }
.reset-card h1 { margin: 0 0 8px; color: var(--black); font-size: 28px; font-weight: 700; }
.reset-card h1 span { font-size: 32px; }
.reset-card p, .reset-card .subtitle { margin-bottom: 24px; color: var(--muted); font-size: 14px; line-height: 1.6; text-align: left; opacity: 1; animation: none; }
.reset-card .field { margin-bottom: 12px; }
.reset-card .field .icon { font-size: 18px; opacity: .6; }
.reset-card .btn-reset { width: 100%; height: 48px; margin-top: 8px; border: 0; border-radius: 11px; background: var(--primary); color: var(--on-primary); font-size: 15px; font-weight: 700; cursor: pointer; transition: .2s ease; }
.reset-card .btn-reset:hover { transform: translateY(-2px); background: var(--primary-dark); color: #fff; box-shadow: 0 8px 25px rgba(201,162,39,.4); }
.reset-card .btn-reset:disabled { opacity: .7; cursor: not-allowed; transform: none; }
.reset-card .back-link { display: block; margin-top: 16px; color: var(--muted); font-size: 13px; text-align: center; transition: .2s ease; }
.reset-card .back-link:hover { color: var(--primary-dark); transform: none; }
.info-text { margin-top: 16px; color: var(--muted); font-size: 13px; text-align: center; }

/* ---------- 12.3 Registo (grelha 4 colunas) ---------- */
.register-form { display: grid; grid-template-columns: repeat(4, 1fr); gap: 9px 14px; align-items: end; }
.register-form .section-divider, .section-divider { grid-column: 1 / -1; margin-top: 2px; margin-bottom: -2px; padding-bottom: 2px; border-bottom: 1px solid var(--ink-100); color: var(--primary-dark); font-size: 9.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
.register-form .field-group { display: flex; flex-direction: column; justify-content: flex-end; gap: 2px; min-width: 0; height: 100%; }
.field-group.full-width { grid-column: 1 / -1; }
.field-group.span-2 { grid-column: span 2; }
.field-group.span-3 { grid-column: span 3; }
.register-form .field-group label { min-height: 13px; overflow: hidden; color: #53647a; font-size: 10.5px; font-weight: 700; line-height: 1.2; white-space: nowrap; text-overflow: ellipsis; text-transform: none; letter-spacing: 0; }
.field-group label .required-star { margin-left: 2px; color: #dc3545; }
.register-form .field { height: 36px; gap: 6px; padding: 0 11px; border-radius: 8px; }
.register-form .field:focus-within { box-shadow: 0 0 0 3px rgba(201,162,39,.2); }
.register-form .field input, .register-form .field select { font-size: 12px; }
.register-form .field input[type="file"] { padding: 0; background: transparent; color: var(--muted); font-size: 10.5px; }
.field-group .text-muted { display: block; min-height: 12px; margin-top: 1px; color: var(--muted); font-size: 10px; line-height: 1.2; }
.register-form .validation-status { margin-top: 2px; padding: 4px 8px; border-radius: 6px; font-size: 10px; line-height: 1.3; }
.submit-button { grid-column: 1 / -1; width: 240px; height: 42px; margin: 8px auto 0; border: 0; border-radius: 9px; background: var(--black); color: var(--primary); box-shadow: 0 6px 14px rgba(10,10,10,.25); font: inherit; font-size: 13.5px; font-weight: 700; cursor: pointer; transition: .2s ease; }
.submit-button:hover:not(:disabled) { transform: translateY(-1px); background: var(--ink-700); color: var(--primary-light); box-shadow: 0 10px 20px rgba(10,10,10,.32); }
.submit-button:disabled { cursor: default; opacity: .85; }
.register-panel .login-link { margin: 10px 0 2px; color: var(--ink-400); font-size: 11.5px; }
.register-panel .login-link a { color: var(--primary-dark); font-weight: 700; }

/* PÃ¡gina de verificaÃ§Ã£o de documentos */
.verify-card { max-width: 520px; margin: 0 auto; padding: 3rem 2.5rem; border: 1px solid var(--border-color); border-radius: 24px; background: #fff; box-shadow: 0 20px 60px -15px rgba(201,162,39,.3); }
.logo-wrap { margin-bottom: 2rem; text-align: center; }
.logo-wrap img { width: 100px; height: auto; max-height: 100px; object-fit: contain; }
.logo-fallback { width: 80px; height: 80px; margin: 0 auto; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--black); color: var(--primary); font-size: 32px; font-weight: 800; box-shadow: 0 8px 25px -8px rgba(201,162,39,.6); }
.verify-card .title { margin-bottom: .5rem; color: var(--black); font-size: 1.6rem; font-weight: 800; text-align: center; }
.verify-card .subtitle { margin-bottom: 2.5rem; color: var(--text-muted); font-size: .95rem; opacity: 1; animation: none; }
.verify-card .form-label { margin-bottom: .5rem; font-size: .8rem; font-weight: 700; letter-spacing: .5px; }
.verify-card .form-control { padding: .9rem 1.2rem; border: 2px solid var(--border-color); border-radius: 14px; font-size: 1.1rem; font-weight: 600; letter-spacing: 2px; text-align: center; text-transform: uppercase; }
.verify-card .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(201,162,39,.2); }
.help-text { margin-top: 1.5rem; color: var(--text-soft); font-size: .85rem; line-height: 1.6; text-align: center; }
.help-text i { color: var(--primary-dark); }

.result-card { max-width: 620px; margin: 0 auto; overflow: hidden; border: 1px solid var(--border-color); border-radius: 24px; background: #fff; box-shadow: 0 20px 60px -15px rgba(10,10,10,.2); }
.result-header { position: relative; padding: 2.5rem 2rem; overflow: hidden; color: #fff; text-align: center; }
.result-header.valid { background: linear-gradient(135deg, #16a34a, #22c55e); }
.result-header.invalid { background: linear-gradient(135deg, #dc2626, #ef4444); }
.result-header::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at top right, rgba(255,255,255,.15), transparent 60%); pointer-events: none; }
.result-icon { position: relative; z-index: 1; width: 80px; height: 80px; margin-bottom: 1rem; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.2); font-size: 2.5rem; }
.result-title { position: relative; z-index: 1; margin: 0 0 .5rem; font-size: 1.6rem; font-weight: 800; }
.result-subtitle { position: relative; z-index: 1; margin: 0; font-size: .95rem; opacity: .95; }
.result-body { padding: 2.5rem 2rem; }
.result-body .codigo-box { margin-bottom: 2rem; padding: 1rem 1.5rem; border: 2px dashed var(--ink-200); border-radius: 14px; background: var(--ink-50); text-align: center; }
.result-body .codigo-box small { display: block; margin-bottom: .4rem; color: var(--text-muted); font-size: .75rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
.result-body .codigo-box strong { color: var(--black); font-family: 'Courier New', monospace; font-size: 1.3rem; letter-spacing: 3px; word-break: break-all; }
.doc-type-badge { display: inline-block; margin-bottom: 1.5rem; padding: .5rem 1rem; border-radius: 50px; background: var(--gold-100); color: var(--primary-dark); font-size: .8rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
.result-body .info-grid { display: grid; gap: .9rem; }
.result-body .info-row { display: flex; align-items: center; gap: 1rem; padding: .9rem 1rem; border: 1px solid var(--border-color); border-radius: 12px; background: var(--surface-alt); }
.info-row-icon { width: 40px; height: 40px; min-width: 40px; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: var(--gold-50); color: var(--primary-dark); font-size: 1rem; }
.info-row-content { flex: 1; min-width: 0; }
.info-row-content small { display: block; margin-bottom: .15rem; color: var(--text-soft); font-size: .7rem; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; }
.info-row-content strong { color: var(--black); font-size: .95rem; word-break: break-word; }
.alert-invalid { padding: 1.25rem; border: 1px solid #fecaca; border-radius: 12px; background: #fef2f2; color: #991b1b; font-size: .9rem; line-height: 1.6; }
.alert-invalid i { color: #dc2626; }
.footer-note { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); color: var(--text-soft); font-size: .8rem; text-align: center; }
.footer-note strong { color: var(--primary-dark); }

/* PÃ¡gina de estado (aguardando validaÃ§Ã£o) */
.status-icon-wrapper { display: flex; justify-content: center; }
.status-icon-bg { width: 110px; height: 110px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(135deg, var(--gold-50), var(--gold-200)); color: var(--primary-dark); animation: pulse-icon 2s ease-in-out infinite; box-shadow: 0 0 0 15px rgba(201,162,39,.15), 0 0 0 30px rgba(201,162,39,.08); }
.info-mini-card { padding: 18px; border: 1px solid var(--border-color); border-radius: 12px; background: var(--surface-alt); transition: all .3s ease; }
.info-mini-card:hover { transform: translateY(-3px); background: var(--gold-50); box-shadow: 0 8px 20px rgba(201,162,39,.2); }
.info-mini-card i { font-size: 1.6rem; }


/* ================================================================
   13. PERFIL / EGRESSO
   ================================================================ */
.profile-cover, .profile-cover-brand { position: relative; height: 200px; overflow: hidden; border-radius: 12px 12px 0 0; background: var(--gradient-dark); }
.profile-avatar { position: absolute; bottom: -60px; left: 30px; }
.profile-avatar img { width: 120px; height: 120px; border: 4px solid #fff; border-radius: 50%; object-fit: cover; box-shadow: 0 4px 20px rgba(10,10,10,.2); }

/* Placeholder base e variantes por contexto */
.avatar-placeholder { width: 40px; height: 40px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--black); color: var(--primary); font-size: 1rem; font-weight: bold; }
.profile-avatar .avatar-placeholder { width: 120px; height: 120px; border: 4px solid #fff; font-size: 3rem; box-shadow: 0 4px 20px rgba(10,10,10,.2); }
.conversa-item .avatar-placeholder { width: 50px; height: 50px; font-size: 1.2rem; }
.contact-card .avatar-placeholder { width: 60px; height: 60px; min-width: 60px; border: 3px solid #fff; font-size: 1.5rem; box-shadow: 0 2px 10px rgba(10,10,10,.15); }
.profile-avatar-container .avatar-placeholder { width: 100%; height: 100%; border: 3px solid #fff; background: var(--black); box-shadow: var(--shadow-sm); font-size: 1.8rem; font-weight: 800; }
.photo-preview-container .avatar-placeholder { width: 150px; height: 150px; margin: 0 auto; border: 4px solid #fff; font-size: 4rem; box-shadow: 0 4px 20px rgba(201,162,39,.25); background: var(--gradient-gold); color: var(--on-primary); }

.profile-info { padding: 70px 30px 20px; }
.profile-name { color: var(--text); font-size: 1.8rem; font-weight: bold; }
.detail-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border-color); }
.detail-key { color: var(--text-muted); }
.detail-value { color: var(--text); font-weight: 500; }
.stat-publico { padding: 15px; border-radius: 10px; background: var(--surface-alt); text-align: center; transition: all .3s ease; }
.stat-publico:hover { background: #fff; box-shadow: 0 4px 15px rgba(10,10,10,.06); }
.stat-publico .numero { color: var(--text); font-size: 1.5rem; font-weight: 700; }
.stat-publico .rotulo { color: var(--text-muted); font-size: .8rem; }
.publicacao-item { padding: 15px 0; border-bottom: 1px solid var(--border-color); }
.publicacao-item:last-child { border-bottom: none; }
.oportunidade-card, .evento-card, .location-card, .profissional-card { transition: transform .3s, box-shadow .3s; }
.oportunidade-card:hover, .evento-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(10,10,10,.12); }

/* Hero do perfil (admin vÃª egresso) */
.hero-card { position: relative; overflow: hidden; border-radius: 20px !important; background: linear-gradient(135deg, #fff 0%, var(--surface-alt) 100%); }
.hero-card::before { content: ''; position: absolute; top: -80px; right: -80px; width: 240px; height: 240px; border-radius: 50%; background: linear-gradient(135deg, rgba(201,162,39,.12), rgba(201,162,39,.03)); pointer-events: none; }
.hero-card::after { content: ''; position: absolute; bottom: -60px; left: -60px; width: 180px; height: 180px; border-radius: 50%; background: linear-gradient(135deg, rgba(10,10,10,.05), transparent); pointer-events: none; }
.hero-card .card-body { position: relative; z-index: 1; }
.hero-avatar-wrapper { position: relative; width: 140px; height: 140px; }
.hero-avatar { width: 140px; height: 140px; border: 4px solid #fff; border-radius: 50%; object-fit: cover; box-shadow: 0 12px 32px rgba(10,10,10,.2), 0 2px 8px rgba(10,10,10,.06); }
.hero-avatar-fallback { width: 140px; height: 140px; display: flex; align-items: center; justify-content: center; border: 4px solid #fff; border-radius: 50%; background: var(--black); color: var(--primary); font-size: 3rem; font-weight: 700; letter-spacing: 2px; box-shadow: 0 12px 32px rgba(10,10,10,.3); }
.hero-verified { position: absolute; bottom: 6px; right: 6px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border: 3px solid #fff; border-radius: 50%; background: var(--primary); color: var(--on-primary); font-size: .9rem; box-shadow: 0 6px 16px rgba(201,162,39,.5); }
.hero-name { color: var(--black); letter-spacing: -.5px; }
.hero-badge { padding: .4em .75em; border-radius: 8px; font-size: .75rem; font-weight: 600; }
.hero-course { margin-bottom: 1rem; color: var(--primary-dark); font-size: 1rem; font-weight: 600; }
.hero-info-grid { margin-top: .5rem; }
.hero-info-item { height: 100%; display: flex; align-items: center; gap: .75rem; padding: .65rem .85rem; border: 1px solid var(--border-color); border-radius: 12px; background: #fff; transition: all .2s ease; }
.hero-info-item:hover { border-color: var(--ink-200); box-shadow: 0 4px 12px rgba(10,10,10,.05); transform: translateY(-1px); }
.hero-info-icon { width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; color: #fff; font-size: .9rem; }
.hero-info-icon-primary { background: var(--gradient-gold); color: var(--on-primary); }
.hero-info-icon-success { background: linear-gradient(135deg, #16a34a, #22c55e); }
.hero-info-icon-warning { background: linear-gradient(135deg, #b45309, #d97706); }
.hero-info-icon-info { background: var(--gradient-dark); color: var(--primary); }
.hero-info-content { display: flex; flex-direction: column; flex-grow: 1; min-width: 0; }
.hero-info-label { margin-bottom: .1rem; color: var(--text-muted); font-size: .7rem; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }
.hero-info-value { overflow: hidden; color: var(--black); font-size: .875rem; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.hero-info-mono { font-family: 'SF Mono', 'Monaco', 'Cascadia Code', monospace; letter-spacing: .5px; }
.hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; border-top: 1px solid var(--border-color); }
.hero-btn-primary { padding: .6rem 1.4rem; border-radius: 10px; font-weight: 600; box-shadow: 0 4px 12px rgba(201,162,39,.35); transition: all .2s ease; }
.hero-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(201,162,39,.5); }
.hero-btn-secondary { padding: .6rem 1.4rem; border-radius: 10px; font-weight: 600; transition: all .2s ease; }
.hero-btn-secondary:hover { transform: translateY(-2px); }
.hero-icon { width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 20px; color: #fff; font-size: 2rem; box-shadow: 0 8px 20px rgba(10,10,10,.15); }
.hero-icon.bg-primary { background: var(--gradient-gold) !important; color: var(--on-primary); }
.hero-icon.bg-info { background: var(--gradient-dark) !important; color: var(--primary); }
.hero-icon.bg-success { background: linear-gradient(135deg, #16a34a, #4ade80) !important; }
.hero-icon.bg-warning { background: linear-gradient(135deg, #b45309, #d97706) !important; }
.hero-icon.bg-secondary { background: linear-gradient(135deg, #475569, #64748b) !important; }

.info-row { display: flex; align-items: flex-start; gap: .85rem; padding: .75rem 0; border-bottom: 1px dashed var(--border-color); }
.info-row:last-child { border-bottom: none; }
.info-icon { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 10px; background: var(--surface-alt); font-size: .85rem; }
.info-content { min-width: 0; flex-grow: 1; }
.meta-row, .status-row { display: flex; justify-content: space-between; align-items: center; padding: .6rem 0; border-bottom: 1px dashed var(--border-color); font-size: .875rem; }
.meta-row:last-child, .status-row:last-child { border-bottom: none; }
.meta-box { height: 100%; display: flex; align-items: center; gap: .85rem; padding: .85rem 1rem; border: 1px solid var(--border-color); border-radius: 12px; background: var(--surface-alt); }
.meta-box-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 10px; font-size: 1rem; }
.meta-item { display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); font-size: .82rem; font-weight: 500; }
.meta-item i { color: var(--text-soft); }
.info-mini { padding: 1rem; border-radius: 12px; background: var(--surface-alt); text-align: center; }
.info-label { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; color: var(--text-muted); font-size: .85rem; font-weight: 500; }
.info-label i { width: 14px; color: var(--text-soft); text-align: center; }
.info-value { color: var(--black); font-size: .88rem; font-weight: 600; text-align: right; word-break: break-word; }
.info-value a { color: var(--primary-dark); }
.info-value a:hover { text-decoration: underline; }
.info-descricao { margin: 0; color: var(--ink-600); font-size: .88rem; line-height: 1.6; }
.pro-card { height: 100%; padding: 1rem; border: 1px solid var(--border-color); border-radius: 12px; background: var(--surface-alt); transition: transform .15s ease, box-shadow .15s ease; }
.pro-card:hover { transform: translateY(-2px); background: #fff; box-shadow: 0 6px 16px rgba(10,10,10,.06); }
.pro-card-icon { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; margin-bottom: .5rem; border-radius: 8px; font-size: .85rem; }
.mensagem-box { padding: 16px; border-left: 4px solid var(--primary); border-radius: 8px; background: var(--surface-alt); }
.content-box { padding: 1.25rem 1.5rem; border-left: 3px solid var(--primary); border-radius: 8px; background: var(--surface-alt); color: var(--ink-600); font-size: .95rem; line-height: 1.8; white-space: pre-wrap; }
.content-body { color: var(--ink-600); font-size: 1rem; line-height: 1.8; white-space: pre-wrap; }

/* CabeÃ§alho da empresa */
.empresa-header-card { position: relative; overflow: hidden; border: 1px solid var(--border-color); border-radius: 18px; background: linear-gradient(135deg, #fff, var(--surface-alt)); box-shadow: 0 4px 20px rgba(10,10,10,.05); }
.empresa-header-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: var(--gradient-gold); }
.empresa-header-body { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; padding: 28px 28px 24px; }
.empresa-header-logo { position: relative; flex-shrink: 0; }
.empresa-header-logo img { display: block; width: 110px; height: 110px; padding: 8px; border: 2px solid var(--border-color); border-radius: 16px; background: #fff; object-fit: contain; box-shadow: 0 4px 12px rgba(10,10,10,.06); }
.empresa-header-logo-placeholder { width: 110px; height: 110px; display: flex; align-items: center; justify-content: center; border: 2px solid var(--primary); border-radius: 16px; background: var(--black); color: var(--primary); font-size: 2.5rem; box-shadow: 0 4px 12px rgba(201,162,39,.25); }
.empresa-header-info { flex: 1; min-width: 240px; }
.empresa-header-nome { margin: 0 0 10px; color: var(--black); font-size: 1.6rem; font-weight: 800; letter-spacing: -.5px; }
.empresa-header-meta { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-bottom: 14px; }

/* CartÃµes de informaÃ§Ã£o e validaÃ§Ã£o (admin) */
.info-card, .validation-card, .actions-card { overflow: hidden; border: 1px solid var(--border-color); border-radius: 14px; background: #fff; box-shadow: 0 2px 8px rgba(10,10,10,.04); }
.info-card-header, .validation-card-header, .actions-card-header { display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-bottom: 1px solid var(--ink-100); }
.info-card-header { background: linear-gradient(135deg, var(--surface-alt), var(--ink-50)); }
.actions-card-header { background: linear-gradient(135deg, var(--gold-50), var(--gold-100)); border-bottom-color: var(--gold-100); }
.info-card-header i, .actions-card-header i { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 8px; background: var(--gold-50); color: var(--primary-dark); font-size: 1rem; }
.actions-card-header i { background: #fff; }
.info-card-header h6, .validation-card-header h6, .actions-card-header h6 { margin: 0; color: var(--black); font-size: .88rem; font-weight: 700; letter-spacing: -.2px; }
.validation-card-header i { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 8px; font-size: 1rem; }
.info-card-body { padding: 16px 18px; }
.actions-card-body { padding: 18px; }
.validation-card-body { padding: 20px 18px; }
.info-card .info-row { justify-content: space-between; align-items: flex-start; gap: 16px; padding: 10px 0; border-bottom: 1px dashed var(--ink-50); }
.info-card .info-row:first-child { padding-top: 0; }
.info-card .info-row:last-child { padding-bottom: 0; }
.validation-warning .validation-card-header { background: linear-gradient(135deg, #fffbeb, #fef3c7); }
.validation-warning .validation-card-header i { background: #fef3c7; color: #d97706; }
.validation-success .validation-card-header { background: linear-gradient(135deg, #ecfdf5, #d1fae5); }
.validation-success .validation-card-header i { background: #d1fae5; color: #059669; }
.validation-danger .validation-card-header { background: linear-gradient(135deg, #fef2f2, #fee2e2); }
.validation-danger .validation-card-header i { background: #fee2e2; color: #dc2626; }
.validation-secondary .validation-card-header { background: linear-gradient(135deg, var(--surface-alt), var(--ink-50)); }
.validation-secondary .validation-card-header i { background: var(--ink-50); color: var(--ink-500); }
.validation-status-display { display: flex; align-items: center; gap: 14px; }
.validation-status-icon { width: 54px; height: 54px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; font-size: 1.5rem; }
.status-icon-warning { background: linear-gradient(135deg, #fef3c7, #fde68a); color: #d97706; }
.status-icon-success { background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #059669; }
.status-icon-danger { background: linear-gradient(135deg, #fee2e2, #fecaca); color: #dc2626; }
.status-icon-secondary { background: linear-gradient(135deg, var(--ink-50), var(--ink-100)); color: var(--ink-500); }
.validation-status-text { display: flex; flex-direction: column; line-height: 1.3; }
.validation-status-text strong { color: var(--black); font-size: .95rem; font-weight: 700; }
.validation-status-text small { margin-top: 3px; color: var(--text-soft); font-size: .78rem; }
.motivo-reprovacao { margin-top: 18px; overflow: hidden; border: 1px solid #fecaca; border-radius: 12px; background: linear-gradient(135deg, #fef2f2, #fff1f1); }
.motivo-reprovacao-header { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: linear-gradient(135deg, #dc2626, #ef4444); color: #fff; font-size: .85rem; }
.motivo-reprovacao-header i { font-size: 1rem; }
.motivo-reprovacao-header strong { font-weight: 700; letter-spacing: .2px; }
.motivo-reprovacao-body { padding: 16px; color: #7f1d1d; font-size: .88rem; font-weight: 500; line-height: 1.6; }
.btn-action.btn-block { display: flex; padding: 12px 18px; font-size: .9rem; border-radius: 10px; }
.validation-finished-card { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border: 1px solid var(--border-color); border-radius: 14px; background: linear-gradient(135deg, var(--surface-alt), var(--ink-50)); color: var(--text-muted); }
.validation-finished-card i { color: var(--ink-300); font-size: 1.5rem; }
.validation-finished-card strong { display: block; color: var(--black); font-size: .88rem; font-weight: 700; }
.validation-finished-card small { font-size: .78rem; }
.modal-header-danger { border: 0; background: linear-gradient(135deg, #dc2626, #ef4444); color: #fff; }
.modal-header-danger .modal-title { font-size: 1rem; font-weight: 700; }


/* ================================================================
   14. ESTATÃSTICAS (stat-card) â€” variantes
   ----------------------------------------------------------------
   .stat-card ............ cartÃ£o sÃ³lido com gradiente (padrÃ£o)
   .stat-card--light ..... cartÃ£o branco com barra lateral colorida
   .stat-card--plain ..... cartÃ£o branco simples (Ã­cone + conteÃºdo)
   Cores: -primary (preto+dourado), -warning, -success, -danger,
          -info (dourado), -secondary
   ================================================================ */
.stat-card {
    position: relative; height: 100%; overflow: hidden;
    display: flex; align-items: center; gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: none; border-radius: 16px;
    color: var(--stat-fg, #fff);
    box-shadow: 0 4px 12px rgba(10,10,10,.1);
    transition: all .3s cubic-bezier(.4, 0, .2, 1);
}
.stat-card::before { content: ''; position: absolute; top: -50%; right: -30%; width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,.2) 0%, transparent 70%); pointer-events: none; }
.stat-card:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(10,10,10,.2); }
.stat-card.stat-active { transform: translateY(-2px); box-shadow: 0 0 0 3px rgba(255,255,255,.7), 0 12px 28px rgba(10,10,10,.2); }
a .stat-card, a:hover .stat-card, a:focus .stat-card { text-decoration: none; }

.stat-card-primary   { background: var(--gradient-dark); --stat-fg: #fff; }
.stat-card-warning   { background: linear-gradient(135deg, #b45309, #d97706); }
.stat-card-success   { background: linear-gradient(135deg, #16a34a, #22c55e); }
.stat-card-danger    { background: linear-gradient(135deg, #b91c1c, #ef4444); }
.stat-card-info      { background: var(--gradient-gold); --stat-fg: var(--black); }
.stat-card-secondary { background: linear-gradient(135deg, #525252, #a3a3a3); }

.stat-icon-wrap, .stat-card-icon {
    position: relative; z-index: 1;
    width: 56px; height: 56px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    border-radius: 14px;
    background: rgba(255,255,255,.2);
    border: 1px solid rgba(255,255,255,.25);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    color: inherit; font-size: 1.5rem;
    transition: transform .3s ease;
}
.stat-card-icon { width: 64px; height: 64px; border-radius: 16px; font-size: 1.6rem; }
.stat-card:hover .stat-icon-wrap, .stat-card:hover .stat-card-icon { transform: scale(1.1) rotate(-4deg); background: rgba(255,255,255,.3); }
.stat-card-primary .stat-icon-wrap, .stat-card-primary .stat-card-icon { color: var(--primary); }

.stat-body, .stat-card-body { position: relative; z-index: 1; flex-grow: 1; min-width: 0; color: inherit; }
.stat-value, .stat-card-value { margin-bottom: .25rem; color: inherit !important; font-size: 1.75rem; font-weight: 700; line-height: 1; text-shadow: 0 1px 2px rgba(0,0,0,.15); }
.stat-card-value { font-size: 2.1rem; font-weight: 800; letter-spacing: -.5px; }
.stat-label, .stat-card-label { color: inherit !important; font-size: .85rem; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; opacity: .92; text-shadow: 0 1px 2px rgba(0,0,0,.12); }
.stat-card-label { margin-bottom: .35rem; font-size: .72rem; font-weight: 700; letter-spacing: .9px; }
.stat-desc, .stat-card-desc { display: flex; align-items: center; gap: .35rem; color: inherit; font-size: .75rem; font-weight: 500; opacity: .85; }
.stat-bg-icon { position: absolute; right: -10px; bottom: -15px; z-index: 1; color: #fff; font-size: 5rem; opacity: .15; }

/* Variante clara (barra lateral colorida) */
.stat-card--light { color: var(--text); background: #fff; border: 1px solid var(--border-color); box-shadow: none; padding: 1.5rem 1.75rem; border-radius: 18px; gap: 1.25rem; }
.stat-card--light::before { content: ''; position: absolute; top: 0; left: 0; bottom: 0; width: 4px; right: auto; height: auto; border-radius: 18px 0 0 18px; background: var(--gradient-gold); transition: width .3s ease; }
.stat-card--light:hover { border-color: transparent; box-shadow: 0 20px 40px -12px rgba(10,10,10,.12); background: linear-gradient(135deg, var(--gold-50) 0%, #fff 100%); }
.stat-card--light:hover::before { width: 6px; }
.stat-card--light .stat-card-icon { border: none; backdrop-filter: none; color: var(--on-primary); background: var(--gradient-gold); box-shadow: 0 8px 20px -6px rgba(201,162,39,.5); }
.stat-card--light .stat-card-label { color: var(--text-soft) !important; text-shadow: none; opacity: 1; }
.stat-card--light .stat-card-value { color: var(--primary-dark) !important; text-shadow: none; }
.stat-card--light .stat-card-desc { color: var(--text-muted); }
.stat-card--light.stat-card-success::before, .stat-card--light.stat-card-success .stat-card-icon { background: linear-gradient(135deg, #16a34a, #4ade80); color: #fff; }
.stat-card--light.stat-card-success .stat-card-value { color: #16a34a !important; }
.stat-card--light.stat-card-warning::before, .stat-card--light.stat-card-warning .stat-card-icon { background: linear-gradient(135deg, #b45309, #f59e0b); color: #fff; }
.stat-card--light.stat-card-warning .stat-card-value { color: #d97706 !important; }
.stat-card--light.stat-card-danger::before, .stat-card--light.stat-card-danger .stat-card-icon { background: linear-gradient(135deg, #b91c1c, #f87171); color: #fff; }
.stat-card--light.stat-card-danger .stat-card-value { color: #dc3545 !important; }
.stat-card--light.stat-card-info::before, .stat-card--light.stat-card-info .stat-card-icon { background: var(--gradient-dark); color: var(--primary); }
.stat-card--light.stat-card-info .stat-card-value { color: var(--ink-700) !important; }
.stat-card--light.stat-card-secondary::before, .stat-card--light.stat-card-secondary .stat-card-icon { background: linear-gradient(135deg, #64748b, #94a3b8); color: #fff; }
.stat-card--light.stat-card-secondary .stat-card-value { color: var(--ink-600) !important; }
.stat-card--light.stat-card-primary { --stat-fg: var(--text); }

/* Variante simples (Ã­cone + conteÃºdo) */
.stat-card--plain { color: var(--text); background: #fff; border: 1px solid var(--border-color); box-shadow: none; padding: 1rem 1.15rem; border-radius: 14px; }
.stat-card--plain::before { display: none; }
.stat-card--plain:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(10,10,10,.08); }
.stat-card--plain .stat-icon { width: 44px; height: 44px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 12px; font-size: 1.1rem; }
.stat-card--plain .stat-content { min-width: 0; flex-grow: 1; }
.stat-card--plain .stat-value { overflow: hidden; color: #1e293b !important; font-size: 1.15rem; line-height: 1.2; white-space: nowrap; text-overflow: ellipsis; text-shadow: none; }
.stat-card--plain .stat-label { margin-top: 2px; color: var(--text-muted) !important; font-size: .7rem; font-weight: 600; letter-spacing: .5px; text-shadow: none; opacity: 1; }

/* EstatÃ­sticas do dashboard do painel (versÃ£o clÃ¡ssica) */
.stat-icon { width: 55px; height: 55px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; color: #fff; font-size: 1.5rem; }
.stat-icon.bg-primary { background: var(--gradient-gold); color: var(--on-primary); }
.stat-icon.bg-success { background: linear-gradient(135deg, #16a34a, #22c55e); }
.stat-icon.bg-warning { background: linear-gradient(135deg, #b45309, #d97706); }
.stat-icon.bg-info { background: var(--gradient-dark); color: var(--primary); }
.stat-info { flex: 1; }
.stat-info h3 { color: var(--text); font-size: 1.8rem; font-weight: 800; line-height: 1; }
.stat-info p { margin-top: 4px; color: var(--text-muted); font-size: .85rem; font-weight: 600; }

/* EstatÃ­sticas mini */
.stat-mini { height: 100%; padding: 1rem; border: 1px solid var(--border-color); border-radius: 14px; background: #fff; text-align: center; transition: transform .2s ease, box-shadow .2s ease; }
.stat-mini:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(10,10,10,.08); }
.stat-mini-icon { margin-bottom: .5rem; font-size: 1.15rem; opacity: .85; }
.stat-mini-value { margin-bottom: .25rem; font-size: 1.5rem; font-weight: 700; line-height: 1; }
.stat-mini-label { color: var(--text-muted); font-size: .7rem; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }
.stat-mini-primary .stat-mini-icon, .stat-mini-primary .stat-mini-value { color: var(--primary-dark); }
.stat-mini-danger .stat-mini-icon, .stat-mini-danger .stat-mini-value { color: #dc3545; }
.stat-card-mini { height: 100%; padding: 1rem; border: 1px solid var(--border-color); border-radius: 14px; background: #fff; text-align: center; transition: transform .2s ease, box-shadow .2s ease; }
.stat-card-mini:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(10,10,10,.08); }
.stat-mini-icon { font-size: 1.15rem; }
.stat-card-danger .stat-mini-icon, .stat-card-danger .stat-mini-value { color: #dc3545; }
.stat-card-primary .stat-mini-icon, .stat-card-primary .stat-mini-value { color: var(--primary-dark); }
.stat-card-success .stat-mini-icon, .stat-card-success .stat-mini-value { color: #16a34a; }
.mini-stat { display: flex; align-items: center; gap: 14px; padding: 18px; border: 1px solid var(--ink-50); border-radius: 14px; background: #fff; box-shadow: var(--shadow-sm); transition: all .3s ease; }
.mini-stat:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.mini-stat-icon { width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12px; font-size: 1.3rem; }
.oportunidade-icon { width: 42px; height: 42px; min-width: 42px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 11px; background: var(--surface-alt); font-size: 1rem; transition: transform .2s ease; }
.report-table tbody tr:hover .oportunidade-icon { transform: scale(1.05); }

/* CartÃµes de estatÃ­stica "stats-card" (relatÃ³rios) */
.stats-card { overflow: hidden; border: none; border-radius: 16px; color: #fff; cursor: default; transition: all .3s ease; }
.stats-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(10,10,10,.15) !important; }
.stats-card .card-body { padding: 1.5rem 1.5rem 1.5rem 2rem; }
.stats-card-primary { background: var(--gradient-dark); }
.stats-card-danger { background: linear-gradient(135deg, #b91c1c, #f87171); }
.stats-card-info { background: var(--gradient-gold); color: var(--black); }
.stats-card-success { background: linear-gradient(135deg, #16a34a, #4ade80); }
.stats-card .stats-icon, .stats-icon { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; border-radius: 14px; background: rgba(255,255,255,.2); backdrop-filter: blur(4px); font-size: 24px; opacity: .9; }
.stats-card .stats-number { margin: 4px 0 2px; font-size: 2.2rem; font-weight: 700; line-height: 1.2; }
.stats-card .stats-label, .stats-label { margin-bottom: 0; color: inherit !important; font-size: .8rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; opacity: .9; }
.stats-value { color: inherit !important; font-size: 2rem; font-weight: 700; line-height: 1.1; }
.stats-footer { color: rgba(255,255,255,.75) !important; font-size: .75rem; }
.stats-card .stats-trend { display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px; border-radius: 20px; background: rgba(255,255,255,.2); font-size: .75rem; }

/* CartÃµes estatÃ­sticos do painel Empresa (gradiente colorido + brilho) */
.emp-stat-card { position: relative; overflow: hidden; height: 100%; padding: 24px; border-radius: 18px; color: #fff; box-shadow: 0 8px 24px rgba(10,10,10,.14); transition: all .35s cubic-bezier(.4, 0, .2, 1); }
.emp-stat-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(10,10,10,.24); }

/* CartÃ£o de estatÃ­stica pÃºblico (home) */
.quick-stats { padding: 40px 6%; border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); background: var(--surface); }
.stats-grid-user { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; max-width: 1300px; margin: 0 auto; }
.stat-box { display: flex; align-items: center; gap: 20px; padding: 20px; border: 1px solid var(--border-color); border-radius: var(--radius); background: var(--bg); }
.stat-icon-wrapper { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; border-radius: 14px; background: var(--surface); color: var(--primary-dark); font-size: 1.5rem; box-shadow: var(--shadow-sm); }
.stat-box-modern { height: 100%; display: flex; align-items: center; gap: 1.25rem; padding: 1.5rem; border: 1px solid var(--border-color); border-radius: 18px; background: #fff; transition: all .3s cubic-bezier(.4, 0, .2, 1); }
.stat-box-modern:hover { transform: translateY(-4px); box-shadow: 0 20px 40px -12px rgba(10,10,10,.12); }
.stat-box-modern .stat-icon-wrapper { width: 60px; height: 60px; flex-shrink: 0; border-radius: 16px; transition: transform .3s ease; }
.stat-box-modern:hover .stat-icon-wrapper { transform: scale(1.08) rotate(-3deg); }
.stat-float-icon { animation: floatIcon 4s ease-in-out infinite; }
.counter-number { display: inline-block; color: var(--black); font-size: 2.25rem; font-weight: 800; line-height: 1; letter-spacing: -.5px; }


/* ================================================================
   15. DASHBOARD â€” ACTIVIDADE, MURAL, COMUNIDADE, ATALHOS
   ================================================================ */
.activity-timeline { position: relative; padding-left: 30px; }
.activity-timeline::before { content: ''; position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; background: var(--border-color); }
.activity-item { position: relative; margin-bottom: 20px; padding-left: 10px; }
.activity-item:last-child { margin-bottom: 0; }
.activity-item::before { content: ''; position: absolute; left: -26px; top: 5px; width: 12px; height: 12px; border: 2px solid #fff; border-radius: 50%; background: var(--primary); box-shadow: 0 0 0 3px rgba(201,162,39,.25); }
.activity-item.activity-success::before { background: #16a34a; box-shadow: 0 0 0 3px rgba(22,163,74,.2); }
.activity-item.activity-warning::before { background: #d97706; box-shadow: 0 0 0 3px rgba(217,119,6,.2); }
.activity-item.activity-danger::before  { background: #dc3545; box-shadow: 0 0 0 3px rgba(220,53,69,.2); }
.activity-item.activity-info::before    { background: var(--ink-600); box-shadow: 0 0 0 3px rgba(82,82,82,.2); }
.activity-time { color: var(--text-muted); font-size: .7rem; white-space: nowrap; }
.activity-content { flex: 1; color: var(--ink-600); font-size: .9rem; }
.activity-content strong { color: var(--primary-dark); }

.mural-card { padding: 15px 20px; border-left: 4px solid var(--primary); border-radius: var(--radius); background: var(--surface-alt); transition: all .3s ease; }
.mural-card:hover { background: #fff; box-shadow: 0 4px 15px rgba(10,10,10,.06); }
.mural-card .mural-text { margin-bottom: 5px; color: var(--text); font-size: .95rem; }
.mural-card .mural-author { color: var(--text-muted); font-size: .8rem; }
.mural-card .mural-author strong { color: var(--primary-dark); }
.mural-item { margin-bottom: .75rem; padding: .9rem 1rem; border: 1px solid var(--ink-50); border-radius: 12px; background: #fff; transition: all .15s ease; }
.mural-item:last-child { margin-bottom: 0; }
.mural-item:hover { border-color: var(--border-color); background: var(--surface-alt); transform: translateY(-1px); box-shadow: 0 4px 14px rgba(10,10,10,.05); }
.mural-avatar { position: relative; width: 42px; height: 42px; min-width: 42px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; border-radius: 50%; font-size: .95rem; font-weight: 700; }
.mural-avatar-img { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
.mural-avatar-initials { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: .95rem; font-weight: 700; }
.avatar-admin { background: #fff1f1; color: #dc3545; }
.avatar-egresso { background: var(--gold-100); color: var(--primary-dark); }
.mural-author-name { color: #1e293b; font-size: .875rem; }
.mural-date { font-size: .7rem; }
.mural-badge { padding: .2rem .55rem; border-radius: 20px; font-size: .65rem; font-weight: 600; }
.mural-text { color: var(--text-muted); font-size: .875rem; line-height: 1.6; word-break: break-word; }

.community-card { height: 100%; padding: 1.25rem; border: 1px solid var(--ink-100); border-radius: 14px; background: linear-gradient(145deg, var(--surface-alt), #fff); transition: transform .2s ease, box-shadow .2s ease; }
.community-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(10,10,10,.08); }
.community-icon { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; font-size: 1.25rem; }
.novidade-item { display: flex; align-items: center; gap: .65rem; padding: .65rem .85rem; border-radius: 10px; background: var(--surface-alt); transition: all .15s ease; }
.novidade-item:hover { background: #fff; transform: translateX(3px); box-shadow: 0 4px 12px rgba(10,10,10,.06); }
.novidade-badge { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 8px; color: #fff; font-size: .75rem; }
.quick-action { height: 100%; display: flex; flex-direction: column; align-items: center; gap: .65rem; padding: 1.25rem .85rem; border-radius: 12px; background: var(--surface-alt); transition: all .2s ease; }
.quick-action:hover { background: #fff; transform: translateY(-4px); box-shadow: 0 8px 20px rgba(10,10,10,.1); }
.quick-action:hover .quick-icon { transform: scale(1.1); }
.quick-action span { color: var(--ink-600); font-size: .8rem; font-weight: 600; text-align: center; }
.quick-icon { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; border-radius: 14px; font-size: 1.35rem; transition: transform .2s ease; }

/* Egressos recentes / oportunidades / eventos (dashboard) */
.egresso-item, .egresso-item-pro, .item-list, .item-list-pro, .evento-item-pro { padding: .75rem 1.25rem; border-bottom: 1px solid rgba(10,10,10,.05); transition: background .15s ease; }
.egresso-item { display: flex; align-items: center; gap: .75rem; }
.egresso-item-pro, .item-list-pro, .evento-item-pro { padding: 1rem 1.5rem; transition: all .25s ease; }
.egresso-item-pro { cursor: pointer; }
.egresso-item:last-child, .egresso-item-pro:last-child, .item-list:last-child, .item-list-pro:last-child, .evento-item-pro:last-child { border-bottom: none; }
.egresso-item:hover, .item-list:hover { background: rgba(10,10,10,.02); }
.egresso-item-pro:hover, .item-list-pro:hover, .evento-item-pro:hover { background: var(--surface-alt); transform: translateX(4px); }
.egresso-avatar-wrapper { position: relative; width: 48px; height: 48px; flex-shrink: 0; }
.egresso-avatar-img, .egresso-avatar-fallback { width: 48px; height: 48px; border: 2px solid #fff; border-radius: 50%; box-shadow: 0 2px 8px rgba(10,10,10,.1); }
.egresso-avatar-img { object-fit: cover; }
.egresso-avatar-fallback { display: flex; align-items: center; justify-content: center; background: var(--black); color: var(--primary); font-size: 1.1rem; font-weight: 700; }
.egresso-status-dot { position: absolute; bottom: 2px; right: 2px; width: 12px; height: 12px; border: 2px solid #fff; border-radius: 50%; }
.egresso-nome, .item-title-pro, .item-list .item-title { overflow: hidden; color: #111827; font-size: .9rem; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.egresso-curso, .item-sub-pro { overflow: hidden; color: #6b7280; font-size: .78rem; white-space: nowrap; text-overflow: ellipsis; }
.item-sub-pro { margin-bottom: 4px; }
.item-title-pro { margin-bottom: 2px; }
.egresso-tempo, .item-date-pro, .item-list .item-date { color: #9ca3af; font-size: .7rem; }
.item-list .item-sub { color: #6b7280; font-size: .8rem; }
.item-icon-pro { width: 44px; height: 44px; min-width: 44px; display: flex; align-items: center; justify-content: center; font-size: 16px; }
.item-meta-pro { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
.evento-date-pro { width: 52px; min-width: 52px; height: 52px; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12px; background: var(--gradient-dark); color: var(--primary); }
.evento-dia { font-size: 1.2rem; font-weight: 700; line-height: 1; }
.evento-mes { font-size: .65rem; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }
.chart-card { overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--ink-50); border-radius: 18px; background: #fff; box-shadow: 0 4px 20px rgba(10,10,10,.06); transition: all .35s cubic-bezier(.4, 0, .2, 1); }
.chart-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(10,10,10,.1); }
.chart-card .card-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid rgba(10,10,10,.05); }
.chart-card .card-header h5 { margin: 0; font-size: 1rem; font-weight: 600; }
.chart-card .card-body { padding: 1.5rem; }
.chart-card-header { display: flex; align-items: center; gap: 14px; padding: 22px 24px 16px; border-bottom: 1px solid var(--ink-50); }
.chart-icon { width: 46px; height: 46px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12px; font-size: 1.15rem; transition: transform .3s ease; }
.chart-card:hover .chart-icon { transform: scale(1.08) rotate(-4deg); }
.chart-icon-primary { background: linear-gradient(135deg, var(--gold-50), var(--gold-100)); color: var(--primary-dark); }
.chart-icon-success { background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #059669; }
.chart-icon-info { background: linear-gradient(135deg, var(--ink-50), var(--ink-100)); color: var(--ink-700); }
.chart-card-title { margin: 0; color: var(--black); font-size: .95rem; font-weight: 700; letter-spacing: -.2px; }
.chart-card-subtitle { display: block; margin-top: 2px; color: var(--text-soft); font-size: .72rem; font-weight: 500; }
.chart-card-body { flex: 1; display: flex; flex-direction: column; padding: 20px 24px 24px; }
.chart-container { position: relative; width: 100%; height: 320px; flex: 1; }
.chart-container-sm { height: 260px; }
.chart-doughnut-container { position: relative; width: 100%; height: 240px; }
.chart-footer { margin-top: 18px; text-align: center; }
.chart-badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border: 1px solid var(--border-color); border-radius: 999px; background: var(--surface-alt); color: var(--ink-600); font-size: .78rem; font-weight: 600; }
.chart-badge-success { background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #059669; border-color: #86efac; }
.chart-wrapper { height: 100%; padding: 1rem; border-radius: 14px; background: var(--surface-alt); }
.chart-title { margin-bottom: .75rem; color: var(--ink-600); font-size: .75rem; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; }

/* GrÃ¡fico de barras CSS puro */
.chart-vertical { height: 320px; display: flex; align-items: flex-end; justify-content: space-around; gap: 12px; padding: 10px 0; }
.bar-item { height: 100%; min-width: 45px; display: flex; flex-direction: column; align-items: center; flex: 1; }
.bar-info { display: flex; flex-direction: column; align-items: center; width: 100%; margin-bottom: 4px; }
.bar-name { color: var(--text); font-size: .7rem; font-weight: 700; }
.bar-number { color: var(--text-muted); font-size: .65rem; font-weight: 600; }
.bar-container { position: relative; flex: 1; width: 32px; min-height: 30px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; border: 1px solid var(--border-color); border-bottom: none; border-radius: 8px 8px 0 0; background: var(--surface-alt); }
.bar-fill { position: relative; width: 100%; min-height: 6px; display: flex; align-items: center; justify-content: center; border-radius: 8px 8px 0 0; background: linear-gradient(180deg, var(--primary-light), var(--primary-dark)); transition: height .8s cubic-bezier(.4,0,.2,1); }
.bar-fill:hover { filter: brightness(1.15); }
.bar-percent { position: absolute; top: 3px; color: var(--on-primary); font-size: .5rem; font-weight: 700; opacity: 0; transition: opacity .3s ease; }
.bar-fill:hover .bar-percent { opacity: 1; }
.bar-label { max-width: 60px; margin-top: 6px; overflow: hidden; color: var(--text-muted); font-size: .55rem; font-weight: 500; text-align: center; white-space: nowrap; text-overflow: ellipsis; }
.bar-container:hover .bar-fill { filter: brightness(1.2); box-shadow: 0 0 20px rgba(201,162,39,.4); }

/* Legendas de grÃ¡ficos (inquÃ©ritos) */
.legend-list { display: flex; flex-direction: column; gap: .5rem; }
.legend-item-pro { display: flex; align-items: center; gap: .6rem; padding: .55rem .75rem; border: 1px solid var(--border-color); border-radius: 10px; background: #fff; transition: all .15s ease; }
.legend-item-pro:hover { background: var(--surface-alt); transform: translateX(3px); border-color: var(--cor, var(--primary)); }
.legend-dot { width: 10px; height: 10px; flex-shrink: 0; border-radius: 50%; }
.legend-label-pro { flex-grow: 1; overflow: hidden; color: var(--ink-600); font-size: .82rem; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.legend-value-pro { flex-shrink: 0; color: var(--black); font-size: .9rem; font-weight: 800; }
.legend-value-pro small { margin-left: 2px; color: var(--text-muted); font-size: .7rem; font-weight: 600; }

/* RelatÃ³rios */
.report-card { display: flex; flex-direction: column; padding: 1.25rem; border: 1px solid var(--border-color); border-radius: 14px; background: #fff; transition: transform .2s ease, box-shadow .2s ease; }
.report-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(10,10,10,.1); }
.report-icon { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; border-radius: 14px; color: #fff; font-size: 1.3rem; box-shadow: 0 4px 12px rgba(10,10,10,.12); }
.report-card .btn { border-radius: 8px; font-weight: 500; }
.report-card .d-grid { margin-top: auto; }
.unit-card { height: 100%; padding: 1rem; border: 1px solid var(--border-color); border-radius: 12px; background: var(--surface-alt); transition: transform .2s ease, box-shadow .2s ease; }
.unit-card:hover { transform: translateY(-2px); background: #fff; box-shadow: 0 8px 20px rgba(10,10,10,.08); }
.egresso-avatar { width: 36px; height: 36px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--black); color: var(--primary); font-size: .85rem; font-weight: 700; object-fit: cover; }
.post-card { border-radius: 14px; transition: box-shadow .2s ease; }
.post-card:hover { box-shadow: 0 8px 24px rgba(10,10,10,.1) !important; }


/* ================================================================
   16. PÃGINAS DE DETALHE (serviÃ§o, oportunidade, evento, entrevista)
   ================================================================ */
.detail-card { border-radius: 20px; }
.detail-header { position: relative; overflow: hidden; padding: 1.75rem 2rem; }
.detail-header::before { content: ''; position: absolute; top: -50%; right: -10%; width: 300px; height: 300px; border-radius: 50%; background: rgba(255,255,255,.08); pointer-events: none; }
.detail-header::after { content: ''; position: absolute; bottom: -80%; right: 20%; width: 200px; height: 200px; border-radius: 50%; background: rgba(255,255,255,.05); pointer-events: none; }
.header-warning   { background: linear-gradient(135deg, #b45309, #d97706); color: #fff; }
.header-info      { background: var(--gradient-dark); color: #fff; }
.header-primary   { background: var(--gradient-gold); color: var(--on-primary); }
.header-success   { background: linear-gradient(135deg, #16a34a, #059669); color: #fff; }
.header-danger    { background: linear-gradient(135deg, #dc2626, #b91c1c); color: #fff; }
.header-secondary { background: linear-gradient(135deg, #64748b, #475569); color: #fff; }
.header-dark      { background: linear-gradient(135deg, #0a0a0a, #262626); color: var(--primary); }
.detail-header-content { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
.service-big-icon { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 18px; background: rgba(255,255,255,.2); backdrop-filter: blur(10px); color: inherit; font-size: 1.65rem; box-shadow: 0 4px 20px rgba(0,0,0,.1); }
.detail-section { margin-bottom: 1.75rem; padding-bottom: 1.75rem; border-bottom: 1px solid var(--ink-100); }
.detail-section:last-child, .detail-section:last-of-type { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
.section-title { display: flex; align-items: center; gap: .5rem; margin-bottom: 1rem; color: var(--text-muted); font-size: .75rem; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; }
.section-title i { color: var(--primary-dark); font-size: .9rem; }
.emp-content .section-title { padding-bottom: 8px; border-bottom: 2px solid var(--gold-100); color: var(--primary-dark); font-size: .85rem; font-weight: 800; letter-spacing: .5px; }

.egresso-card { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; padding: 1.25rem; border: 1px solid var(--border-color); border-radius: 16px; background: linear-gradient(135deg, var(--surface-alt), var(--ink-50)); }
.egresso-avatar-wrap { flex-shrink: 0; }
.egresso-avatar-fallback { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; border: 3px solid #fff; border-radius: 50%; background: var(--black); color: var(--primary); font-size: 1.35rem; font-weight: 700; box-shadow: 0 4px 16px rgba(201,162,39,.25); }
.egresso-card .egresso-avatar { width: 64px; height: 64px; border: 3px solid #fff; border-radius: 50%; object-fit: cover; box-shadow: 0 4px 16px rgba(201,162,39,.25); }
.egresso-info { flex-grow: 1; min-width: 0; }
.egresso-info h5 { color: var(--black); font-size: 1.1rem; }
.egresso-contacts { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .4rem; }
.contact-chip { display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .75rem; border: 1px solid var(--border-color); border-radius: 50px; background: #fff; color: var(--ink-600); font-size: .8rem; transition: all .2s ease; }
.contact-chip:hover { border-color: var(--primary); color: var(--primary-dark); transform: translateY(-1px); box-shadow: 0 4px 10px rgba(201,162,39,.2); }
.contact-chip i { color: var(--primary-dark); font-size: .75rem; }

.description-box { position: relative; padding: 1.5rem 1.5rem 1.5rem 3rem; border: 1px solid var(--border-color); border-left: 4px solid var(--primary); border-radius: 12px; background: #fff; }
.quote-icon { position: absolute; top: 1.25rem; left: 1rem; color: var(--primary); font-size: 1.25rem; opacity: .35; }
.description-text { color: var(--ink-600); font-size: .95rem; line-height: 1.7; }
.info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .85rem; }
.info-tile { height: 100%; display: flex; align-items: center; gap: .9rem; padding: 1rem 1.15rem; border: 1px solid var(--border-color); border-radius: 14px; background: var(--surface-alt); transition: all .2s ease; }
.info-tile:hover { background: #fff; border-color: var(--ink-200); transform: translateY(-2px); box-shadow: 0 6px 16px rgba(10,10,10,.07); }
.info-tile-icon { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid var(--border-color); border-radius: 12px; background: #fff; color: var(--primary-dark); font-size: 1rem; }
.info-tile-icon.tile-info { background: var(--gold-50); color: var(--primary-dark); border-color: var(--gold-200); }
.info-tile-icon.tile-warning { background: #fef3c7; color: #d97706; border-color: #fde68a; }
.info-tile-icon.tile-success { background: #dcfce7; color: #16a34a; border-color: #bbf7d0; }
.info-tile-body { min-width: 0; }
.info-tile-body small { display: block; margin-bottom: .15rem; color: var(--text-muted); font-size: .7rem; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }
.info-tile-body strong { display: block; color: var(--black); font-size: .95rem; font-weight: 700; }
.description-box.simple, .vagas-box { padding: 1.25rem 1.5rem; border: 1px solid var(--border-color); border-radius: 14px; background: var(--surface-alt); }
.actions-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--ink-100); }
.actions-left, .actions-right { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; }
.actions-right { margin-left: auto; }
.badge-attended { display: inline-flex; align-items: center; gap: .5rem; padding: .65rem 1.25rem; border-radius: 50px; background: #dcfce7; color: #15803d; font-size: .875rem; font-weight: 600; }

/* Entrevista */
.entrevista-box, .entrevista-destaque { overflow: hidden; border: 1px solid var(--gold-200); border-radius: 16px; background: var(--gold-50); }
.entrevista-box-header, .entrevista-destaque-header { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 1.5rem; background: var(--gradient-dark); color: var(--primary); }
.entrevista-box-icon, .entrevista-destaque-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 14px; background: rgba(201,162,39,.2); color: var(--primary); font-size: 1.25rem; }
.entrevista-box-body, .entrevista-destaque-body { padding: 1.5rem; }
.entrevista-detail, .entrevista-tile { display: flex; align-items: center; gap: .9rem; padding: .85rem 1rem; border: 1px solid var(--border-color); border-radius: 12px; background: #fff; }
.entrevista-detail-icon, .entrevista-tile-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: var(--gold-100); color: var(--primary-dark); }
.entrevista-detail small, .entrevista-tile small { display: block; color: var(--text-muted); font-size: .7rem; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }
.entrevista-detail strong, .entrevista-tile strong { display: block; color: var(--black); font-size: .95rem; }
.entrevista-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
.entrevista-confirmacao { padding-top: 1rem; border-top: 1px dashed var(--ink-200); }
.confirmacao-box { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; padding: 1rem 1.25rem; border: 1px solid; border-radius: 12px; }
.confirmacao-box.confirmacao-ok { background: #f0fdf4; border-color: #bbf7d0; }
.confirmacao-box.confirmacao-pendente { background: #fffbeb; border-color: #fde68a; }
.confirmacao-icon { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 10px; font-size: 1.15rem; }
.confirmacao-ok .confirmacao-icon { background: #dcfce7; color: #16a34a; }
.confirmacao-pendente .confirmacao-icon { background: #fef3c7; color: #d97706; }
.confirmacao-body { flex-grow: 1; min-width: 0; }
.confirmacao-body strong { display: block; color: var(--black); font-size: .9rem; }
.confirmacao-body small { display: block; color: var(--text-muted); font-size: .78rem; }

/* Modal custom (rejeiÃ§Ã£o / entrevista) */
.custom-modal { position: fixed !important; inset: 0 !important; width: 100vw !important; height: 100vh !important; display: none; align-items: center; justify-content: center; padding: 20px; z-index: 999999 !important; }
.custom-modal.is-open { display: flex !important; }
.custom-modal-backdrop { position: fixed !important; inset: 0 !important; width: 100vw !important; height: 100vh !important; background: rgba(10,10,10,.65); z-index: 1 !important; cursor: default; }
.custom-modal-dialog { position: relative !important; z-index: 2 !important; width: 100%; max-width: 520px; overflow: hidden; border-radius: 16px; background: #fff; box-shadow: 0 25px 60px rgba(0,0,0,.3); animation: modalIn .18s ease-out; }
.custom-modal-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 22px 14px; border-bottom: 1px solid var(--ink-100); background: #fff; }
.custom-modal-title { display: flex; align-items: center; gap: 12px; }
.custom-modal-title h5 { margin: 0; color: var(--black); font-size: 1.1rem; font-weight: 700; }
.custom-modal-icon { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: .85rem; }
.custom-modal-icon.icon-primary { background: var(--gold-100); color: var(--primary-dark); }
.custom-modal-icon.icon-danger { background: #fee2e2; color: #dc2626; }
.custom-modal-close { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border: none; border-radius: 8px; background: transparent; color: var(--text-muted); cursor: pointer; transition: all .15s ease; }
.custom-modal-close:hover { background: var(--ink-50); color: var(--black); }
.custom-modal-body { padding: 20px 22px; }
.custom-modal-description { margin: 0 0 18px; color: var(--text-muted); font-size: .875rem; line-height: 1.5; }
.custom-modal-field { margin-bottom: 16px; }
.custom-modal-field:last-child { margin-bottom: 0; }
.custom-modal-field label { display: block; margin-bottom: 8px; color: var(--ink-700); font-size: .8rem; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; }
.custom-modal-field label span { color: #dc2626; }
.custom-modal-field input[type="text"], .custom-modal-field input[type="datetime-local"], .custom-modal-field textarea {
    position: relative !important; z-index: 3 !important;
    display: block !important; width: 100% !important; margin: 0 !important; padding: 12px 14px !important;
    box-sizing: border-box !important; border: 1px solid var(--ink-200) !important; border-radius: 10px !important;
    background: #fff !important; color: var(--black) !important;
    font-family: inherit !important; font-size: .95rem !important; line-height: 1.5 !important;
    outline: none !important; cursor: text !important; pointer-events: auto !important;
    user-select: text !important; -webkit-user-select: text !important; opacity: 1 !important; visibility: visible !important;
}
.custom-modal-field textarea { min-height: 125px !important; resize: vertical !important; }
.custom-modal-field input::placeholder, .custom-modal-field textarea::placeholder { color: var(--ink-300); opacity: 1; }
.custom-modal-field input:hover, .custom-modal-field textarea:hover { border-color: var(--ink-300) !important; }
.custom-modal-field input:focus, .custom-modal-field textarea:focus { border-color: var(--primary) !important; box-shadow: 0 0 0 3px rgba(201,162,39,.2) !important; }
.custom-modal-field textarea.is-invalid { border-color: #dc2626 !important; box-shadow: 0 0 0 3px rgba(220,38,38,.1) !important; }
.custom-modal-error { display: none; margin-top: 6px; color: #dc2626; font-size: .78rem; }
.custom-modal-error.show { display: block; }
.custom-modal-footer { display: flex; justify-content: flex-end; gap: 10px; padding: 14px 22px 20px; border-top: 1px solid var(--ink-100); background: #fff; }
body.modal-open-custom { overflow: hidden !important; }


/* ================================================================
   17. EVENTOS / OPORTUNIDADES / NOTÃCIAS / INSCRIÃ‡Ã•ES
   ================================================================ */
.evento-card { position: relative; display: flex; flex-direction: column; border-radius: 16px; transition: transform .25s ease, box-shadow .25s ease; }
.evento-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px -12px rgba(10,10,10,.15) !important; }
.evento-header { display: flex; justify-content: space-between; align-items: flex-start; padding: 1rem 1.25rem .5rem; }
.evento-date-badge { width: 60px; height: 60px; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; background: var(--gradient-dark); color: var(--primary); box-shadow: 0 8px 20px -6px rgba(10,10,10,.4); }
.evento-date-day { font-size: 1.4rem; font-weight: 800; line-height: 1; }
.evento-date-month { margin-top: 2px; font-size: .7rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; opacity: .95; }
.evento-badges, .oportunidade-badges { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .35rem; }
.oportunidade-badges { max-width: 60%; }
.evento-badges .badge, .oportunidade-badges .badge { padding: .35rem .65rem; font-size: .68rem; font-weight: 600; }
.evento-title, .oportunidade-title { min-height: 2.8rem; margin-bottom: .5rem; display: -webkit-box; overflow: hidden; color: #1e293b; font-size: 1rem; font-weight: 700; line-height: 1.4; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.evento-description, .oportunidade-description { min-height: 2.6rem; margin-bottom: 1rem; display: -webkit-box; overflow: hidden; color: var(--text-muted); font-size: .85rem; line-height: 1.55; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.evento-info, .oportunidade-info { display: flex; flex-direction: column; gap: .6rem; padding-top: .75rem; border-top: 1px dashed var(--border-color); }
.info-item { display: flex; align-items: center; gap: .75rem; }
.evento-card .info-icon, .oportunidade-card .info-icon { width: 34px; height: 34px; border-radius: 10px; font-size: .8rem; transition: transform .2s ease; }
.oportunidade-card:hover .info-icon { transform: scale(1.05); }
.evento-card .card-footer, .oportunidade-card .card-footer, .survey-card .card-footer { margin-top: auto; }

.oportunidade-card { position: relative; display: flex; flex-direction: column; border-radius: 16px; border-top: 4px solid var(--primary) !important; transition: transform .25s ease, box-shadow .25s ease; }
.oportunidade-card:hover { box-shadow: 0 20px 40px -12px rgba(10,10,10,.15) !important; }
.oportunidade-card.oportunidade-primary { border-top-color: var(--primary) !important; }
.oportunidade-card.oportunidade-info { border-top-color: var(--black) !important; }
.oportunidade-card.oportunidade-success { border-top-color: #16a34a !important; }
.oportunidade-card.oportunidade-warning { border-top-color: #d97706 !important; }
.oportunidade-card.oportunidade-secondary { border-top-color: var(--ink-300) !important; }
.oportunidade-header { display: flex; justify-content: space-between; align-items: flex-start; padding: 1rem 1.25rem .5rem; }
.oportunidade-type-badge { width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; color: #fff; font-size: 1.5rem; transition: transform .3s ease; }
.oportunidade-card:hover .oportunidade-type-badge { transform: scale(1.08) rotate(-3deg); }
.oportunidade-type-badge.type-primary { background: var(--gradient-gold); color: var(--on-primary); box-shadow: 0 8px 20px -6px rgba(201,162,39,.55); }
.oportunidade-type-badge.type-info { background: var(--gradient-dark); color: var(--primary); box-shadow: 0 8px 20px -6px rgba(10,10,10,.4); }
.oportunidade-type-badge.type-success { background: linear-gradient(135deg, #16a34a, #4ade80); box-shadow: 0 8px 20px -6px rgba(22,163,74,.4); }
.oportunidade-type-badge.type-warning { background: linear-gradient(135deg, #b45309, #d97706); box-shadow: 0 8px 20px -6px rgba(217,119,6,.4); }
.oportunidade-type-badge.type-secondary { background: linear-gradient(135deg, #64748b, #94a3b8); box-shadow: 0 8px 20px -6px rgba(100,116,139,.4); }
.form-cancelar-candidatura { display: inline-block; margin: 0; }
.link-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12px; background: linear-gradient(135deg, #16a34a, #4ade80); color: #fff; font-size: 1.15rem; }

/* InscriÃ§Ãµes do egresso */
.inscricao-card { position: relative; display: flex; flex-wrap: wrap; gap: 1.25rem; overflow: hidden; padding: 1.35rem 1.5rem 1.35rem 1.85rem; border: 1px solid var(--border-color); border-radius: 18px; background: #fff; box-shadow: 0 1px 3px rgba(10,10,10,.04); transition: all .25s ease; }
.inscricao-card:hover { transform: translateY(-3px); border-color: var(--ink-200); box-shadow: 0 15px 35px -10px rgba(10,10,10,.14); }
.inscricao-card.is-rejected { opacity: .85; border-color: #fecaca; }
.inscricao-stripe { position: absolute; left: 0; top: 0; bottom: 0; width: 5px; }
.inscricao-card.is-future .inscricao-stripe { background: var(--gradient-gold); }
.inscricao-card.is-past .inscricao-stripe { background: linear-gradient(180deg, #64748b, #94a3b8); }
.inscricao-card.is-rejected .inscricao-stripe { background: linear-gradient(180deg, #dc2626, #ef4444); }
.inscricao-date { position: relative; width: 78px; height: 84px; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; border-radius: 16px; color: #fff; box-shadow: 0 8px 20px -6px rgba(10,10,10,.2); }
.inscricao-date.date-future { background: var(--gradient-dark); color: var(--primary); }
.inscricao-date.date-past { background: linear-gradient(135deg, #64748b, #94a3b8); }
.inscricao-date .day { position: relative; z-index: 1; font-size: 1.9rem; font-weight: 800; line-height: 1; }
.inscricao-date .month { position: relative; z-index: 1; margin-top: 4px; font-size: .7rem; font-weight: 700; letter-spacing: 1px; opacity: .95; }
.inscricao-date .year { position: relative; z-index: 1; margin-top: 1px; font-size: .65rem; font-weight: 600; opacity: .8; }
.inscricao-content { flex: 1; min-width: 0; }
.evento-icon { width: 36px; height: 36px; min-width: 36px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 10px; font-size: .85rem; }
.inscricao-title { color: var(--black); font-size: 1.05rem; font-weight: 700; line-height: 1.3; }
.inscricao-meta { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: .6rem; }
.inscricao-meta span { display: inline-flex; align-items: center; gap: .35rem; color: var(--text-muted); font-size: .8rem; }
.inscricao-meta span i { color: var(--primary-dark); font-size: .75rem; }
.inscricao-card.is-past .inscricao-meta span i { color: var(--ink-500); }
.inscricao-desc { margin: .75rem 0 0; color: var(--text-muted); font-size: .85rem; line-height: 1.55; }
.inscricao-actions { min-width: 160px; display: flex; flex-direction: column; justify-content: center; align-items: stretch; flex-shrink: 0; gap: .5rem; }

/* NotÃ­cias */
.news-card { display: flex; flex-direction: column; border-radius: 16px; transition: transform .2s ease, box-shadow .2s ease; }
.news-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(10,10,10,.12) !important; }
.news-card:hover .news-arrow { transform: translateX(4px); color: var(--primary-dark); }
.news-card:hover .news-title { color: var(--primary-dark); }
.news-image-wrapper { position: relative; height: 190px; overflow: hidden; }
.news-image { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
.news-card:hover .news-image, .news-card:hover .news-image-placeholder { transform: scale(1.05); }
.news-image-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 3rem; transition: transform .4s ease; }
.news-image-placeholder-primary { background: var(--gradient-gold); color: var(--on-primary); }
.news-image-placeholder-info { background: var(--gradient-dark); color: var(--primary); }
.news-image-placeholder-warning { background: linear-gradient(135deg, #b45309, #d97706); }
.news-badges { position: absolute; top: 12px; left: 12px; right: 12px; z-index: 2; display: flex; justify-content: space-between; align-items: flex-start; gap: 6px; pointer-events: none; }
.news-badges .badge { padding: .35rem .65rem; font-size: .7rem; font-weight: 600; box-shadow: 0 2px 8px rgba(0,0,0,.15); }
.news-title { min-height: 2.6rem; margin-bottom: .5rem; display: -webkit-box; overflow: hidden; color: #1e293b; font-size: 1rem; font-weight: 700; line-height: 1.4; transition: color .15s ease; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.news-preview { flex-grow: 1; margin-bottom: .75rem; display: -webkit-box; overflow: hidden; color: var(--text-muted); font-size: .85rem; line-height: 1.55; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
.news-meta { display: flex; flex-direction: column; gap: .4rem; margin-top: auto; padding-top: .75rem; border-top: 1px dashed var(--border-color); }
.news-meta-item { display: flex; align-items: center; gap: .5rem; min-width: 0; color: var(--text-muted); font-size: .78rem; }
.news-meta-item i { width: 14px; flex-shrink: 0; font-size: .75rem; }
.news-arrow { width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--ink-50); color: var(--text-muted); font-size: .75rem; transition: all .2s ease; }

/* NotificaÃ§Ãµes (pÃ¡gina) */
.welcome-card { border-radius: 16px; background: linear-gradient(135deg, #fff 0%, var(--surface-alt) 100%); }
.welcome-icon { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; border-radius: 16px; background: var(--gradient-gold); color: var(--on-primary); font-size: 1.75rem; box-shadow: 0 8px 16px rgba(201,162,39,.35); }
.notifications-card { overflow: hidden; border-radius: 16px; }
.notification-item { position: relative; padding: 1.25rem 1.5rem; background: #fff; transition: background .2s ease; }
.notification-item:hover { background: var(--surface-alt); }
.notification-item.notification-unread, .notification-unread { background: linear-gradient(90deg, var(--primary-soft) 0%, var(--primary-softer) 100%); }
.notification-item.notification-unread::before { content: ''; position: absolute; top: 50%; right: 1.25rem; width: 8px; height: 8px; border-radius: 50%; background: var(--primary); transform: translateY(-50%); box-shadow: 0 0 0 4px rgba(201,162,39,.2); }
.notification-icon { width: 46px; height: 46px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; font-size: 1.05rem; transition: transform .2s ease; }
.notification-item:hover .notification-icon { transform: scale(1.05); }
.notification-title { margin-bottom: .4rem; color: #1e293b; font-size: .95rem; font-weight: 700; line-height: 1.4; }
.notification-message { margin-bottom: 0; color: var(--text-muted); font-size: .85rem; line-height: 1.5; }
.btn-group .btn { margin-right: 4px; padding: .35rem .85rem; border-radius: 8px !important; font-size: .8rem; }
.btn-group .btn:last-child { margin-right: 0; }

/* Conversas (lista) */
.conversation-card { overflow: hidden; border-radius: 16px; }
.conversation-item { padding: 1rem 1.5rem; cursor: pointer; transition: background .15s ease; }
.conversation-item:hover { background: var(--surface-alt); }
.conversation-item:hover .conversation-arrow { transform: translateX(4px); color: var(--primary-dark); }
.conversation-item:hover .conversation-name { color: var(--primary-dark); }
.conversation-unread { border-left: 3px solid var(--primary); background: linear-gradient(90deg, var(--primary-soft) 0%, var(--primary-softer) 100%); }
.conversation-name { transition: color .15s ease; }
.conversation-preview { max-width: 500px; font-size: .875rem; }
.conversation-arrow { transition: transform .2s ease, color .2s ease; }
.conversa-item { padding: 15px; border-bottom: 1px solid var(--border-color); cursor: pointer; transition: background .3s; }
.conversa-item:hover { background: var(--surface-alt); }
.conversa-item:last-child { border-bottom: none; }
.avatar-conversa { width: 50px; height: 50px; border-radius: 50%; object-fit: cover; }

/* Rede / profissionais */
.network-card { overflow: hidden; border-radius: 16px; }
.network-list { max-height: 520px; overflow-y: auto; }
.network-list::-webkit-scrollbar { width: 6px; }
.network-list::-webkit-scrollbar-thumb { background: var(--ink-200); border-radius: 3px; }
.network-list::-webkit-scrollbar-track { background: transparent; }
.network-item { padding: .9rem 1.25rem; border-bottom: 1px solid var(--ink-50); transition: background .15s ease; }
.network-item:last-child { border-bottom: none; }
.network-item:hover { background: var(--surface-alt); }
.result-card-list { overflow: hidden; border-radius: 16px; }
.result-item { padding: 1rem 1.5rem; transition: background .15s ease; }
.result-item:hover { background: var(--surface-alt); }
.hero-search-card, .location-intro-card, .feedback-intro-card, .feedback-detail-card, .survey-intro-card { border-radius: 16px; background: linear-gradient(135deg, #fff 0%, var(--surface-alt) 100%); }
.hero-search-icon, .location-intro-icon, .feedback-intro-icon, .feedback-detail-icon, .survey-intro-icon { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; background: var(--gradient-gold); color: var(--on-primary); font-size: 1.4rem; box-shadow: 0 8px 20px -6px rgba(201,162,39,.55); }

.profissional-card { overflow: hidden; border: 2px solid transparent; transition: all .35s cubic-bezier(.16, 1, .3, 1); }
.profissional-card:hover { transform: translateY(-6px); border-color: rgba(201,162,39,.35); box-shadow: 0 16px 48px rgba(10,10,10,.1) !important; }
.profissional-card.current { border-color: rgba(40,167,69,.3); background: linear-gradient(145deg, #fff, #fafffe); }
.profissional-icon { width: 36px; height: 36px; min-width: 36px; display: flex; align-items: center; justify-content: center; font-size: 14px; transition: all .3s ease; }
.profissional-card:hover .profissional-icon { transform: scale(1.05); }

/* Feedback e rating */
.feedback-list-card { display: flex; flex-direction: column; border-radius: 16px; transition: transform .2s ease, box-shadow .2s ease; }
.feedback-list-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px -8px rgba(10,10,10,.14) !important; }
.feedback-card { border-radius: 16px; transition: transform .2s ease, box-shadow .2s ease; }
.feedback-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(10,10,10,.1) !important; }
.feedback-title { display: -webkit-box; overflow: hidden; font-size: .975rem; line-height: 1.4; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.feedback-preview { display: -webkit-box; overflow: hidden; line-height: 1.6; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
.feedback-message, .feedback-message-box { font-size: .9rem; line-height: 1.65; white-space: pre-wrap; word-break: break-word; }
.feedback-message-box { padding: 1.25rem 1.5rem; border-left: 4px solid var(--primary); border-radius: 10px; background: var(--surface-alt); color: var(--ink-600); font-size: .95rem; line-height: 1.75; }
.rating-mini i { font-size: .7rem; }
.rating-display i { margin-right: .15rem; font-size: 1.15rem; }
.stars-large i { font-size: 1rem; }
.rating-wrapper { display: flex; align-items: center; flex-wrap: wrap; gap: .35rem; padding: .85rem 1rem; border: 1.5px solid var(--border-color); border-radius: 12px; background: var(--surface-alt); }
.rating-item { margin: 0; padding: .25rem; cursor: pointer; transition: transform .15s ease; }
.rating-item:hover { transform: scale(1.15); }
.rating-input { display: none; }
.rating-star { color: var(--ink-200); font-size: 1.5rem; transition: color .15s ease, transform .15s ease; }
.rating-item.filled .rating-star { color: var(--primary); }
.rating-item.active .rating-star { color: var(--primary); filter: drop-shadow(0 2px 4px rgba(201,162,39,.45)); }
.rating-label { color: var(--text-muted); font-size: .85rem; font-weight: 500; }
.rating-label.active { color: var(--primary-dark); font-weight: 600; }
.info-notice-card { border: 1px solid var(--gold-200) !important; border-radius: 16px; background: linear-gradient(135deg, var(--gold-50) 0%, var(--gold-100) 100%); }
.info-notice-icon { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12px; background: var(--primary); color: var(--on-primary); font-size: 1rem; box-shadow: 0 4px 12px -3px rgba(201,162,39,.55); }
.meta-box-icon { margin-bottom: .4rem; }

/* InquÃ©ritos */
.question-card { border-radius: 16px; transition: transform .2s ease, box-shadow .2s ease; }
.question-card:hover { transform: translateY(-2px); box-shadow: 0 12px 28px -8px rgba(10,10,10,.12) !important; }
.question-number { width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12px; background: var(--gradient-dark); color: var(--primary); font-size: 1rem; font-weight: 700; box-shadow: 0 4px 12px -3px rgba(10,10,10,.4); }
.question-number[style*="--cor"] { width: 46px; height: 46px; background: linear-gradient(135deg, var(--cor), var(--cor2)); color: #fff; font-weight: 800; box-shadow: 0 6px 16px -6px var(--cor); }
.question-title { color: #1e293b; font-size: .975rem; font-weight: 700; line-height: 1.45; }
.tipo-badge { display: inline-flex; align-items: center; padding: .4rem .85rem; border-radius: 999px; background: linear-gradient(135deg, var(--cor, var(--primary-dark)), var(--cor2, var(--primary))); color: #fff; font-size: .75rem; font-weight: 700; box-shadow: 0 4px 12px -4px var(--cor, var(--primary)); }
.tipo-desc { margin-top: .65rem; padding: .5rem .85rem; border-left: 3px solid var(--cor, var(--primary)); border-radius: 8px; background: var(--surface-alt); color: var(--text-muted); font-size: .78rem; }
.answer-input { padding: .85rem 1rem; border: 1.5px solid var(--border-color); border-radius: 12px; font-size: .925rem; line-height: 1.6; transition: all .15s ease; }
.answer-input:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(201,162,39,.2); }
.answer-options-row { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
.answer-option input { display: none; }
.answer-option-box { display: flex; align-items: center; justify-content: center; gap: .5rem; padding: 1rem; border: 2px solid var(--border-color); border-radius: 12px; background: #fff; color: var(--ink-600); font-size: .925rem; font-weight: 600; cursor: pointer; transition: all .15s ease; }
.answer-option-box:hover { border-color: var(--ink-200); background: var(--surface-alt); }
.answer-option-yes { color: #16a34a; }
.answer-option input:checked + .answer-option-yes { border-color: #16a34a; background: linear-gradient(135deg, #f0fdf4, #dcfce7); color: #15803d; box-shadow: 0 4px 12px -4px rgba(22,163,74,.3); }
.answer-option-no { color: #dc3545; }
.answer-option input:checked + .answer-option-no { border-color: #dc3545; background: linear-gradient(135deg, #fef2f2, #fee2e2); color: #b91c1c; box-shadow: 0 4px 12px -4px rgba(220,53,69,.3); }
.answer-list { display: flex; flex-direction: column; gap: .5rem; }
.answer-list-item { display: flex; align-items: center; gap: .75rem; margin-bottom: 0; padding: .75rem 1rem; border: 1.5px solid var(--border-color); border-radius: 10px; background: #fff; text-transform: none; letter-spacing: 0; cursor: pointer; transition: all .15s ease; }
.answer-list-item:hover { border-color: var(--ink-200); background: var(--surface-alt); }
.answer-list-item input { display: none; }
.answer-list-marker { position: relative; width: 20px; height: 20px; flex-shrink: 0; border: 2px solid var(--ink-200); border-radius: 50%; background: #fff; transition: all .15s ease; }
.answer-list-marker-square { border-radius: 6px; }
.answer-list-item input:checked ~ .answer-list-marker { border-color: var(--primary-dark); background: var(--primary); box-shadow: 0 0 0 4px rgba(201,162,39,.25); }
.answer-list-item input:checked ~ .answer-list-marker::after { content: ''; position: absolute; top: 50%; left: 50%; width: 8px; height: 8px; border-radius: 50%; background: var(--black); transform: translate(-50%, -50%); }
.answer-list-marker-square::after { border-radius: 2px !important; }
.answer-list-item input:checked ~ .answer-list-text { color: var(--primary-dark); font-weight: 700; }
.answer-list-text { color: var(--ink-600); font-size: .9rem; transition: all .15s ease; }
.answer-scale { display: grid; grid-template-columns: repeat(5, 1fr); gap: .5rem; }
.answer-scale-item input { display: none; }
.answer-scale-box { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border: 2px solid var(--border-color); border-radius: 12px; background: #fff; color: var(--ink-600); font-size: 1.1rem; cursor: pointer; transition: all .15s ease; }
.answer-scale-box:hover { border-color: var(--ink-200); background: var(--surface-alt); transform: translateY(-2px); }
.answer-scale-item input:checked + .answer-scale-box { border-color: var(--primary-dark); background: var(--gradient-gold); color: var(--on-primary); box-shadow: 0 6px 16px -4px rgba(201,162,39,.6); transform: translateY(-2px); }
.sticky-actions { position: sticky; bottom: 1rem; z-index: 10; border-radius: 16px; }
.sticky-actions .btn { padding: .6rem 1.25rem; border-radius: 10px; font-weight: 600; }
.survey-card { display: flex; flex-direction: column; overflow: hidden; border-radius: 16px; transition: transform .2s ease, box-shadow .2s ease; }
.survey-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px -10px rgba(10,10,10,.15) !important; }
.survey-card-ativa:hover { border-color: var(--primary); }
.survey-card-respondida:hover { border-color: #4ade80; }
.survey-card-encerrada { opacity: .85; }
.survey-header { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: 1.25rem 1.5rem .75rem; }
.survey-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; background: var(--gradient-gold); color: var(--on-primary); font-size: 1.2rem; box-shadow: 0 6px 16px -4px rgba(201,162,39,.5); transition: transform .3s ease; }
.survey-card:hover .survey-icon { transform: scale(1.08) rotate(-3deg); }
.survey-card-respondida .survey-icon { background: linear-gradient(135deg, #16a34a, #4ade80); color: #fff; box-shadow: 0 6px 16px -4px rgba(22,163,74,.35); }
.survey-card-encerrada .survey-icon { background: linear-gradient(135deg, #94a3b8, #cbd5e1); color: #fff; box-shadow: 0 6px 16px -4px rgba(148,163,184,.35); }
.survey-badges .badge { padding: .4rem .7rem; font-size: .7rem; font-weight: 600; }
.survey-title { min-height: 2.8rem; margin-bottom: .5rem; display: -webkit-box; overflow: hidden; color: #1e293b; font-size: 1rem; font-weight: 700; line-height: 1.4; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.survey-description { min-height: 2.6rem; margin-bottom: 1rem; display: -webkit-box; overflow: hidden; color: var(--text-muted); font-size: .85rem; line-height: 1.55; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.survey-period { display: flex; flex-direction: column; gap: .5rem; padding-top: .75rem; border-top: 1px dashed var(--border-color); }
.survey-period-item { display: flex; align-items: center; gap: .65rem; }
.survey-period-icon { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 8px; font-size: .75rem; }
.survey-card .btn { padding: .6rem 1rem; border-radius: 10px; font-size: .875rem; font-weight: 600; }
.text-responses { display: grid; gap: .75rem; }
.text-response-item { display: flex; align-items: flex-start; gap: .85rem; padding: 1rem 1.15rem; border: 1px solid var(--border-color); border-radius: 12px; background: var(--surface-alt); transition: transform .15s ease, box-shadow .15s ease; }
.text-response-item:hover { transform: translateX(3px); box-shadow: 0 4px 12px rgba(10,10,10,.06); }
.text-response-icon { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 8px; background: var(--gradient-dark); color: var(--primary); font-size: .75rem; }
.text-response-content { flex-grow: 1; color: var(--ink-600); font-size: .95rem; line-height: 1.6; white-space: pre-wrap; }

/* CartÃµes de serviÃ§o (pedidos) */
.service-card { position: relative; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.25rem 1rem; border: 2px solid var(--border-color); border-radius: 14px; background: #fff; text-align: center; cursor: pointer; transition: all .2s ease; }
.service-card:hover { transform: translateY(-3px); border-color: var(--ink-200); box-shadow: 0 8px 20px rgba(10,10,10,.1); }
.service-card.selected { border-color: var(--primary); background: linear-gradient(135deg, var(--primary-soft) 0%, var(--primary-softer) 100%); box-shadow: 0 8px 20px rgba(201,162,39,.25); }
.service-card.selected::after { content: '\f00c'; position: absolute; top: 8px; right: 8px; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--primary); color: var(--on-primary); font-family: 'Font Awesome 6 Free'; font-size: .7rem; font-weight: 900; }
.service-card .service-icon { width: 56px; height: 56px; margin-bottom: .75rem; border-radius: 14px; font-size: 1.4rem; transition: transform .2s ease; }
.service-card:hover .service-icon { transform: scale(1.08); }
.service-title { margin-bottom: .15rem; color: #1e293b; font-size: .9rem; font-weight: 700; }
.service-desc { color: var(--text-muted); font-size: .75rem; }

/* LocalizaÃ§Ã£o / mapa */
.quick-action-btn { width: 100%; display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem; border: 2px solid var(--border-color); border-radius: 14px; background: #fff; text-align: left; cursor: pointer; transition: all .2s ease; }
.quick-action-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px -6px rgba(10,10,10,.12); }
.quick-action-btn:disabled { opacity: .7; cursor: not-allowed; transform: none; }
.quick-action-primary { border-color: var(--primary); background: linear-gradient(135deg, var(--gold-50) 0%, #fff 100%); }
.quick-action-primary:hover { border-color: var(--primary-dark); background: linear-gradient(135deg, var(--gold-100) 0%, var(--gold-50) 100%); }
.quick-action-secondary { border-color: var(--ink-200); }
.quick-action-secondary:hover { border-color: var(--ink-300); background: var(--surface-alt); }
.quick-action-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12px; color: #fff; font-size: 1.25rem; }
.quick-action-primary .quick-action-icon { background: var(--gradient-gold); color: var(--on-primary); box-shadow: 0 6px 16px -4px rgba(201,162,39,.55); }
.quick-action-secondary .quick-action-icon { background: linear-gradient(135deg, #64748b, #94a3b8); box-shadow: 0 6px 16px -4px rgba(100,116,139,.3); }
.quick-action-text { flex-grow: 1; min-width: 0; }
.quick-action-text strong { display: block; margin-bottom: .15rem; color: #1e293b; font-size: .95rem; }
.quick-action-text small { color: var(--text-muted); font-size: .78rem; }
.location-spinner { display: none; }
.location-spinner.active { display: inline-block; }
.coords-info { display: none; animation: fadeIn .5s ease; }
.coords-info.active { display: block; }
.coords-info-box { padding: .75rem 1rem; border: 1px solid #86efac; border-radius: 10px; background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); }
.coords-info-box code { padding: .15rem .5rem; border-radius: 6px; background: #fff; color: #16a34a; font-weight: 600; }
.map-preview { position: relative; width: 100%; height: 340px; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; border-radius: 0; background: var(--surface-alt); color: var(--ink-300); transition: all .3s ease; }
.map-preview.has-coords { background: #fff; }
.map-preview iframe { display: block; width: 100%; height: 100%; border: none; }
.map-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; text-align: center; }
.map-placeholder-icon { width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; border-radius: 50%; background: var(--ink-100); color: var(--ink-300); font-size: 2rem; }
.map-overlay { position: absolute; bottom: 12px; right: 12px; padding: .4rem .85rem; border-radius: 20px; background: rgba(255,255,255,.95); backdrop-filter: blur(4px); color: var(--ink-600); font-size: .75rem; font-weight: 600; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
.coords-info code { color: var(--primary-dark); }

.mapa-container { position: relative; overflow: hidden; border: 1px solid var(--border-color); border-radius: var(--radius); }
.mapa-container #map, #map { width: 100%; height: 550px; position: relative; overflow: hidden; border-radius: var(--radius); background: var(--black); }
.gm-style .gm-style-iw-c { padding: 12px 14px !important; border-radius: 12px !important; box-shadow: 0 8px 32px rgba(10,10,10,.25) !important; }
.gm-style .gm-style-iw-d { overflow: auto !important; }
.gm-style .gm-style-iw-t::after { background: #fff !important; }
.gm-style .gm-style-iw-c button { display: none !important; }
.legenda-mapa { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; padding: .75rem 1.25rem; border: 1px solid var(--border-color); border-radius: 10px; background: #fff; box-shadow: 0 1px 3px rgba(10,10,10,.08); }
.legenda-item { display: flex; align-items: center; gap: .5rem; color: var(--ink-600); font-size: .85rem; font-weight: 500; }
.legenda-item .ponto, .ponto { width: 14px; height: 14px; display: inline-block; flex-shrink: 0; border: 2px solid #fff; border-radius: 50%; box-shadow: 0 1px 3px rgba(0,0,0,.25); }
.ponto-eu { background: var(--primary); box-shadow: 0 0 0 2px var(--primary-dark); }
.ponto-conexao { background: #22c55e; box-shadow: 0 0 0 2px #22c55e; }
.ponto-outro { background: #6c757d; box-shadow: 0 0 0 2px #6c757d; }
.stat-mapa { padding: 1rem 1.5rem; border: 2px solid var(--border-color); border-left: 4px solid var(--primary); border-radius: var(--radius); background: #fff; text-align: center; transition: all .3s ease; }
.stat-mapa:hover { border-color: var(--primary); transform: translateY(-2px); box-shadow: 0 8px 25px rgba(201,162,39,.2); }
.stat-mapa .numero { color: var(--text); font-size: 2rem; font-weight: 700; line-height: 1.2; }
.stat-mapa .rotulo { color: var(--text-muted); font-size: .75rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; }
.map-fallback { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; color: var(--ink-300); text-align: center; }
.map-fallback i { margin-bottom: 1rem; color: var(--primary); font-size: 3rem; }
.map-fallback h5 { margin-bottom: .5rem; color: #e8eaf0; }
.map-fallback p { max-width: 400px; color: var(--ink-300); }
.location-card { display: flex; flex-direction: column; overflow: hidden; border-radius: 16px; transition: transform .2s ease, box-shadow .2s ease; }
.location-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px -8px rgba(10,10,10,.14) !important; }
.location-current { border-top: 3px solid #16a34a; }
.location-past { border-top: 3px solid var(--ink-200); }
.location-marker { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12px; color: #fff; font-size: 1rem; transition: transform .2s ease; }
.marker-current { background: linear-gradient(135deg, #16a34a, #4ade80); box-shadow: 0 6px 16px -4px rgba(22,163,74,.4); }
.marker-past { background: linear-gradient(135deg, #94a3b8, #cbd5e1); box-shadow: 0 6px 16px -4px rgba(148,163,184,.4); }
.location-card:hover .location-marker { transform: scale(1.08) rotate(-3deg); }
.location-info-row { display: flex; align-items: center; gap: .85rem; padding: .6rem 0; border-bottom: 1px dashed var(--border-color); }
.location-info-row:last-child { border-bottom: none; }
.location-info-icon { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 10px; font-size: .85rem; }
.location-info-content { min-width: 0; flex-grow: 1; }
.search-result-box { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem; border: 1px solid #86efac; border-radius: 12px; background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%); }
.search-result-avatar { width: 48px; height: 48px; flex-shrink: 0; }
.search-result-avatar img { width: 48px; height: 48px; border: 2px solid #fff; border-radius: 50%; object-fit: cover; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
.search-result-info { flex-grow: 1; min-width: 0; }
.search-result-icon { flex-shrink: 0; color: #16a34a; font-size: 1.5rem; }
.filter-badge { display: inline-flex; align-items: center; gap: .25rem; padding: .35rem .75rem; border: 1px solid var(--gold-200); border-radius: 50px; background: var(--gold-50); color: var(--primary-dark); font-size: .75rem; font-weight: 600; }
.filter-badge-close { margin-left: .25rem; color: #dc3545; }
.filter-badge-close:hover { color: #a71d2a; }
#map .map-fallback { background: var(--surface-alt); color: var(--text); }

/* RelatÃ³rios â€” mobile */
@media (max-width: 768px) {
    .report-table thead { display: none; }
    .report-table tbody tr { display: block; border-bottom: 1px solid var(--border-color); }
    .report-table tbody td { display: block; padding: .5rem 1rem !important; border: none; }
    .report-table tbody td:first-child { padding-top: 1rem !important; }
    .report-table tbody td:last-child { padding-bottom: 1rem !important; }
}


/* ================================================================
   18. MENSAGENS / CHAT / CHAMADAS
   ================================================================ */
.message { max-width: 75%; padding: 10px 16px; border-radius: 16px; word-wrap: break-word; animation: fadeIn .3s ease; }
.message.sent, .message-sent { max-width: 70%; padding: 10px 15px; border-radius: 18px 18px 0 18px; background: var(--primary); color: var(--on-primary); align-self: flex-end; }
.message.received, .message-received { max-width: 70%; padding: 10px 15px; border-radius: 18px 18px 18px 0; background: var(--surface-alt); color: var(--text); align-self: flex-start; }
.message-time { margin-top: 4px; font-size: .6rem; opacity: .7; }
.chat-container { max-height: 450px; overflow-y: auto; }
#chat-messages::-webkit-scrollbar { width: 6px; }
#chat-messages::-webkit-scrollbar-track { background: var(--ink-50); border-radius: 10px; }
#chat-messages::-webkit-scrollbar-thumb { background: var(--ink-200); border-radius: 10px; }
#chat-messages::-webkit-scrollbar-thumb:hover { background: var(--ink-300); }
.post-avatar { width: 45px; height: 45px; border-radius: 50%; object-fit: cover; }
.post-avatar-placeholder { width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--black); color: var(--primary); font-size: 1.2rem; font-weight: bold; }
.post-content { white-space: pre-wrap; }
.comment-avatar { width: 30px; height: 30px; border-radius: 50%; }
.comment-avatar-placeholder { width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--black); color: var(--primary); font-size: .8rem; font-weight: bold; }
.comment-item { padding: 10px 0; border-bottom: 1px solid var(--border-color); }
.comment-item:last-child { border-bottom: none; }

.chat-header-card, .chat-card { border-radius: 16px; }
.chat-body { height: 520px; padding: 1.1rem 1rem; overflow-y: auto; background: var(--surface-alt); scroll-behavior: smooth; }
.chat-body::-webkit-scrollbar { width: 6px; }
.chat-body::-webkit-scrollbar-thumb { background: var(--ink-200); border-radius: 3px; }
.chat-body::-webkit-scrollbar-track { background: transparent; }
.date-separator { position: relative; margin: .9rem 0; text-align: center; }
.date-separator::before { content: ''; position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: var(--border-color); z-index: 0; }
.date-separator span { position: relative; z-index: 1; padding: .2rem .6rem; background: var(--surface-alt); color: var(--text-muted); font-size: .7rem; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }
.chat-row { width: 100%; display: flex; margin-bottom: .35rem; }
.chat-row-sent { justify-content: flex-end; }
.chat-row-received { justify-content: flex-start; }
.chat-bubble { position: relative; display: inline-block; width: fit-content; max-width: 55%; padding: .45rem .75rem; border-radius: 14px; font-size: .85rem; line-height: 1.35; word-wrap: break-word; word-break: break-word; box-shadow: 0 1px 2px rgba(10,10,10,.05); }
.chat-bubble-received { border: 1px solid var(--border-color); border-bottom-left-radius: 4px; background: #fff; color: var(--text); }
.chat-bubble-sent { border-bottom-right-radius: 4px; background: var(--gradient-dark); color: #fff; }
.chat-content { white-space: pre-wrap; overflow-wrap: anywhere; }
.chat-meta { display: flex; justify-content: space-between; align-items: center; gap: .35rem; margin-top: .25rem; }
.chat-time { font-size: .65rem; white-space: nowrap; opacity: .75; }
.chat-edited { font-style: italic; opacity: .85; }
.chat-audio-duration { opacity: .8; }
.chat-actions { display: flex; gap: .25rem; opacity: 0; transition: opacity .2s ease; }
.chat-bubble:hover .chat-actions { opacity: 1; }
.chat-action-btn { width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; padding: 0; border: none; border-radius: 5px; font-size: .62rem; cursor: pointer; transition: background .15s ease; }
.chat-bubble-sent .chat-action-btn { background: rgba(255,255,255,.15); color: #fff; }
.chat-bubble-sent .chat-action-btn:hover { background: rgba(201,162,39,.4); }
.chat-bubble-received .chat-action-btn { background: rgba(0,0,0,.05); color: var(--ink-600); }
.chat-bubble-received .chat-action-btn:hover { background: rgba(0,0,0,.1); }
.chat-action-danger:hover { background: rgba(220,53,69,.9) !important; color: #fff !important; }
.chat-edit-container textarea { min-width: 200px; border-radius: 8px; background: #fff; font-size: .8rem; }
.chat-input { padding: .55rem 1rem; border: 1px solid var(--border-color); border-radius: 24px; font-size: .85rem; }
.chat-input:focus { border-color: var(--primary); box-shadow: 0 0 .2rem .2rem rgba(201,162,39,.2); }
.chat-send-btn { width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 0; border-radius: 50%; }
.chat-mic-btn { width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 0; transition: all .2s ease; }
.chat-mic-btn.recording { border-color: #dc2626; background: #dc2626; color: #fff; animation: pulse-recording 1.2s infinite; }
.audio-recording-ui { display: flex; align-items: center; gap: .6rem; }
.recording-dot { width: 9px; height: 9px; border-radius: 50%; background: #dc2626; animation: blink 1s infinite; }
.recording-time { min-width: 42px; color: #dc2626; font-size: .85rem; font-weight: 600; font-variant-numeric: tabular-nums; }
.recording-wave { height: 26px; display: flex; align-items: center; gap: 3px; }
.recording-wave span { flex: 1; border-radius: 2px; background: #dc2626; animation: wave 1s ease-in-out infinite; }
.recording-wave span:nth-child(1)  { animation-delay: 0s;  height: 40%; }
.recording-wave span:nth-child(2)  { animation-delay: .1s; height: 70%; }
.recording-wave span:nth-child(3)  { animation-delay: .2s; height: 100%; }
.recording-wave span:nth-child(4)  { animation-delay: .3s; height: 60%; }
.recording-wave span:nth-child(5)  { animation-delay: .4s; height: 80%; }
.recording-wave span:nth-child(6)  { animation-delay: .5s; height: 50%; }
.recording-wave span:nth-child(7)  { animation-delay: .6s; height: 90%; }
.recording-wave span:nth-child(8)  { animation-delay: .7s; height: 70%; }
.recording-wave span:nth-child(9)  { animation-delay: .8s; height: 40%; }
.recording-wave span:nth-child(10) { animation-delay: .9s; height: 80%; }
.chat-audio { min-width: 180px; max-width: 100%; display: flex; align-items: center; gap: .5rem; }
.chat-audio audio { width: 100%; height: 32px; outline: none; }
.chat-bubble-sent .chat-audio audio { filter: brightness(1.05); }
.chat-ficheiro { min-width: 200px; max-width: 100%; display: flex; align-items: center; gap: .6rem; padding: .4rem .7rem; border-radius: 10px; color: inherit; transition: all .2s ease; }
.chat-ficheiro:hover { transform: translateY(-1px); color: inherit; box-shadow: 0 4px 12px rgba(0,0,0,.15); }
.chat-bubble-sent .chat-ficheiro { background: rgba(255,255,255,.15); color: #fff; }
.chat-bubble-sent .chat-ficheiro:hover { background: rgba(201,162,39,.35); }
.chat-bubble-received .chat-ficheiro { background: var(--ink-50); color: var(--text); }
.chat-bubble-received .chat-ficheiro:hover { background: var(--ink-100); }
.chat-ficheiro-icone { flex-shrink: 0; font-size: 1.3rem; opacity: .9; }
.chat-ficheiro-info { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: .1rem; }
.chat-ficheiro-nome { max-width: 160px; overflow: hidden; font-size: .78rem; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.chat-ficheiro-tamanho { font-size: .65rem; opacity: .75; }
.chat-ficheiro-download { flex-shrink: 0; font-size: .9rem; opacity: .7; transition: opacity .2s ease; }
.chat-ficheiro:hover .chat-ficheiro-download { opacity: 1; }
.chat-chamada { display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .6rem; border-radius: 8px; font-size: .78rem; font-weight: 500; line-height: 1.2; }
.chat-bubble-sent .chat-chamada { background: rgba(255,255,255,.18); color: #fff; }
.chat-bubble-received .chat-chamada { background: var(--gold-100); color: var(--primary-dark); }
.chat-chamada i { font-size: .9rem; }

/* Chamada recebida */
.call-incoming-header { position: relative; height: 130px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--gradient-dark); }
.call-avatar { position: relative; z-index: 2; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #fff; color: var(--primary-dark); font-size: 2rem; box-shadow: 0 8px 24px rgba(0,0,0,.25); }
.call-ripple { position: absolute; width: 80px; height: 80px; border-radius: 50%; background: rgba(201,162,39,.35); animation: callRipple 1.8s infinite ease-out; }
.call-ripple-2 { animation-delay: .9s; }

/* Toasts JS */
.app-toast { position: fixed; top: 24px; right: 24px; z-index: 99999; padding: 12px 22px; border-radius: 10px; color: #fff; font-size: .9rem; font-weight: 500; box-shadow: 0 8px 24px rgba(0,0,0,.15); animation: slideInRight .3s ease; }

/* Feed (publicaÃ§Ãµes) */
.card[data-publicacao-id] { border-radius: 16px; transition: box-shadow .2s ease; }
.card[data-publicacao-id]:hover { box-shadow: 0 8px 24px rgba(10,10,10,.1) !important; }
.btn-curtir i { transition: transform .15s ease; }
.btn-curtir:hover i { transform: scale(1.1); }

/* Timeline */
.timeline-item { position: relative; }
.timeline-item:not(:last-child)::before { content: ''; position: absolute; left: 17px; top: 36px; bottom: -12px; width: 2px; background: linear-gradient(180deg, var(--border-color), var(--ink-50)); }
.timeline-icon { transition: all .3s ease; }
.timeline-icon:hover { transform: scale(1.1); }

/* Mensagem de admin (detalhe) */
.message-header { position: relative; overflow: hidden; }
.message-header-pattern { position: absolute; top: -50%; right: -20%; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, rgba(201,162,39,.2) 0%, transparent 70%); pointer-events: none; }
.message-header-pattern::before { content: ''; position: absolute; bottom: -100px; left: -100px; width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,.1) 0%, transparent 70%); }
.avatar-glow { box-shadow: 0 0 0 4px rgba(255,255,255,.15), 0 8px 24px rgba(0,0,0,.15); transition: all .3s ease; }
.avatar-glow:hover { transform: scale(1.05); box-shadow: 0 0 0 6px rgba(201,162,39,.3), 0 12px 32px rgba(0,0,0,.2); }
.status-badge-pulse, .message-header .status-badge { box-shadow: 0 4px 12px rgba(0,0,0,.1); animation: pulse-soft 3s ease-in-out infinite; }
.message-card:hover { transform: translateY(-2px); }
.info-card.hoverable { transition: all .2s ease; border: 1px solid transparent; }
.info-card.hoverable:hover { background: var(--surface-alt) !important; border-color: var(--border-color); transform: translateY(-2px); }
.subject-title { position: relative; padding-left: 16px; }
.subject-title::before { content: ''; position: absolute; left: 0; top: 50%; width: 4px; height: 70%; border-radius: 4px; background: var(--gradient-gold); transform: translateY(-50%); }
.message-content { transition: all .3s ease; }
.message-content:hover { background: var(--gold-50) !important; border-left-color: var(--primary) !important; }
.reply-textarea { border: 2px solid var(--border-color); transition: all .3s ease; }
.reply-textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(201,162,39,.15); }
.response-card { animation: slideIn .5s ease; }
.success-icon-glow { box-shadow: 0 0 0 4px rgba(22,163,74,.15); animation: pulse-icon 2s ease-in-out infinite; }
.sender-avatar { box-shadow: 0 8px 24px rgba(201,162,39,.25); transition: all .3s ease; }
.sender-avatar:hover { transform: scale(1.05); box-shadow: 0 12px 32px rgba(201,162,39,.4); }


/* ================================================================
   19. SITE PÃšBLICO
   ================================================================ */

/* ---------- 19.1 Navbar ---------- */

/* ============================================================
   19.1 NAVBAR — FUNDO PRETO (Paleta UniLuanda)
============================================================ */
.user-navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: 16px 6%;
    background: var(--black);
    border-bottom: 2px solid var(--primary);
    transition: all .3s ease;
}

.user-navbar.scrolled {
    padding: 12px 6%;
    background: var(--black);
    box-shadow: 0 4px 20px rgba(10, 10, 10, .4);
}

.nav-container {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
}

/* ---------- LOGO ---------- */
.brand-logo {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    flex-shrink: 0;
    color: var(--surface);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -.5px;
    text-decoration: none;
}

.brand-logo .logo-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--primary);
    color: var(--black);
    font-size: 1.2rem;
    box-shadow: 0 4px 12px -2px rgba(201, 162, 39, .5);
}

.brand-logo span {
    color: var(--primary);
    font-weight: 700;
}

.brand-logo-img {
    display: block;
    height: 60px;
    width: auto;
    object-fit: contain;
}

.brand-logo-text {
    color: var(--surface);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
}

/* ---------- LINKS ---------- */
.nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
}

.nav-links a {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    color: rgba(255, 255, 255, .78);
    font-size: .95rem;
    font-weight: 500;
    text-decoration: none;
    transition: color .2s ease;
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--primary);
}

/* ---------- BOTÕES ---------- */
.nav-actions {
    display: flex;
    align-items: center;
    gap: .75rem;
    flex-shrink: 0;
}

/* Botão "Entrar" (outline dourado) */
.btn-nav-outline {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .6rem 1.25rem;
    border: 1.5px solid var(--primary);
    border-radius: 10px;
    background: transparent;
    color: var(--primary);
    font-size: .9rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: all .2s ease;
}

.btn-nav-outline:hover {
    background: var(--primary);
    color: var(--black);
}

/* Botão "Cadastrar-se" (sólido dourado) */
.btn-nav-solid {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .6rem 1.25rem;
    border: none;
    border-radius: 10px;
    background: var(--gradient-gold);
    color: var(--black);
    font-size: .9rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 4px 12px -2px rgba(201, 162, 39, .5);
    transition: all .2s ease;
}

.btn-nav-solid:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -4px rgba(201, 162, 39, .6);
    color: var(--black);
}

/* ---------- MOBILE TOGGLE ---------- */
.mobile-toggle {
    display: none;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(255, 255, 255, .1);
    color: var(--surface);
    font-size: 1.2rem;
    cursor: pointer;
    transition: all .2s ease;
}

.mobile-toggle:hover {
    background: rgba(201, 162, 39, .2);
    color: var(--primary);
}
/* ---------- 19.2 Hero ---------- */
.hero-section { padding: 160px 6% 90px; background: radial-gradient(circle at 10% 20%, rgba(201,162,39,.1) 0%, rgba(255,255,255,0) 80%), radial-gradient(circle at 90% 80%, rgba(10,10,10,.05) 0%, rgba(255,255,255,0) 80%); }
.hero-gradient-bg { position: relative; overflow: hidden; background: radial-gradient(circle at 20% 30%, rgba(201,162,39,.12) 0%, transparent 60%), radial-gradient(circle at 80% 70%, rgba(10,10,10,.05) 0%, transparent 60%); }
.hero-gradient-bg::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle at 50% 50%, rgba(201,162,39,.05) 0%, transparent 50%); animation: rotateBg 30s linear infinite; pointer-events: none; }
.hero-wrapper { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 60px; }
.hero-text h1 { margin-bottom: 20px; font-size: 3.4rem; font-weight: 800; line-height: 1.15; letter-spacing: -.5px; }
.hero-text h1 span { background: var(--gradient-gold); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.hero-text p { max-width: 540px; margin-bottom: 36px; color: var(--text-muted); font-size: 1.15rem; }
.hero-search-box { max-width: 520px; display: flex; align-items: center; gap: 10px; padding: 8px; border: 1px solid var(--border-color); border-radius: 50px; background: var(--surface); box-shadow: var(--shadow-md); }
.hero-search-box i { margin-left: 18px; color: var(--primary-dark); font-size: 1.2rem; }
.hero-search-box input { flex: 1; border: none; outline: none; box-shadow: none; color: var(--text); font-family: inherit; font-size: .95rem; }
.hero-search-box button { padding: 12px 28px; border: none; border-radius: 40px; background: var(--primary); color: var(--on-primary); font-weight: 700; cursor: pointer; transition: background .3s; }
.hero-search-box button:hover { background: var(--primary-dark); color: #fff; }
.hero-visual { position: relative; }
.visual-card-main { position: relative; z-index: 2; padding: 24px; border: 1px solid var(--border-color); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-lg); }
.visual-card-main img { width: 100%; height: 380px; border-radius: 14px; object-fit: cover; }
.floating-glass-card { position: absolute; bottom: -25px; left: -30px; z-index: 3; display: flex; align-items: center; gap: 14px; padding: 16px 22px; border: 1px solid var(--border-color); border-radius: 16px; background: rgba(255,255,255,.95); backdrop-filter: blur(10px); box-shadow: var(--shadow-md); animation: floatCard 5s ease-in-out infinite; }
.floating-glass-card .icon-circle, .icon-circle { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; background: var(--primary-soft); color: var(--primary-dark); font-size: 1.3rem; }
.floating-glass-card h5 { font-size: 1.1rem; font-weight: 700; }
.floating-glass-card p { color: var(--text-muted); font-size: .8rem; }
.hero-float { position: relative; animation: float 4s ease-in-out infinite; }
.hero-float-soft { position: relative; animation: float-soft 5s ease-in-out infinite; }
.hero-float-side { position: relative; animation: float-side 4s ease-in-out infinite; }
.hero-float-rotate { position: relative; animation: float-rotate 5s ease-in-out infinite; }

/* BotÃ£o "Explorar egressos" */
.explorar-wrapper { margin-top: 2rem; margin-bottom: 1.5rem; }
.btn-explorar { position: relative; width: 100%; max-width: 420px; display: inline-flex; align-items: center; gap: 1rem; overflow: hidden; padding: 1rem 1.25rem; border: none; border-radius: 16px; background: var(--gradient-dark); color: #fff; text-align: left; cursor: pointer; box-shadow: 0 12px 28px -8px rgba(10,10,10,.5), 0 4px 12px -4px rgba(201,162,39,.3); transition: all .3s cubic-bezier(.4, 0, .2, 1); }
.btn-explorar::before { content: ''; position: absolute; top: -50%; right: -30%; width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(circle, rgba(201,162,39,.35) 0%, transparent 70%); pointer-events: none; }
.btn-explorar:hover { transform: translateY(-3px); color: #fff; box-shadow: 0 20px 40px -10px rgba(10,10,10,.6), 0 6px 16px -4px rgba(201,162,39,.45); }
.btn-explorar:active { transform: translateY(-1px); }
.btn-explorar-icon { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; background: var(--primary); color: var(--on-primary); font-size: 1.35rem; transition: transform .3s ease; }
.btn-explorar:hover .btn-explorar-icon { transform: scale(1.08) rotate(-5deg); }
.btn-explorar-text { min-width: 0; flex-grow: 1; display: flex; flex-direction: column; gap: .15rem; }
.btn-explorar-title { color: #fff; font-size: 1.05rem; font-weight: 700; letter-spacing: -.2px; }
.btn-explorar-subtitle { display: flex; align-items: center; color: rgba(255,255,255,.8); font-size: .78rem; font-weight: 500; }
.btn-explorar-arrow { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 10px; background: rgba(201,162,39,.25); color: var(--primary); font-size: .9rem; transition: all .3s ease; }
.btn-explorar:hover .btn-explorar-arrow { background: var(--primary); color: var(--on-primary); transform: translateX(4px); }

/* ---------- 19.3 Recursos e cartÃµes ---------- */
.user-features { padding: 90px 6%; }
.section-head { max-width: 650px; margin: 0 auto 55px; text-align: center; }
.section-head h2 { margin-bottom: 12px; font-size: 2.3rem; font-weight: 800; }
.section-head p { color: var(--text-muted); font-size: 1.05rem; }
.cards-interactive-grid { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 30px; }
.user-card { display: flex; flex-direction: column; padding: 36px 30px; border: 1px solid var(--border-color); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-sm); transition: all .3s ease; }
.user-card:hover { transform: translateY(-8px); border-color: rgba(201,162,39,.5); box-shadow: var(--shadow-md); }
.card-icon-box { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; margin-bottom: 24px; border-radius: 16px; background: var(--black); color: var(--primary); font-size: 1.8rem; }
.user-card h3 { margin-bottom: 12px; font-size: 1.35rem; font-weight: 700; }
.user-card p { flex: 1; margin-bottom: 24px; color: var(--text-muted); font-size: .95rem; }
.card-link, .user-card .card-link { display: inline-flex; align-items: center; gap: .35rem; color: var(--primary-dark); font-size: .95rem; font-weight: 700; transition: gap .2s ease; }
.card-link:hover { gap: .6rem; }
.user-card:hover .card-link { gap: 12px; }

/* ---------- 19.4 Egressos em destaque ---------- */
.featured-alumni { padding: 90px 6%; background: var(--surface); }
.alumni-grid { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 25px; }
.alumni-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
.alumni-profile-card { padding: 24px; border: 1px solid var(--border-color); border-radius: var(--radius); background: var(--bg); text-align: center; transition: all .3s ease; }
.alumni-profile-card:hover { background: var(--surface); border-color: rgba(201,162,39,.4); box-shadow: var(--shadow-md); }
.profile-avatar-container { position: relative; width: 84px; height: 84px; margin: 0 auto 16px; }
.profile-avatar-container img { width: 100%; height: 100%; border: 3px solid #fff; border-radius: 50%; object-fit: cover; box-shadow: var(--shadow-sm); }
.verified-badge { position: absolute; bottom: 2px; right: 2px; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; border: 2px solid #fff; border-radius: 50%; background: var(--primary); color: var(--on-primary); font-size: .7rem; }
.alumni-profile-card h4 { margin-bottom: 4px; font-size: 1.1rem; font-weight: 700; }
.alumni-profile-card .role { margin-bottom: 12px; color: var(--primary-dark); font-size: .85rem; font-weight: 600; }
.alumni-profile-card .meta { display: flex; align-items: center; justify-content: center; gap: 12px; padding-top: 12px; border-top: 1px solid var(--border-color); color: var(--text-muted); font-size: .8rem; }
.alumni-card-modern { position: relative; overflow: hidden; padding: 2rem 1.5rem; border: 1px solid var(--border-color); border-radius: 20px; background: #fff; text-align: center; transition: all .3s cubic-bezier(.16, 1, .3, 1); }
.alumni-card-modern::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--gradient-gold); transform: scaleX(0); transition: transform .4s ease; }
.alumni-card-modern:hover { transform: translateY(-8px); border-color: transparent; box-shadow: 0 24px 48px -16px rgba(201,162,39,.35); }
.alumni-card-modern:hover::before { transform: scaleX(1); }
.alumni-avatar-modern { position: relative; width: 100px; height: 100px; margin: 0 auto 1rem; border: 4px solid #fff; border-radius: 50%; object-fit: cover; box-shadow: 0 8px 24px -8px rgba(10,10,10,.2); }
.alumni-avatar-fallback { width: 100px; height: 100px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; border: 4px solid #fff; border-radius: 50%; background: var(--black); color: var(--primary); font-size: 2rem; font-weight: 700; box-shadow: 0 8px 24px -8px rgba(10,10,10,.5); }
.alumni-name-modern { margin-bottom: .35rem; color: #1e293b; font-size: 1.1rem; font-weight: 700; line-height: 1.3; }
.alumni-role-modern { margin-bottom: .85rem; color: var(--primary-dark); font-size: .85rem; font-weight: 600; }
.alumni-info-modern { display: flex; flex-direction: column; gap: .35rem; margin-bottom: 1rem; padding-top: 1rem; border-top: 1px dashed var(--border-color); }
.alumni-info-modern span { display: flex; align-items: center; justify-content: center; gap: .35rem; color: var(--text-muted); font-size: .78rem; }
.alumni-btn-modern { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .65rem 1rem; border: none; border-radius: 10px; background: var(--black); color: var(--primary); font-size: .85rem; font-weight: 600; cursor: pointer; transition: all .25s ease; }
.alumni-btn-modern:hover { transform: translateY(-2px); background: var(--ink-700); color: var(--primary-light); box-shadow: 0 8px 20px -4px rgba(10,10,10,.5); text-decoration: none; }

/* ---------- 19.5 Vagas e eventos ---------- */
.jobs-events-section { padding: 90px 6%; }
.jobs-grid { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 30px; }
.job-card { display: flex; align-items: flex-start; gap: 20px; padding: 24px; border: 1px solid var(--border-color); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-sm); transition: all .3s ease; }
.job-card:hover { border-color: var(--primary); box-shadow: var(--shadow-md); }
.company-logo { width: 54px; height: 54px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 12px; background: var(--primary-soft); color: var(--primary-dark); font-size: 1.4rem; }
.job-details { flex: 1; }
.job-details h4 { margin-bottom: 4px; font-size: 1.1rem; font-weight: 700; }
.job-details .company-name { margin-bottom: 12px; color: var(--text-muted); font-size: .85rem; font-weight: 600; }
.job-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
.tag { padding: 4px 10px; border-radius: 20px; background: var(--bg); color: var(--black); font-size: .75rem; font-weight: 600; }
.job-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--border-color); color: var(--text-muted); font-size: .8rem; }
.job-footer a { color: var(--primary-dark); font-weight: 700; }
.events-section { width: 100%; max-width: 1200px; margin: 4rem auto; padding: 0 1.5rem; }
.events-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
.event-card { display: flex; align-items: center; gap: 1.5rem; padding: 1.25rem; border: 1px solid var(--border-color); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-sm); transition: transform .2s ease, box-shadow .2s ease; }
.event-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
.event-date-badge { min-width: 65px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: .75rem 1rem; border-radius: 10px; background: var(--black); color: var(--primary); }
.event-date-badge .day { font-size: 1.5rem; font-weight: 800; line-height: 1; }
.event-date-badge .month { margin-top: 2px; font-size: .75rem; font-weight: 600; text-transform: uppercase; }
.event-content { flex: 1; }
.event-type-tag { margin-bottom: 4px; color: var(--primary-dark); font-size: .75rem; font-weight: 700; text-transform: uppercase; }
.event-content h3 { margin-bottom: 6px; color: var(--text); font-size: 1rem; }
.event-location { margin-bottom: 10px; color: var(--text-muted); font-size: .85rem; }

/* Layout em duas colunas */
.home-split-container { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 30px; padding: 20px; }
.home-split-container .alumni-grid { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; }
.home-split-container .jobs-grid { display: flex; flex-direction: column; gap: 15px; }

/* SugestÃµes de conexÃ£o */
.contact-card { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 15px 20px; border-bottom: 1px solid var(--border-color); background: var(--surface); transition: background-color .2s ease; }
.contact-card:last-child { border-bottom: none; }
.contact-card:hover { background-color: var(--surface-alt); }
.contact-card > .d-flex { min-width: 0; display: flex; align-items: center; gap: 15px; }
.contact-card .avatar { width: 60px !important; height: 60px !important; min-width: 60px; max-width: 60px; display: block; border: 3px solid #fff; border-radius: 50%; object-fit: cover; box-shadow: 0 2px 10px rgba(10,10,10,.15); }
.contact-card strong { color: var(--text); font-size: .95rem; }
.contact-card small { color: var(--text-muted); font-size: .8rem; }
.contact-card .btn-primary { flex-shrink: 0; white-space: nowrap; }

/* ---------- 19.6 CTA / Footer ---------- */
.cta-banner-user { padding: 70px 6%; }
.cta-box-wrapper { position: relative; max-width: 1300px; margin: 0 auto; overflow: hidden; padding: 60px 40px; border-radius: 28px; background: linear-gradient(135deg, var(--black), var(--ink-700)); color: #fff; text-align: center; box-shadow: var(--shadow-lg); }
.cta-box-wrapper::before { content: ''; position: absolute; top: -40%; right: -10%; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle, rgba(201,162,39,.35) 0%, transparent 70%); pointer-events: none; }
.cta-box-wrapper h2 { position: relative; margin-bottom: 16px; color: #fff; font-size: 2.5rem; font-weight: 800; }
.cta-box-wrapper p { position: relative; max-width: 600px; margin: 0 auto 32px; color: rgba(255,255,255,.85); font-size: 1.1rem; }
.cta-box-wrapper .btn-cta-white { position: relative; background: var(--primary); color: var(--on-primary); }
.cta-box-wrapper .btn-cta-white:hover { background: var(--primary-light); }

.user-footer { padding: 70px 6% 30px; border-top: 3px solid var(--primary); background: var(--black); color: rgba(255,255,255,.75); }
.footer-main-grid { max-width: 1300px; margin: 0 auto 50px; display: grid; grid-template-columns: 2fr 1fr 1fr 1.2fr; gap: 50px; }
.footer-brand p { max-width: 320px; margin-top: 16px; color: rgba(255,255,255,.65); font-size: .95rem; }
.user-footer .brand-logo, .user-footer .brand-logo-text { color: #fff; }
.footer-col h4 { margin-bottom: 20px; color: var(--primary); font-size: 1.1rem; font-weight: 700; }
.footer-col ul { list-style: none; }
.footer-col ul li { margin-bottom: 12px; }
.footer-col ul a { color: rgba(255,255,255,.7); font-size: .9rem; transition: color .3s; }
.footer-col ul a:hover { color: var(--primary); }
.footer-col a[data-bs-toggle="modal"] { cursor: pointer; transition: all .2s ease; }
.footer-col a[data-bs-toggle="modal"]:hover { color: var(--primary); padding-left: 5px; }
.footer-bottom-bar { max-width: 1300px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding-top: 30px; border-top: 1px solid rgba(255,255,255,.12); color: rgba(255,255,255,.6); font-size: .85rem; }

/* Redes sociais */
.footer-socials { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
.footer-socials .social-link, .footer-socials a { position: relative; width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid rgba(255,255,255,.15); border-radius: 12px; background: rgba(255,255,255,.08); color: rgba(255,255,255,.85); font-size: 1.05rem; transition: all .25s cubic-bezier(.4, 0, .2, 1); }
.footer-socials .social-link::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,.15), transparent); opacity: 0; transition: opacity .25s ease; }
.footer-socials .social-link:hover::before { opacity: 1; }
.footer-socials .social-link:hover, .footer-socials a:hover { transform: translateY(-4px) scale(1.05); border-color: transparent; background: var(--primary); color: var(--on-primary); box-shadow: 0 8px 20px -6px rgba(0,0,0,.5); }
.footer-socials .social-link:focus { outline: none; box-shadow: 0 0 0 3px rgba(201,162,39,.55); }
.footer-socials .social-linkedin:hover { background: linear-gradient(135deg, #0077b5, #00a0dc); color: #fff; }
.footer-socials .social-facebook:hover { background: linear-gradient(135deg, #1877f2, #4267b2); color: #fff; }
.footer-socials .social-instagram:hover { background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); color: #fff; }
.footer-socials .social-twitter:hover { background: linear-gradient(135deg, #1da1f2, #0d8ecf); color: #fff; }
.footer-socials .social-youtube:hover { background: linear-gradient(135deg, #ff0000, #cc0000); color: #fff; }

/* Modais do site pÃºblico */
.modal-content { animation: modalFadeIn .3s ease; }
.modal-header { padding: 1.25rem 1.5rem; }
.modal-body { padding: 1.5rem; }
.modal-footer { padding: 1rem 1.5rem; }
.modal .accordion-button:not(.collapsed) { background: var(--primary-soft); color: var(--primary-dark); box-shadow: none; }
.modal .accordion-button:focus { border-color: transparent; box-shadow: none; }
.modal-filtros-wrap { position: sticky; top: 0; z-index: 10; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-color); background: var(--surface-alt); }
.modal-filtros-wrap .input-group-text { border: 1px solid var(--border-color); border-radius: 10px 0 0 10px; color: var(--text-muted); }
.modal-filtros-wrap .form-control { padding: .65rem .85rem; border: 1px solid var(--border-color); border-right: none; border-left: none; }
.modal-filtros-wrap .form-control:focus { border-color: var(--primary); box-shadow: none; }
.modal-filtros-wrap .btn-outline-secondary { border: 1px solid var(--border-color); border-left: none; border-radius: 0 10px 10px 0; color: var(--text-muted); }
.modal-filtros-wrap .btn-outline-secondary:hover { border-color: #fecaca; background: #fef2f2; color: #dc2626; }
.modal-filtros-wrap .form-select-sm { padding: .5rem .75rem; border: 1px solid var(--border-color); border-radius: 10px; color: var(--ink-700); font-size: .85rem; }
.modal-filtros-wrap .form-select-sm:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(201,162,39,.2); }
#modalEgressosPublicos .modal-body { max-height: 65vh; overflow-y: auto; }
.egresso-modal-item { padding: .9rem 1.25rem; border-bottom: 1px solid var(--ink-50); transition: background .15s ease; }
.egresso-modal-item:hover { background: var(--surface-alt); }
.egresso-modal-item:last-child { border-bottom: none; }
.egresso-modal-avatar, .egresso-modal-avatar-fallback { width: 48px; height: 48px; flex-shrink: 0; border: 2px solid #fff; border-radius: 50%; box-shadow: 0 3px 10px -2px rgba(0,0,0,.1); }
.egresso-modal-avatar { object-fit: cover; }
.egresso-modal-avatar-fallback { display: flex; align-items: center; justify-content: center; background: var(--black); color: var(--primary); font-size: .95rem; font-weight: 700; }

/* AnimaÃ§Ãµes no scroll */
.animate-on-scroll { opacity: 0; transform: translateY(30px); transition: all .7s cubic-bezier(.16, 1, .3, 1); }
.animate-on-scroll.visible { opacity: 1; transform: translateY(0); }
.animate-on-scroll.delay-1 { transition-delay: .08s; }
.animate-on-scroll.delay-2 { transition-delay: .16s; }
.animate-on-scroll.delay-3 { transition-delay: .24s; }

/* ---------- 19.7 Responsivo do site pÃºblico ---------- */
@media (max-width: 1024px) {
    .hero-wrapper { grid-template-columns: 1fr; text-align: center; }
    .hero-text p { margin: 0 auto 36px; }
    .hero-search-box { margin: 0 auto; }
    .hero-visual { margin-top: 40px; }
    .stats-grid-user { grid-template-columns: repeat(2, 1fr); }
    .footer-main-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 992px) {
    .home-split-container { grid-template-columns: 1fr; }
    .alumni-grid-3 { grid-template-columns: repeat(2, 1fr); }
    .nav-links { display: none !important; }
    .nav-links.active { position: absolute; top: 100%; left: 0; right: 0; z-index: 100; display: flex !important; flex-direction: column; gap: 16px !important; padding: 24px; border-radius: 0 0 16px 16px; background: #fff; box-shadow: 0 12px 32px rgba(10,10,10,.1); }
    .mobile-toggle { display: flex !important; }
    .nav-container { gap: 1rem; }
}
@media (max-width: 768px) {
    .nav-actions { gap: .4rem; }
    .user-navbar { padding: 12px 4%; }
    .user-navbar.scrolled { padding: 10px 4%; }
    .nav-container { gap: .75rem; }
    .brand-logo { font-size: 1.1rem; }
    .brand-logo .logo-icon { width: 36px; height: 36px; font-size: 1rem; }
    .btn-nav-outline, .btn-nav-solid { padding: .5rem .9rem; font-size: .82rem; border-radius: 8px; }
    .mobile-toggle { width: 38px; height: 38px; font-size: 1.1rem; }
    .hero-text h1 { font-size: 2.4rem; }
    .stats-grid-user { grid-template-columns: 1fr; }
    .jobs-grid { grid-template-columns: 1fr; }
    .job-card { flex-direction: column; }
    .footer-main-grid { grid-template-columns: 1fr; }
    .footer-bottom-bar { flex-direction: column; gap: 12px; text-align: center; }
    .counter-number { font-size: 1.75rem; }
    .floating-glass-card { padding: .65rem .9rem; }
    .floating-glass-card h5 { font-size: .875rem !important; }
    .floating-glass-card p { font-size: .68rem !important; }
    .alumni-grid-3 { grid-template-columns: 1fr; }
    .hero-float, .hero-float-soft, .hero-float-rotate { animation-duration: 3s; }
}
@media (max-width: 480px) {
    .user-navbar { padding: 8px 10px !important; }
    .nav-container { gap: 6px !important; padding: 0 !important; }
    .brand-logo { gap: 4px !important; font-size: .95rem !important; }
    .brand-logo .logo-icon { width: 28px !important; height: 28px !important; font-size: .85rem !important; border-radius: 8px !important; }
    .nav-actions { gap: 4px !important; margin-left: auto !important; }
    .btn-nav-outline, .btn-nav-solid { min-width: 34px !important; justify-content: center !important; gap: 0 !important; padding: 7px 9px !important; border-radius: 8px !important; font-size: .75rem !important; }
    .btn-nav-outline .btn-text, .btn-nav-solid .btn-text { display: none !important; }
    .btn-nav-outline i, .btn-nav-solid i { margin: 0 !important; font-size: 1rem !important; line-height: 1 !important; }
    .mobile-toggle { width: 34px !important; height: 34px !important; font-size: 1rem !important; border-radius: 8px !important; }
    .contact-card { flex-wrap: wrap; }
    .event-card { flex-direction: column; align-items: flex-start; text-align: left; }
    .event-date-badge { flex-direction: row; gap: 6px; min-width: auto; padding: .4rem .75rem; }
    .cta-box-wrapper { padding: 40px 24px; }
    .cta-box-wrapper h2 { font-size: 1.8rem; }
}
@media (max-width: 576px) {
    .btn-explorar { gap: .75rem; padding: .85rem 1rem; }
    .btn-explorar-icon { width: 44px; height: 44px; font-size: 1.15rem; }
    .btn-explorar-title { font-size: .95rem; }
    .btn-explorar-subtitle { font-size: .72rem; }
    .btn-explorar-arrow { width: 32px; height: 32px; }
}


/* ================================================================
   20. RESPONSIVIDADE GERAL DOS COMPONENTES DO PAINEL
   ================================================================ */
@media (max-width: 992px) {
    .custom-table { font-size: .85rem; }
    .avatar-circle { width: 36px !important; height: 36px !important; font-size: .85rem !important; }
    .sender-avatar { width: 70px !important; height: 70px !important; font-size: 1.5rem !important; }
    .chart-container { height: 280px; }
    .stat-card-value { font-size: 2.2rem; }
}
@media (max-width: 768px) {
    .stat-card { padding: 1rem 1.15rem; gap: .85rem; border-radius: 16px; }
    .stat-icon-wrap, .stat-card-icon { width: 48px; height: 48px; font-size: 1.25rem; border-radius: 12px; }
    .stat-value { font-size: 1.5rem; }
    .stat-card-value { font-size: 1.6rem; }
    .stat-card-label { font-size: .68rem; }
    .stat-card .stat-value, .stats-card .stats-number { font-size: 1.6rem; }
    .stats-card .stats-icon { width: 44px; height: 44px; font-size: 18px; }
    .stats-card .card-body { padding: 1.25rem; }
    .custom-table thead { display: none; }
    .custom-table tbody tr { display: block; margin-bottom: 12px; padding: 12px; border: 1px solid var(--border-color); border-radius: 12px; }
    .custom-table tbody tr:hover { transform: none; }
    .custom-table tbody td { display: block; padding: 6px 8px !important; border: none; text-align: left !important; }
    .custom-table tbody td::before { content: attr(data-label); display: block; margin-bottom: 2px; color: var(--text-muted); font-size: .7rem; font-weight: 600; text-transform: uppercase; }
    .action-icon-btn { width: 32px; height: 32px; }
    .chart-container { height: 220px; }
    .chart-container-sm { height: 200px; }
    .chart-doughnut-container { height: 200px; }
    .chart-card .card-header, .chart-card-header { padding: 1rem 1.25rem; }
    .chart-card .card-body, .chart-card-body { padding: 1rem; }
    .egresso-item-pro, .item-list-pro, .evento-item-pro { padding: .875rem 1.25rem; }
    .egresso-avatar-wrapper, .egresso-avatar-img, .egresso-avatar-fallback { width: 42px; height: 42px; }
    .egresso-avatar-fallback { font-size: 1rem; }
    .item-icon-pro { width: 38px; height: 38px; min-width: 38px; font-size: 14px; }
    .evento-date-pro { width: 44px; min-width: 44px; height: 44px; }
    .evento-dia { font-size: 1rem; }
    .evento-mes { font-size: .55rem; }
    .evento-date-badge { width: 52px; height: 52px; }
    .evento-date-day { font-size: 1.2rem; }
    .evento-title, .oportunidade-title { font-size: .95rem; }
    .oportunidade-type-badge { width: 52px; height: 52px; font-size: 1.3rem; }
    .oportunidade-badges { max-width: 55%; }
    .inscricao-actions { min-width: 100%; flex-direction: row; flex-wrap: wrap; }
    .inscricao-actions .btn, .inscricao-actions form { flex: 1; }
    .inscricao-actions .btn { justify-content: center; }
    .survey-header { padding: 1rem 1.25rem .5rem; }
    .survey-icon { width: 42px; height: 42px; font-size: 1.05rem; }
    .survey-title { font-size: .95rem; }
    .quick-action-btn { padding: .85rem 1rem; }
    .quick-action-icon { width: 42px; height: 42px; font-size: 1.1rem; }
    .quick-action-text strong { font-size: .875rem; }
    .quick-action-text small { font-size: .72rem; }
    .map-preview { height: 260px; }
    .map-placeholder-icon { width: 60px; height: 60px; font-size: 1.6rem; }
    #map { height: 350px; }
    .stat-mapa .numero { font-size: 1.5rem; }
    .legenda-mapa { gap: .5rem; padding: .5rem 1rem; }
    .legenda-item { font-size: .75rem; }
    .location-marker { width: 36px; height: 36px; font-size: .9rem; }
    .location-info-icon { width: 32px; height: 32px; font-size: .75rem; }
    .notification-item { padding: 1rem; }
    .notification-icon { width: 42px; height: 42px; font-size: 1rem; border-radius: 12px; }
    .notification-title { font-size: .95rem; }
    .notification-message { font-size: .85rem; }
    .conversation-preview { max-width: 200px; }
    .community-card { padding: 1rem; }
    .community-icon { width: 44px; height: 44px; font-size: 1rem; }
    .quick-action { padding: 1rem .5rem; }
    .quick-icon { width: 44px; height: 44px; font-size: 1.15rem; }
    .quick-action span { font-size: .75rem; }
    .activity-timeline { padding-left: 22px; }
    .activity-item::before { left: -20px; width: 10px; height: 10px; }
    .service-card .service-icon { width: 44px; height: 44px; font-size: 1.15rem; }
    .profissional-card:hover { transform: translateY(-3px); }
    .profissional-icon { width: 32px; height: 32px; min-width: 32px; font-size: 12px; }
    .order-number { width: 28px; height: 28px; font-size: .75rem; }
    .card-header .d-flex { flex-direction: column; align-items: flex-start !important; gap: 10px; }
    .subject-title { font-size: 1.1rem; }
    .avatar-glow { width: 52px !important; height: 52px !important; font-size: 1.2rem !important; }
    .empresa-header-body { flex-direction: column; padding: 22px 18px; text-align: center; }
    .empresa-header-meta { justify-content: center; }
    .empresa-header-nome { font-size: 1.35rem; }
    .empresa-header-logo img, .empresa-header-logo-placeholder { width: 90px; height: 90px; }
    .login-panel .row-grid, .row-grid, .row-grid-3 { grid-template-columns: 1fr; }
}
@media (max-width: 576px) {
    .detail-header { padding: 1.25rem; }
    .detail-header h3 { font-size: 1.15rem; }
    .detail-header-content { flex-direction: column; align-items: flex-start; }
    .service-big-icon { width: 52px; height: 52px; font-size: 1.35rem; border-radius: 14px; }
    .egresso-card { padding: 1rem; }
    .egresso-card .egresso-avatar, .egresso-avatar-fallback { width: 54px; height: 54px; font-size: 1.15rem; }
    .actions-bar { flex-direction: column-reverse; align-items: stretch; }
    .actions-left, .actions-right { width: 100%; margin: 0; }
    .actions-left .btn, .actions-left .badge-attended, .actions-right .btn, .actions-right form { width: 100%; }
    .actions-left .btn, .actions-right .btn { justify-content: center; }
    .status-pill { padding: .4rem .9rem; font-size: .78rem; }
    .custom-modal { padding: 12px; }
    .custom-modal-dialog { max-width: 100%; border-radius: 14px; }
    .custom-modal-header, .custom-modal-body { padding: 17px; }
    .custom-modal-footer { padding: 12px 17px 17px; }
    .chat-bubble { max-width: 80%; }
    .chat-body { height: 420px; padding: .85rem; }
    .call-btn { width: 36px; height: 36px; }
    .call-btn i { font-size: .85rem; }
    .chat-audio, .chat-ficheiro { min-width: 160px; }
    .chat-ficheiro-nome { max-width: 120px; }
    .call-incoming-header { height: 115px; }
    .call-avatar, .call-ripple { width: 70px; height: 70px; }
    .call-avatar { font-size: 1.7rem; }
    .call-action-btn { width: 58px; height: 58px; font-size: 1.2rem; }
    .hover-card .rounded-circle { width: 50px; height: 50px; }
    .hover-card .fa-2x { font-size: 1.4rem !important; }
    .hover-card h6 { font-size: .8rem; }
    .stats-card .stats-number, .stat-card .stat-value { font-size: 1.4rem; }
    .chart-container { height: 180px; }
    .chart-container-sm { height: 160px; }
    .chart-doughnut-container { height: 180px; }
    .news-image-wrapper { height: 170px; }
    .news-title { font-size: .95rem; }
    .news-preview { font-size: .8rem; }
    .news-badges .badge { padding: .3rem .5rem; font-size: .65rem; }
    .inscricao-card { flex-direction: column; align-items: flex-start; gap: 1rem; padding: 1.1rem 1.1rem 1.1rem 1.35rem; }
    .inscricao-date { width: 64px; height: 70px; }
    .inscricao-date .day { font-size: 1.5rem; }
    .inscricao-date .month { font-size: .62rem; }
    .inscricao-date .year { font-size: .55rem; }
    .inscricao-title { font-size: .95rem; }
    .hero-avatar-wrapper, .hero-avatar, .hero-avatar-fallback { width: 110px; height: 110px; }
    .hero-avatar-fallback { font-size: 2.4rem; }
    .hero-verified { width: 30px; height: 30px; font-size: .75rem; }
    .hero-name { font-size: 1.25rem; }
    .hero-info-icon { width: 34px; height: 34px; font-size: .8rem; }
    .hero-info-value { font-size: .8rem; }
    .hero-actions .btn { flex: 1; justify-content: center; }
    .feedback-intro-icon, .feedback-detail-icon, .survey-intro-icon, .location-intro-icon, .hero-search-icon { width: 44px; height: 44px; font-size: 1.1rem; }
    .feedback-message-box { padding: 1rem 1.15rem; font-size: .9rem; }
    .rating-star { font-size: 1.25rem; }
    .rating-label { width: 100%; margin-top: .5rem; margin-left: 0 !important; font-size: .78rem; text-align: center; }
    .rating-display i { font-size: 1rem; }
    .question-number { width: 34px; height: 34px; font-size: .9rem; }
    .question-title { font-size: .925rem; }
    .answer-options-row { grid-template-columns: 1fr; }
    .answer-scale { gap: .4rem; }
    .answer-scale-box { border-radius: 10px; font-size: 1rem; }
    .service-card { padding: 1rem .5rem; }
    .service-title { font-size: .8rem; }
    .service-desc { font-size: .7rem; }
    .result-item { padding: .85rem 1rem; }
    .section-icon { width: 34px; height: 34px; font-size: .85rem; }
    .network-item { padding: .85rem 1rem; }
    .conversation-preview { max-width: 180px; }
    .profissional-icon { width: 28px; height: 28px; min-width: 28px; font-size: 11px; }
    .profissional-card .card-body, .card-body { padding: 16px !important; }
    .card-header { padding: 16px 16px 0 !important; }
    .card-footer { padding: 0 16px 16px !important; }
    .container-fluid { padding-left: 12px !important; padding-right: 12px !important; }
    .d-flex.gap-3 { gap: 10px !important; }
    .d-flex.flex-wrap.gap-2 .btn { width: 100%; justify-content: center; }
    .d-flex.flex-wrap.justify-content-between { flex-direction: column; align-items: flex-start !important; gap: 12px; }
    .info-card { padding: 12px !important; }
    .info-card i { font-size: 14px; }
    .global-footer .footer-content { justify-content: center; text-align: center; }
    .btn { font-size: 13px; }
    .badge { font-size: 10px; }
    .egresso-item-pro, .item-list-pro, .evento-item-pro { padding: .75rem 1rem; }
    .egresso-nome, .item-title-pro { font-size: .85rem; }
    .egresso-curso, .item-sub-pro { font-size: .72rem; }
    .item-date-pro, .egresso-tempo { font-size: .65rem; }
}
@media (max-width: 480px) {
    .stat-card-value { font-size: 1.75rem; }
    .stat-card-icon { width: 48px; height: 48px; font-size: 1.25rem; }
}


/* ================================================================
   21. ANIMAÃ‡Ã•ES â€” AJUSTES FINAIS PARA MOBILE (login / registo)
   ================================================================ */
@media (max-width: 768px) {
    .login-container, .register-container { transform: translateY(20px); animation-duration: .4s; }
    .login-card, .register-card { animation-duration: .5s; }
    .form-group { animation-duration: .3s; }
    .btn-login, .btn-register { animation: none; }
    .logo { animation-duration: .5s; }
}
@keyframes float-mobile { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
@media (max-width: 768px) {
    .hero-float { animation-name: float-mobile; }
}

/* ================================================================
   22. LOGIN / REGISTO â€” RESPONSIVO (duas colunas â†’ uma)
   ================================================================ */
@media (max-width: 1300px) {
    .register-form { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 1000px) {
    .register-panel { grid-template-columns: 220px 1fr; max-width: 940px; }
    .register-panel .form-side { padding: 18px 22px; }
    .register-form { grid-template-columns: repeat(2, 1fr); }
    .field-group.full-width, .field-group.span-2, .field-group.span-3 { grid-column: 1 / -1; }
    .register-panel .welcome-side { padding: 20px 18px; }
    .register-panel .university-logo { width: 100px; height: 100px; }
    .register-panel .welcome-content h2 { font-size: 22px; }
}
@media (max-width: 820px) {
    .register-shell { align-items: flex-start; min-height: 0; padding: 14px; overflow: visible; }
    .register-shell::after { display: none; }
    .register-panel { grid-template-columns: 1fr; max-width: 560px; height: auto; min-height: 0; border-radius: 16px; }
    .register-panel .welcome-side { flex-direction: row; align-items: center; justify-content: flex-start; gap: 12px; height: auto; min-height: 0; padding: 14px 18px; border-radius: 16px 16px 0 0; }
    .register-panel .welcome-side::before, .register-panel .welcome-side::after { display: none; }
    .register-panel .brand { flex-shrink: 0; margin: 0; }
    .register-panel .university-logo { width: 56px; height: 56px; margin: 0; }
    .register-panel .welcome-content { flex: 1; max-width: none; margin: 0; }
    .register-panel .eyebrow { margin-bottom: 2px; font-size: 8px; }
    .register-panel .welcome-content h2 { margin: 0; font-size: 16px; line-height: 1.1; }
    .register-panel .welcome-content p, .register-panel .quote { display: none; }
    .register-panel .form-side { justify-content: flex-start; padding: 18px 16px; border-radius: 0 0 16px 16px; }
    .register-form { grid-template-columns: 1fr 1fr; gap: 8px 12px; }
    .register-panel .form-intro h1 { font-size: 20px; }
    .submit-button { width: 100%; max-width: 260px; height: 42px; }
}
@media (max-width: 680px) {
    .login-shell { align-items: center; padding: 16px; }
    .login-panel { grid-template-columns: 1fr; width: min(430px, 100%); min-height: auto; border-radius: 19px; }
    .login-panel .welcome-side { min-height: 210px; padding: 24px; }
    .login-panel .welcome-content h2 { max-width: 260px; font-size: 34px; }
    .login-panel .welcome-content p, .login-panel .quote { display: none; }
    .login-panel .form-side { padding: 31px 24px 28px; }
    .login-panel .form-intro h1 { font-size: 29px; }
    .modal-content { margin: 20px; padding: 30px 24px; }
}
@media (max-width: 520px) {
    .register-shell { padding: 10px; }
    .register-panel { max-width: 100%; border-radius: 14px; }
    .register-panel .welcome-side { gap: 10px; padding: 12px 14px; }
    .register-panel .university-logo { width: 48px; height: 48px; }
    .register-panel .welcome-content h2 { font-size: 15px; }
    .register-panel .form-side { justify-content: flex-start; padding: 16px 12px; }
    .register-form { grid-template-columns: 1fr; gap: 8px; }
    .register-panel .form-intro h1 { font-size: 18px; }
    .register-panel .form-intro p { font-size: 11px; }
    .register-form .field { height: 40px; }
    .submit-button { width: 100%; height: 44px; font-size: 14px; }
    .register-panel .login-link { font-size: 12px; }
    .reset-card { padding: 28px 22px; }
}
@media (max-width: 360px) {
    .register-shell { padding: 8px; }
    .register-panel .form-side { padding: 14px 10px; }
    .register-form .field-group label { font-size: 10px; }
    .register-form .field input, .register-form .field select { font-size: 11.5px; }
    .section-divider { font-size: 9px; }
    .register-panel .welcome-content h2 { font-size: 14px; }
    .register-panel .university-logo { width: 42px; height: 42px; }
}
@media (max-height: 500px) and (orientation: landscape) {
    .register-shell { align-items: flex-start; min-height: 0; overflow: visible; }
    .register-panel .welcome-side { gap: 8px; padding: 10px 14px; }
    .register-panel .university-logo { width: 40px; height: 40px; }
    .register-panel .welcome-content h2 { font-size: 14px; }
    .register-panel .form-side { padding: 12px 14px; }
    .register-panel .form-intro { margin-bottom: 6px; }
    .register-panel .form-intro h1 { font-size: 16px; }
    .register-panel .form-intro p { display: none; }
    .register-form { grid-template-columns: repeat(2, 1fr); gap: 5px 10px; }
    .register-form .field { height: 32px; }
    .field-group .text-muted { display: none; }
    .submit-button { height: 36px; }
}
@media (hover: none) and (pointer: coarse) {
    .register-form .field { height: 44px; }
    .submit-button { height: 48px; font-size: 15px; }
    .toggle-password { padding: 8px; }
    .register-panel .login-link a { display: inline-block; padding: 6px 4px; }
}
@media (max-height: 780px) and (min-width: 821px) {
    .register-panel .form-side { padding: 14px 26px; }
    .register-panel .form-intro { margin-bottom: 8px; }
    .register-panel .form-intro h1 { font-size: 20px; }
    .register-panel .form-intro p { display: none; }
    .register-form { gap: 7px 12px; }
    .register-form .field { height: 33px; }
    .register-form .field-group label { font-size: 10px; }
    .section-divider { margin-top: 0; font-size: 9px; }
    .submit-button { width: 220px; height: 38px; margin-top: 4px; }
    .register-panel .login-link { margin: 8px 0 0; font-size: 11px; }
    .register-panel .welcome-side { padding: 20px 18px; }
    .register-panel .university-logo { width: 100px; height: 100px; }
    .register-panel .welcome-content h2 { font-size: 23px; }
}
@media (max-height: 680px) and (min-width: 821px) {
    .register-panel .form-side { padding: 10px 22px; }
    .register-panel .form-intro h1 { font-size: 18px; }
    .register-form .field { height: 31px; }
    .register-form .field input, .register-form .field select { font-size: 11.5px; }
    .field-group .text-muted { display: none; }
    .register-form { gap: 5px 10px; }
    .section-divider { padding-bottom: 1px; font-size: 8.5px; }
    .submit-button { width: 200px; height: 36px; }
    .register-panel .login-link { font-size: 10.5px; }
    .register-panel .university-logo { width: 84px; height: 84px; }
}
@media (max-height: 680px) {
    .register-shell { align-items: flex-start; overflow-y: auto; min-height: 100vh; min-height: 100dvh; }
}




/* ============================================================
   REGISTO â€” MELHORIAS VISUAIS
============================================================ */

/* ---------- AnimaÃ§Ã£o de entrada do painel ---------- */
@keyframes regPanelIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.register-shell .register-panel {
    animation: regPanelIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* ---------- Inputs com Ã­cone e foco melhorado ---------- */
.register-form .field {
    transition: all 0.2s ease;
    border: 1.5px solid #e6e2d3;
}

.register-form .field:focus-within {
    border-color: #c9a227;
    box-shadow: 0 0 0 4px rgba(201, 162, 39, 0.15);
    background: #ffffff;
}

/* ---------- Labels mais legÃ­veis ---------- */
.register-form .field-group label {
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #1a1a1a;
}

/* ---------- Section dividers com linha dourada ---------- */
.register-form .section-divider {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: #a67c00;
    padding-bottom: 6px;
    border-bottom: 2px solid #c9a227;
    margin-bottom: 12px;
    margin-top: 8px;
}

/* ---------- BotÃ£o submit com gradiente dourado ---------- */
.register-form .submit-button {
    background: linear-gradient(135deg, #a67c00 0%, #c9a227 55%, #e0b93d 100%);
    color: #0a0a0a !important;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.3px;
    box-shadow: 0 8px 24px rgba(201, 162, 39, 0.4);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    position: relative;
    overflow: hidden;
}

.register-form .submit-button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(201, 162, 39, 0.55);
    filter: brightness(1.05);
}

.register-form .submit-button:active:not(:disabled) {
    transform: translateY(0);
}

.register-form .submit-button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
}

/* ---------- Barra de forÃ§a da senha ---------- */
.password-strength {
    display: flex;
    gap: 4px;
    margin-top: 6px;
}

.password-strength-bar {
    flex: 1;
    height: 4px;
    background: #e6e2d3;
    border-radius: 2px;
    transition: background 0.3s ease;
}

.password-strength-bar.weak    { background: #dc2626; }
.password-strength-bar.medium  { background: #d97706; }
.password-strength-bar.strong  { background: #16a34a; }

.password-strength-label {
    display: block;
    margin-top: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.password-strength-label.weak   { color: #dc2626; }
.password-strength-label.medium { color: #d97706; }
.password-strength-label.strong { color: #16a34a; }

/* ---------- Mensagens (error / success / pending) ---------- */
.register-form ~ .error-message,
.register-form ~ .success-message,
.register-form ~ .pending-message,
.form-side .error-message,
.form-side .success-message,
.form-side .pending-message {
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 0.85rem;
    line-height: 1.5;
    border-left: 4px solid;
    animation: regMessageIn 0.4s ease forwards;
}

@keyframes regMessageIn {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
}

.form-side .error-message {
    background: #fff1f1;
    border-left-color: #dc2626;
    color: #991b1b;
}

.form-side .success-message {
    background: #edf9f0;
    border-left-color: #16a34a;
    color: #166534;
}

.form-side .pending-message {
    background: #fffbeb;
    border-left-color: #d97706;
    color: #92400e;
}

/* ---------- BotÃ£o toggle da senha (Ã­cone olho) ---------- */
.register-form .toggle-password {
    color: #8a8a8a;
    transition: color 0.2s ease;
}

.register-form .toggle-password:hover {
    color: #c9a227;
}

/* ---------- Responsivo â€” fundo fixo em mobile ---------- */
@media (max-width: 820px) {
    .register-shell {
        background-attachment: scroll;
    }

    .register-shell .register-panel {
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        background: #ffffff !important;
    }
}

/* ============================================================
   REGISTO â€” FUNDO COM IMAGEM DA UNIVERSIDADE
============================================================ */
.register-shell {
    background-image: url('./images/ipgeste_fora.webp');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-repeat: no-repeat;
    position: relative;
}

.register-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        135deg,
        rgba(10, 10, 10, 0.65) 0%,
        rgba(10, 10, 10, 0.35) 100%
    );
    z-index: 0;
    pointer-events: none;
}

.register-shell .register-panel {
    position: relative;
    z-index: 1;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(255, 255, 255, 0.94) !important;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
}

.register-shell .welcome-side {
    background: rgba(10, 10, 10, 0.85);
}

@media (max-width: 820px) {
    .register-shell {
        background-attachment: scroll;
    }
    .register-shell .register-panel {
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        background: #ffffff !important;
    }
}


/* ============================================================
   LOGIN â€” FUNDO COM IMAGEM DA UNIVERSIDADE
============================================================ */
.login-shell {
   background-image: url('./images/ipgest_entrada.webp');   
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-repeat: no-repeat;
    position: relative;
}

.login-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        135deg,
        rgba(10, 10, 10, 0.65) 0%,
        rgba(10, 10, 10, 0.35) 100%
    );
    z-index: 0;
    pointer-events: none;
}

.login-shell .login-panel {
    position: relative;
    z-index: 1;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(255, 255, 255, 0.94) !important;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
}

.login-shell .welcome-side {
    background: rgba(10, 10, 10, 0.85);
}

@media (max-width: 680px) {
    /* ============================================================
   LOGIN — FUNDO COM IMAGEM DA UNIVERSIDADE
    ============================================================ */
.login-shell {
    background: url('./images/ipgest_entrada.webp') center center / cover no-repeat fixed !important;
    position: relative;
}
    .login-shell .login-panel {
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        background: #ffffff !important;
    }
}
/* ============================================================
   VERIFICAÇÃO DE DOCUMENTO — alinhamento vertical
============================================================ */
body[data-panel="public"]:has(.verify-card),
body[data-panel="public"]:has(.result-card) {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background: var(--bg);
}

body[data-panel="public"]:has(.verify-card) .container,
body[data-panel="public"]:has(.result-card) .container {
    padding: 0;
    max-width: 100%;
}

/* ============================================================
   ERROR PAGES
   ============================================================ */

.error-page {
    width: 100%;
    max-width: 560px;
    position: relative;
    z-index: 1;
    margin: 0 auto;
    padding: 20px;
}

.error-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(201, 162, 39, 0.15);
    border-radius: 24px;
    padding: 60px 40px;
    text-align: center;
    backdrop-filter: blur(20px);
    box-shadow:
        0 25px 60px rgba(0, 0, 0, 0.5),
        0 0 80px rgba(201, 162, 39, 0.05) inset;
    position: relative;
    overflow: hidden;
}

.error-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 3px;
    background: linear-gradient(90deg, transparent, #c9a227, transparent);
    border-radius: 50%;
}

.error-logo {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c9a227 0%, #e0b93d 100%);
    color: #0a0a0a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    margin-bottom: 28px;
    box-shadow:
        0 12px 30px rgba(201, 162, 39, 0.35),
        0 0 0 8px rgba(201, 162, 39, 0.08);
    animation: pulse 2.5s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

.error-code {
    font-size: 5.5rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -3px;
    background: linear-gradient(135deg, #c9a227 0%, #e0b93d 50%, #c9a227 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
    filter: drop-shadow(0 4px 20px rgba(201, 162, 39, 0.3));
}

.error-title {
    font-size: 1.65rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 14px;
    letter-spacing: -0.5px;
}

.error-message {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 440px;
    margin-left: auto;
    margin-right: auto;
}

.error-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
}

.btn-error {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 28px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: all 0.25s ease;
    font-family: inherit;
}

.btn-error-primary {
    background: linear-gradient(135deg, #a67c00 0%, #c9a227 55%, #e0b93d 100%);
    color: #0a0a0a;
    box-shadow: 0 6px 24px rgba(201, 162, 39, 0.35);
}

.btn-error-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 32px rgba(201, 162, 39, 0.45);
}

.btn-error-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
}

.btn-error-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    transform: translateY(-2px);
}

.error-detail {
    margin-top: 28px;
    padding: 16px 20px;
    background: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.2);
    border-radius: 12px;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.75);
    text-align: left;
    font-family: 'Courier New', monospace;
    word-break: break-word;
    max-height: 200px;
    overflow-y: auto;
}

.error-detail strong {
    color: #f87171;
    display: block;
    margin-bottom: 6px;
    font-family: 'Inter', sans-serif;
}

.error-footer {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.3px;
}

.error-footer strong {
    color: #c9a227;
    font-weight: 700;
}

/* Fundo decorativo (aplicar ao body quando tiver a classe error-body) */
body.error-body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
    color: #ffffff;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-x: hidden;
    margin: 0;
}

body.error-body::before {
    content: '';
    position: fixed;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background:
        radial-gradient(circle at 20% 30%, rgba(201, 162, 39, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 80% 70%, rgba(201, 162, 39, 0.06) 0%, transparent 40%);
    z-index: 0;
    pointer-events: none;
}

/* Responsivo */
@media (max-width: 576px) {
    .error-card { padding: 44px 24px; border-radius: 20px; }
    .error-code { font-size: 4rem; }
    .error-logo { width: 74px; height: 74px; font-size: 1.8rem; }
    .error-title { font-size: 1.35rem; }
    .error-message { font-size: 0.92rem; }
    .btn-error { padding: 11px 22px; font-size: 0.9rem; width: 100%; }
    .error-actions { flex-direction: column; }
}

