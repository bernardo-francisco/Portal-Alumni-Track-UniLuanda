FROM php:8.2-fpm

# Instalar dependências do sistema (SEM nodejs e npm, mas COM libzip)
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    zip \
    unzip

# Limpar cache
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

# Instalar extensões PHP (Adicionado zip no final)
RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Definir diretório de trabalho
WORKDIR /var/www

# Copiar ficheiros do projeto
COPY . .

# Instalar dependências do PHP (sem dev)
RUN composer install --no-dev --optimize-autoloader

# Ajustar permissões
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache

# Expor a porta que o Railway usa
EXPOSE 8080

# Comando de arranque do Laravel (usando a variável PORT do Railway)
CMD php artisan serve --host=0.0.0.0 --port=${PORT:-8080}