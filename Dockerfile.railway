FROM php:8.2-fpm

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    zip \
    unzip

# Limpar cache
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

# Instalar extensões PHP (incluindo zip)
RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Definir diretório de trabalho
WORKDIR /var/www

# Copiar ficheiros do projeto
COPY . .

# Criar as pastas necessárias do Laravel (storage e cache) ANTES de dar permissões
RUN mkdir -p /var/www/storage/framework/sessions \
    /var/www/storage/framework/views \
    /var/www/storage/framework/cache/data \
    /var/www/storage/logs \
    /var/www/bootstrap/cache

# Instalar dependências do PHP (sem dev)
RUN composer install --no-dev --optimize-autoloader

# Ajustar permissões para o servidor web (www-data)
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache \
    && chmod -R 775 /var/www/storage /var/www/bootstrap/cache

# Expor a porta que o Railway usa
EXPOSE 8080

# Comando de arranque: garante as permissões e inicia o Laravel
CMD chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache && php artisan serve --host=0.0.0.0 --port=${PORT:-8080}